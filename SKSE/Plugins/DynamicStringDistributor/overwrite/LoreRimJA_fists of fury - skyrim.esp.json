[{"form_id":"0x1D791E|fists of fury - skyrim.esp","type":"MGEF FULL","string":"監視者追跡効果"},{"form_id":"0x1D7978|fists of fury - skyrim.esp","type":"MGEF FULL","string":"完了追跡効果01"},{"form_id":"0x153E9C|fists of fury - skyrim.esp","type":"MGEF FULL","string":"ダミー効果"},{"form_id":"0x1C34F3|fists of fury - skyrim.esp","type":"MGEF FULL","string":"キャプテン・グリム召喚"},{"form_id":"0x1C34F3|fists of fury - skyrim.esp","type":"MGEF DNAM","string":"<dur>秒間、キャプテン・グリムを召喚する。"},{"form_id":"0x2001D4|fists of fury - skyrim.esp","type":"MGEF FULL","string":"CC レッドガードの精鋭武具効果"},{"form_id":"0x241EEA|fists of fury - skyrim.esp","type":"MGEF FULL","string":"CC レッドガードの精鋭武具効果 02"},{"form_id":"0x0C110F|fists of fury - skyrim.esp","type":"MGEF FULL","string":"追跡効果"},{"form_id":"0x24C0EC|fists of fury - skyrim.esp","type":"MGEF FULL","string":"呪文効果の更新"},{"form_id":"0x1C85F6|fists of fury - skyrim.esp","type":"MGEF FULL","string":"追跡効果の更新 01"},{"form_id":"0x1C34F4|fists of fury - skyrim.esp","type":"ENCH FULL","string":"グリム船長召喚"},{"form_id":"0x24C0EB|fists of fury - skyrim.esp","type":"SPEL FULL","string":"怒りの拳 - 更新魔法"},{"form_id":"0x1D791D|fists of fury - skyrim.esp","type":"SPEL FULL","string":"観察者の魔法"},{"form_id":"0x0C1110|fists of fury - skyrim.esp","type":"SPEL FULL","string":"怒りの拳 - 魔法"},{"form_id":"0x153E9A|fists of fury - skyrim.esp","type":"SPEL FULL","string":"ダミー呪文"},{"form_id":"0x1C85F7|fists of fury - skyrim.esp","type":"BOOK FULL","string":"新たな機会"},{"form_id":"0x1C85F7|fists of fury - skyrim.esp","type":"BOOK DESC","string":"<font face='$HandwrittenFont' size = \"18\">\r\nリフテンでは見事に実力を示したな。もっと戦いたいなら、モーサルのファリオンとウィンドヘルムのニラニエに話してみるといい。\r\n\r\n- 主催者"},{"form_id":"0x1C85F5|fists of fury - skyrim.esp","type":"BOOK FULL","string":"決闘への招待"},{"form_id":"0x1C85F5|fists of fury - skyrim.esp","type":"BOOK DESC","string":"<font face='$HandwrittenFont' size = \"18\">\r\nスカイリムではなかなかの戦士だと聞いている。ここにはお前のような人材がもっと必要だ。最近は軟弱者ばかりでな。戦うタイプのようだから、いいことを教えてやろう。もっと腕試しがしたいなら、スカイリムで乱闘大会が開かれている。お前がどれほどのものか、見せてもらおうじゃないか。\r\n参加したいなら、以下の者たちに話しかけるといい：\r\n\r\n- リフテンのモール\r\n- モーサルのファリオン\r\n- ウィンドヘルムのニラニエ\r\n\r\n- 主催者"},{"form_id":"0x05BCC8|fists of fury - skyrim.esp","type":"BOOK FULL","string":"決闘への招待"},{"form_id":"0x05BCC8|fists of fury - skyrim.esp","type":"BOOK DESC","string":"<font face='$HandwrittenFont' size = \"18\">\r\nスカイリムであなたがかなりの戦士だと耳にした。ここにはあなたのような者がもっと必要だ。近頃は牛乳飲みばかりでな。あなたは戦うタイプのようだから、一つ教えてやろう。もっと戦いたいなら、スカイリムで乱闘大会が開かれている。始めたければリフテンのモールに話しかけろ。彼が行き先を教えたら、俺に話しかけろ。お前がどれほどのものか見せてもらおう。\r\n\r\n- 主催者"},{"form_id":"0x2F3201|fists of fury - skyrim.esp","type":"BOOK FULL","string":"酔っ払いブライアンのメモ"},{"form_id":"0x2F3201|fists of fury - skyrim.esp","type":"BOOK DESC","string":"<font face=\"$HandwrittenBold\" size=\"18\">\r\nよくもまあ!\r\n\r\nあいつ、俺じゃあいつらのちっぽけな大会に出る資格がないと思ってやがる! なんて図々しい! 俺は生まれてこのかたずっと殴り合いをしてきたんだ。あのトカゲ野郎の一発がたまたま当たっただけじゃねえか。思い知らせてやる! あの馬鹿どもみんなに思い知らせてやる!\r\n</font>"},{"form_id":"0x1C34F2|fists of fury - skyrim.esp","type":"WEAP FULL","string":"灰の者の杖"},{"form_id":"0x019E63|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ラシアナ・アレクシア"},{"form_id":"0x019E5E|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ヴェレル・ドラン"},{"form_id":"0x019E68|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"VIPの護衛"},{"form_id":"0x019E69|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"VIPの護衛"},{"form_id":"0x019E6A|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"主催者"},{"form_id":"0x019E70|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ヤニク・スペラ"},{"form_id":"0x019E72|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ナサニエル"},{"form_id":"0x01EF78|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ラックダン"},{"form_id":"0x01EF79|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"アリア"},{"form_id":"0x01EF7A|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ダリン"},{"form_id":"0x01EF7E|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"バリン"},{"form_id":"0x01EF7F|fists of fury - skyrim.esp","type":"NPC_ FULL","string":"ドラキス"},{"form_id":"0x
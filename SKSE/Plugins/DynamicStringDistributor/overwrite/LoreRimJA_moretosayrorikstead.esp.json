[{"form_id":"0x0008D0|moretosayrorikstead.esp","type":"MISC FULL","string":"レルディスの物資"},{"form_id":"0x00089D|moretosayrorikstead.esp","type":"INFO NAM1","string":"わかったよ！ ちゃんとやるから、頼むから放っておいてくれ！","index":1},{"form_id":"0x00089D|moretosayrorikstead.esp","type":"INFO RNAM","string":"これからは子供たちをもっと大事にするつもり？"},{"form_id":"0x000801|moretosayrorikstead.esp","type":"DIAL FULL","string":"農業は好きか？"},{"form_id":"0x000802|moretosayrorikstead.esp","type":"INFO NAM1","string":"真っ当な仕事だし、自分の農場を誇りに思ってるよ。","index":1},{"form_id":"0x000802|moretosayrorikstead.esp","type":"INFO NAM1","string":"スカイリムで作物を育てるのは並大抵の苦労じゃない。","index":2},{"form_id":"0x000803|moretosayrorikstead.esp","type":"DIAL FULL","string":"秘訣は何だ？"},{"form_id":"0x000806|moretosayrorikstead.esp","type":"INFO NAM1","string":"一生懸命働くこと。それと、良い糞さ。","index":1},{"form_id":"0x000806|moretosayrorikstead.esp","type":"INFO NAM1","string":"うちの牛糞なんか、荷馬車単位で売れてるんだ。","index":2},{"form_id":"0x000807|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドに家族はいる？"},{"form_id":"0x000808|moretosayrorikstead.esp","type":"INFO NAM1","string":"レルディスとはもう話したかい？","index":1},{"form_id":"0x000809|moretosayrorikstead.esp","type":"DIAL FULL","string":"レルディスがお母さん?"},{"form_id":"0x00080A|moretosayrorikstead.esp","type":"INFO NAM1","string":"レルディスは俺の命の恩人なんだ。ずっと前に助けてくれた。母親みたいな人さ。","index":1},{"form_id":"0x00080C|moretosayrorikstead.esp","type":"DIAL FULL","string":"レルディスとは誰だ？"},{"form_id":"0x00080D|moretosayrorikstead.esp","type":"INFO NAM1","string":"レルディスはロリクステッドで一番の働き者の農夫だけど、少し小銭を稼ぎたいなら、作物の収穫はいつでも人手が欲しいんだ。","index":1},{"form_id":"0x00080E|moretosayrorikstead.esp","type":"DIAL FULL","string":"家族について教えてくれ"},{"form_id":"0x00080F|moretosayrorikstead.esp","type":"INFO NAM1","string":"ママはずっと前に死んじゃった。今はパパが面倒を見てくれてる。","index":1},{"form_id":"0x00080F|moretosayrorikstead.esp","type":"INFO NAM1","string":"シッセルもね。残念だけど。","index":2},{"form_id":"0x000811|moretosayrorikstead.esp","type":"DIAL FULL","string":"町で何か面白いことは起きてる？"},{"form_id":"0x000812|moretosayrorikstead.esp","type":"INFO NAM1","string":"冒険好きな人に見えるわね。宿屋の息子のエリクと話してみるといいわ。あなたの助けを必要としてるの。","index":1},{"form_id":"0x000814|moretosayrorikstead.esp","type":"DIAL FULL","string":"仕事を探している。この辺りで何かやることは?"},{"form_id":"0x000815|moretosayrorikstead.esp","type":"INFO NAM1","string":"エリクとは話したかね？ 父親が、世の中に出て一旗揚げるのを許してくれないそうだ。君なら力になれるかもしれない。","index":1},{"form_id":"0x000817|moretosayrorikstead.esp","type":"DIAL FULL","string":"何か探してる?"},{"form_id":"0x000818|moretosayrorikstead.esp","type":"INFO NAM1","string":"グレダを見なかったかい？","index":1},{"form_id":"0x000819|moretosayrorikstead.esp","type":"DIAL FULL","string":"グレダ?"},{"form_id":"0x00081A|moretosayrorikstead.esp","type":"INFO NAM1","string":"品評会で賞を取ったうちのヤギが、しょっちゅう逃げ出すんだ。","index":1},{"form_id":"0x00081A|moretosayrorikstead.esp","type":"INFO NAM1","string":"それはそうと…ようこそ！ 俺はエニス。何か用かい、友よ？","index":2},{"form_id":"0x00081C|moretosayrorikstead.esp","type":"INFO NAM1","string":"賞を取った自慢のヤギが死んじまった。あいつがいなきゃ、何もかも変わっちまうよ。","index":1},{"form_id":"0x00081F|moretosayrorikstead.esp","type":"DIAL FULL","string":"家族について教えてくれ"},{"form_id":"0x000820|moretosayrorikstead.esp","type":"INFO NAM1","string":"あのバカ息子のエリクが心配でね。","index":1},{"form_id":"0x000820|moretosayrorikstead.esp","type":"INFO NAM1","string":"冒険者になりたがってるのはわかってる。だが世の中は危険なところだ。","index":2},{"form_id":"0x000820|moretosayrorikstead.esp","type":"INFO NAM1","string":"それに、鎧を買ってやる余裕もない。金を貯めないと。","index":3},{"form_id":"0x000820|moretosayrorikstead.esp","type":"INFO NAM1","string":"なぜあと一季節だけでも留まっていられないのか、わからんよ。","index":4},{"form_id":"0x00098D|moretosayrorikstead.esp","type":"INFO NAM1","string":"あのバカ息子のエリクが心配でね。","index":1},{"form_id":"0x00098D|moretosayrorikstead.esp","type":"INFO NAM1","string":"あいつは今、山賊と戦って冒険の日々を送ってる。","index":2},{"form_id":"0x00098D|moretosayrorikstead.esp","type":"INFO NAM1","string":"だが世の中は危険なところだ。エリクは自分が何に足を突っ込んでいるのか、まるでわかっていない。","index":3},{"form_id":"0x000821|moretosayrorikstead.esp","type":"DIAL FULL","string":"彼が話を聞かない？"},{"form_id":"0x000822|moretosayrorikstead.esp","type":"INFO NAM1","string":"母方の血のせいだな。","index":1},{"form_id":"0x000822|moretosayrorikstead.esp","type":"INFO NAM1","string":"気立てのいい子なんだが、世の中が本当はどれほど危険か、まるでわかっちゃいない。","index":2},{"form_id":"0x000822|moretosayrorikstead.esp","type":"INFO NAM1","string":"息子を過保護にしすぎだと言う者もいるが、聞かせてくれ。子どもを守るのが父親の務めじゃないか？","index":3},{"form_id":"0x000824|moretosayrorikstead.esp","type":"DIAL FULL","string":"静かでいい宿だね"},{"form_id":"0x000825|moretosayrorikstead.esp","type":"INFO NAM1","string":"食事でも部屋でも、どちらも用意できるよ。","index":1},{"form_id":"0x000825|moretosayrorikstead.esp","type":"INFO NAM1","string":"うちで受け取るのは本物の金だけだ。施しも物々交換もお断りだよ。","index":2},{"form_id":"0x000827|moretosayrorikstead.esp","type":"INFO NAM1","string":"こんにちは。この辺の人じゃないよね？","index":1},{"form_id":"0x000828|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドは訪れるのに良さそうな所だね。"},{"form_id":"0x000829|moretosayrorikstead.esp","type":"INFO NAM1","string":"泊まるところが必要なら宿屋に行くといいよ。","index":1},{"form_id":"0x000829|moretosayrorikstead.esp","type":"INFO NAM1","string":"たぶん気に入ると思う。","index":2},{"form_id":"0x00082C|moretosayrorikstead.esp","type":"DIAL FULL","string":"シッセル？"},{"form_id":"0x00082D|moretosayrorikstead.esp","type":"INFO NAM1","string":"シッセルったら、自分が特別だと思ってるの。そんなことないのに。","index":1},{"form_id":"0x00082E|moretosayrorikstead.esp","type":"DIAL FULL","string":"彼女は特別なのかもしれない。"},{"form_id":"0x00082F|moretosayrorikstead.esp","type":"INFO NAM1","string":"あたしより特別なんて、絶対ありえない。","index":1},{"form_id":"0x00082F|moretosayrorikstead.esp","type":"INFO NAM1","string":"あたしがお姉ちゃんなんだから。5分近く早く生まれたの。シッセルなんて、あたしの影を踏む資格もないんだから。","index":2},{"form_id":"0x000832|moretosayrorikstead.esp","type":"INFO NAM1","string":"やあ！ お名前は？ 遊びに来たの？ 何してる人？","index":1},{"form_id":"0x000834|moretosayrorikstead.esp","type":"DIAL FULL","string":"このあたりに冒険者が休める場所はある？"},{"form_id":"0x000835|moretosayrorikstead.esp","type":"INFO NAM1","string":"泊まるところが必要なら宿屋に行くといいよ。","index":1},{"form_id":"0x000835|moretosayrorikstead.esp","type":"INFO NAM1","string":"あなたみたいな冒険者になって、好きなところに行けたらいいのにな。","index":2},{"form_id":"0x000837|moretosayrorikstead.esp","type":"DIAL FULL","string":"家族について教えてくれ"},{"form_id":"0x000838|moretosayrorikstead.esp","type":"INFO NAM1","string":"たいていの日は、お姉ちゃんとお父さんからできるだけ離れてるようにしてるの。","index":1},{"form_id":"0x000838|moretosayrorikstead.esp","type":"INFO NAM1","string":"二人ともいじめてくるし、家事を全部押しつけるの。どっちにぶたれても同じくらい痛いし。","index":2},{"form_id":"0x000839|moretosayrorikstead.esp","type":"DIAL FULL","string":"それはひどい"},{"form_id":"0x00083A|moretosayrorikstead.esp","type":"INFO NAM1","string":"どこにでもある家族と同じだけど、それでもね。もうこんなところうんざり。","index":1},{"form_id":"0x00083C|moretosayrorikstead.esp","type":"DIAL FULL","string":"家族について教えてくれ"},{"form_id":"0x00083D|moretosayrorikstead.esp","type":"INFO NAM1","string":"家族だと？","index":1},{"form_id":"0x00083D|moretosayrorikstead.esp","type":"INFO NAM1","string":"俺は毎日畑の世話をしてるってのに、娘どもは何をしてる？ 何もだ！ 文句を言って喚くだけ！ 寝て食うだけ！ 役立たずめ！","index":2},{"form_id":"0x00083D|moretosayrorikstead.esp","type":"INFO NAM1","string":"悪いことは言わん、子どもなんか持つな。何の役にも立ちやしない。","index":3},{"form_id":"0x00083F|moretosayrorikstead.esp","type":"DIAL FULL","string":"仕事を探している。この辺りで何かやることは?"},{"form_id":"0x000840|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドに用があるなら、まずジュアンと話すといい。","index":1},{"form_id":"0x000841|moretosayrorikstead.esp","type":"DIAL FULL","string":"でも、ここはあなたの町じゃないの?"},{"form_id":"0x000842|moretosayrorikstead.esp","type":"INFO NAM1","string":"すまない、無礼なつもりはないんだが、人の相手をするのはジュアンの役目でね。私はとうの昔に愛想というものをなくしてしまった。","index":1},{"form_id":"0x000842|moretosayrorikstead.esp","type":"INFO NAM1","string":"かつての私は別人だった――強く、威厳があって、ああ、若かった。だが大戦はもう遠い昔のことだ。","index":2},{"form_id":"0x000844|moretosayrorikstead.esp","type":"DIAL FULL","string":"治癒師になる前は何をしていたんだ？"},{"form_id":"0x000845|moretosayrorikstead.esp","type":"INFO NAM1","string":"信じがたいだろうが、私もかつては君のような大胆な冒険者で、どんな危険にも立ち向かう覚悟があったのだよ。","index":1},{"form_id":"0x000846|moretosayrorikstead.esp","type":"DIAL FULL","string":"でも今は、いわば引退した身?"},{"form_id":"0x000847|moretosayrorikstead.esp","type":"INFO NAM1","string":"それはもう何年も前のことだよ、好奇心旺盛な友よ。","index":1},{"form_id":"0x000847|moretosayrorikstead.esp","type":"INFO NAM1","string":"年は取ったが、ロリクステッドのためにできることはするつもりだ。","index":2},{"form_id":"0x00084A|moretosayrorikstead.esp","type":"INFO NAM1","string":"ドラゴンボーン。この前ホワイトランに行った時、商人たちが君の噂をしていたよ。評判が高まっているようだね。","index":1},{"form_id":"0x00084C|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドは住みやすそうな所だね。"},{"form_id":"0x00084D|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドの善良な人々が人生に望むのは、平和と繁栄だけだ。","index":1},{"form_id":"0x00084D|moretosayrorikstead.esp","type":"INFO NAM1","string":"農業を始めようと考えているなら、ここを選んだのは正解だ。","index":2},{"form_id":"0x00084D|moretosayrorikstead.esp","type":"INFO NAM1","string":"リーチ地方にこれほど近いと、まあ、これほど肥沃な土地に恵まれているのは本当にありがたいことだ。","index":3},{"form_id":"0x00084F|moretosayrorikstead.esp","type":"DIAL FULL","string":"農業は楽しいか？"},{"form_id":"0x000850|moretosayrorikstead.esp","type":"INFO NAM1","string":"農業の何がいけないの？","index":1},{"form_id":"0x000852|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドは良い所みたいだね。"},{"form_id":"0x000853|moretosayrorikstead.esp","type":"INFO NAM1","string":"ここの人たちは正直で勤勉なの。物乞いや泥棒は許さないわ。","index":1},{"form_id":"0x000853|moretosayrorikstead.esp","type":"INFO NAM1","string":"あの衛兵たちを見た？ 道を外れたら、あの人たちを相手にすることになるわよ。","index":2},{"form_id":"0x000855|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドでの時間を楽しんでくれたまえ。","index":1},{"form_id":"0x000856|moretosayrorikstead.esp","type":"INFO NAM1","string":"グレダをこの辺りで見かけたはずなんだけどな。","index":1},{"form_id":"0x00085C|moretosayrorikstead.esp","type":"DIAL FULL","string":"また会ったね"},{"form_id":"0x00085D|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さんとの話はうまくいったかい？","index":1},{"form_id":"0x00085E|moretosayrorikstead.esp","type":"DIAL FULL","string":"まだだ。"},{"form_id":"0x00085F|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さんの考えを変えてくれるといいんだけど。ちょっと頑固なところがあってさ。","index":1},{"form_id":"0x000860|moretosayrorikstead.esp","type":"DIAL FULL","string":"どうして自分の子供を憎めるんだ?"},{"form_id":"0x000861|moretosayrorikstead.esp","type":"INFO NAM1","string":"ろくでなしの娘どもめ！ 俺の女房はあいつらが一生かかってもなれないくらいの女だった。あいつらを産むために命を落としたんだ。無駄死にだ。","index":1},{"form_id":"0x000864|moretosayrorikstead.esp","type":"INFO NAM1","string":"会えて嬉しいよ、友よ。勇敢だが、まだ実戦経験のない傭兵を雇ってみないか？","index":1},{"form_id":"0x000865|moretosayrorikstead.esp","type":"DIAL FULL","string":"新しい鎧の着心地はどう？"},{"form_id":"0x000866|moretosayrorikstead.esp","type":"INFO NAM1","string":"この新しい鎧、まるであつらえたみたいにぴったりだ。","index":1},{"form_id":"0x000866|moretosayrorikstead.esp","type":"INFO NAM1","string":"感謝してもしきれないよ、友よ。今は新しい剣のために金を貯めてるんだ。","index":2},{"form_id":"0x000868|moretosayrorikstead.esp","type":"DIAL FULL","string":"旅暮らしは楽しんでる?"},{"form_id":"0x000869|moretosayrorikstead.esp","type":"INFO NAM1","string":"冒険者としての新しい暮らしは、なんだかしっくりくるんだ。これが俺の天職なんだよ。","index":1},{"form_id":"0x00086A|moretosayrorikstead.esp","type":"DIAL FULL","string":"また畑仕事に戻りたいと思うことはある？"},{"form_id":"0x00086C|moretosayrorikstead.esp","type":"INFO NAM1","string":"最初は農作業が恋しくなると思ってた。でももう十分やり尽くしたんだろうな、全然恋しくないよ。","index":1},{"form_id":"0x00086B|moretosayrorikstead.esp","type":"DIAL FULL","string":"特に行きたい場所はある？"},{"form_id":"0x00086D|moretosayrorikstead.esp","type":"INFO NAM1","string":"ここスカイリムで十分稼げたら、ハンマーフェルに行ってどんな仕事があるか見てみようと思ってるんだ。","index":1},{"form_id":"0x00086F|moretosayrorikstead.esp","type":"DIAL FULL","string":"魔法は好き?"},{"form_id":"0x000870|moretosayrorikstead.esp","type":"INFO NAM1","string":"ウィンターホールドの大学の魔術師さん？","index":1},{"form_id":"0x000870|moretosayrorikstead.esp","type":"INFO NAM1","string":"ジュアンが魔法を教えてくれてるの。すごく上手だって言ってくれるんだ。もうすぐ、怖がらなくてもよくなるの。","index":2},{"form_id":"0x000870|moretosayrorikstead.esp","type":"INFO NAM1","string":"ちょっと思ったんだけど。炎の魔法を教えてもらえないかな？ 危ないのじゃなくて！ ろうそくに火をつける呪文とか？","index":3},{"form_id":"0x000871|moretosayrorikstead.esp","type":"DIAL FULL","string":"あなたに魔法を教える立場じゃない"},{"form_id":"0x000872|moretosayrorikstead.esp","type":"INFO NAM1","string":"わかった。ごめんなさい。考えるとつい、わくわくしちゃって。","index":1},{"form_id":"0x000873|moretosayrorikstead.esp","type":"DIAL FULL","string":"害はないと思う。(キャンドルライト)"},{"form_id":"0x000874|moretosayrorikstead.esp","type":"INFO NAM1","string":"わあ、すごい！ 待ちきれないよ！","index":1},{"form_id":"0x000875|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロウソクに火をつけるなんて大したことじゃない。本物の炎の魔法を見せてやろう。(火炎)"},{"form_id":"0x000876|moretosayrorikstead.esp","type":"INFO NAM1","string":"わあ、すごい！ 待ちきれないよ！","index":1},{"form_id":"0x000879|moretosayrorikstead.esp","type":"DIAL FULL","string":"子供たちのことで話がある"},{"form_id":"0x00087A|moretosayrorikstead.esp","type":"INFO NAM1","string":"厄介ごとはもう十分なんだ、これ以上増やすな。","index":1},{"form_id":"0x00087B|moretosayrorikstead.esp","type":"DIAL FULL","string":"子供たちをもっと大切にするべきだ"},{"form_id":"0x00087C|moretosayrorikstead.esp","type":"INFO NAM1","string":"お前と話す必要はない。失せろ。","index":1},{"form_id":"0x00087D|moretosayrorikstead.esp","type":"DIAL FULL","string":"何でもない"},{"form_id":"0x000888|moretosayrorikstead.esp","type":"INFO NAM1","string":"どうせ話は終わってたんだ。","index":1},{"form_id":"0x00087E|moretosayrorikstead.esp","type":"DIAL FULL","string":"本当にこれが子供たちのためになると思う？ (説得)"},{"form_id":"0x000880|moretosayrorikstead.esp","type":"INFO NAM1","string":"確かにお前の言う通りだ…すまない！ 俺だって変われる…こんなのは望んでないんだ！","index":1},{"form_id":"0x000881|moretosayrorikstead.esp","type":"INFO NAM1","string":"ハッ！ お前みたいな間抜けに子育ての何がわかる？","index":1},{"form_id":"0x00087F|moretosayrorikstead.esp","type":"DIAL FULL","string":"態度を改めないなら、相手になるぞ(威圧)"},{"form_id":"0x000882|moretosayrorikstead.esp","type":"INFO NAM1","string":"わかったよ！ ちゃんとやるから、頼むから放っておいてくれ！","index":1},{"form_id":"0x000883|moretosayrorikstead.esp","type":"INFO NAM1","string":"お前みたいな奴に、こんなことを言われる筋合いはない。","index":1},{"form_id":"0x000884|moretosayrorikstead.esp","type":"DIAL FULL","string":"言いたかったのはそれだけだ"},{"form_id":"0x000885|moretosayrorikstead.esp","type":"INFO NAM1","string":"そんなことだろうと思ったよ。","index":1},{"form_id":"0x000886|moretosayrorikstead.esp","type":"DIAL FULL","string":"誰かが礼儀を教えてやる時だな。(喧嘩)"},{"form_id":"0x000887|moretosayrorikstead.esp","type":"INFO NAM1","string":"そんな口のきき方をしたらどうなるか、教えてやる！","index":1},{"form_id":"0x000891|moretosayrorikstead.esp","type":"DIAL FULL","string":"農場は順調だね。誇らしいだろう。"},{"form_id":"0x000892|moretosayrorikstead.esp","type":"INFO NAM1","string":"その通りだ。","index":1},{"form_id":"0x000892|moretosayrorikstead.esp","type":"INFO NAM1","string":"さあ行け、仕事の邪魔だ。","index":3},{"form_id":"0x0008A0|moretosayrorikstead.esp","type":"DIAL FULL","string":"またドラゴンの夢を見た?"},{"form_id":"0x0008A1|moretosayrorikstead.esp","type":"INFO NAM1","string":"いいドラゴンが出てくる夢を見たの。年を取ってて灰色だったけど、怖くなかったよ。","index":1},{"form_id":"0x000986|moretosayrorikstead.esp","type":"INFO NAM1","string":"いいドラゴンが出てくる夢を見たの。年を取ってて灰色だった。怖くなかったけど、死んじゃったの。","index":1},{"form_id":"0x0008B9|moretosayrorikstead.esp","type":"DIAL FULL","string":"具合が悪いんだ。治してもらえないか?"},{"form_id":"0x0008BA|moretosayrorikstead.esp","type":"INFO NAM1","string":"喜んで力になろう。","index":1},{"form_id":"0x0008BA|moretosayrorikstead.esp","type":"INFO NAM1","string":"では、そこに立っていてくれ。君に向かって呪文を唱えるから。","index":2},{"form_id":"0x0008BA|moretosayrorikstead.esp","type":"INFO NAM1","string":"じっとして…","index":3},{"form_id":"0x0008C3|moretosayrorikstead.esp","type":"INFO NAM1","string":"ごく基本的な回復呪文はどうかね？ 役に立つ呪文だ。命を救ってくれるかもしれない。","index":1},{"form_id":"0x0008C4|moretosayrorikstead.esp","type":"INFO NAM1","string":"さて、そうだな。ごく基本的な炎の呪文はどうかね？","index":1},{"form_id":"0x0008BE|moretosayrorikstead.esp","type":"INFO NAM1","string":"水中で呼吸する方法を教えよう。もし川に落ちることがあれば、学んでおいてよかったと思うはずだ。","index":1},{"form_id":"0x0008C1|moretosayrorikstead.esp","type":"INFO NAM1","string":"ごく基本的な守りの呪文を教えよう。ごく基本的な呪文を防ぐには十分なものだ。いいかね？","index":1},{"form_id":"0x0008BF|moretosayrorikstead.esp","type":"DIAL FULL","string":"呪文を教えてもらえる？"},{"form_id":"0x0008C0|moretosayrorikstead.esp","type":"INFO NAM1","string":"私が知っていることを少し教えよう。だが気をつけるんだ。魔法とは本質的に不安定で危険なものだからね。","index":1},{"form_id":"0x0008C2|moretosayrorikstead.esp","type":"INFO NAM1","string":"私が知っていることを少し教えよう。だが後でな。すまないが疲れているんだ。本当に疲れた。","index":1},{"form_id":"0x0008BD|moretosayrorikstead.esp","type":"INFO NAM1","string":"私が教えられることは、もうすべて学んだようだね。","index":1},{"form_id":"0x0008C6|moretosayrorikstead.esp","type":"DIAL FULL","string":"本当に、実に立派だ。"},{"form_id":"0x0008C7|moretosayrorikstead.esp","type":"INFO NAM1","string":"ありがとう。でも本当に、私にそれ以下を期待してた？","index":1},{"form_id":"0x0008C7|moretosayrorikstead.esp","type":"INFO NAM1","string":"エニスと一緒にいて、私は受け入れられることと、愛と、人生の本当の目的を見つけたの。","index":2},{"form_id":"0x0009A4|moretosayrorikstead.esp","type":"INFO NAM1","string":"はい、何かご用かしら？","index":1},{"form_id":"0x0009A5|moretosayrorikstead.esp","type":"INFO NAM1","string":"何か用かね？","index":1},{"form_id":"0x0008D3|moretosayrorikstead.esp","type":"DIAL FULL","string":"農民こそスカイリムの魂だ。"},{"form_id":"0x0008D4|moretosayrorikstead.esp","type":"INFO NAM1","string":"その通りよ。","index":1},{"form_id":"0x0008E3|moretosayrorikstead.esp","type":"DIAL FULL","string":"エニスの面倒を見てくれるなんて親切だな。"},{"form_id":"0x0008E4|moretosayrorikstead.esp","type":"INFO NAM1","string":"よしてちょうだい、務めを果たしているだけよ。","index":1},{"form_id":"0x0008E5|moretosayrorikstead.esp","type":"DIAL FULL","string":"自分も養子を迎えている。"},{"form_id":"0x0008E6|moretosayrorikstead.esp","type":"INFO NAM1","string":"まあ本当？ 素晴らしいわ！ 最近は気にかける人なんてほとんどいないのに。感心したわ。","index":1},{"form_id":"0x0008E7|moretosayrorikstead.esp","type":"DIAL FULL","string":"農業は素朴な人々には十分だろう。"},{"form_id":"0x0008E8|moretosayrorikstead.esp","type":"INFO NAM1","string":"本当にね。","index":1},{"form_id":"0x0008EA|moretosayrorikstead.esp","type":"INFO NAM1","string":"都会の人は私たちを見下すかもしれないけど、持っているものはすべて自分たちの汗で手に入れたものなのよ。","index":1},{"form_id":"0x0008EC|moretosayrorikstead.esp","type":"DIAL FULL","string":"何か言いたそうだな"},{"form_id":"0x0008ED|moretosayrorikstead.esp","type":"DIAL FULL","string":"それに金を払う人がいるの？"},{"form_id":"0x0008EE|moretosayrorikstead.esp","type":"INFO NAM1","string":"いやいや、もっと妙なものに金を払う連中だっているんだ。糞と一緒に土も売り出してみるかな。","index":1},{"form_id":"0x0008F0|moretosayrorikstead.esp","type":"DIAL FULL","string":"ルンドを知ってる？ここに住んでいた男だ"},{"form_id":"0x0008F1|moretosayrorikstead.esp","type":"INFO NAM1","string":"時々ロリクステッドに来てたけど、知り合いだったとは言えないな。","index":1},{"form_id":"0x0008F1|moretosayrorikstead.esp","type":"INFO NAM1","string":"奥さんが一年ほど前に亡くなったんだ。","index":2},{"form_id":"0x0008F1|moretosayrorikstead.esp","type":"INFO NAM1","string":"少し落ち込んでるのは知ってたけど、死んだとは聞いてなかった。","index":3},{"form_id":"0x0008F9|moretosayrorikstead.esp","type":"INFO NAM1","string":"時々ロリクステッドに来てたけど、知り合いだったとは言えないな。","index":1},{"form_id":"0x0008F7|moretosayrorikstead.esp","type":"DIAL FULL","string":"次はどうすべきだと思う？"},{"form_id":"0x0008F8|moretosayrorikstead.esp","type":"INFO NAM1","string":"7000階段を登るところかい、友よ？ ちょっとした冒険なら一緒に行ってもいいぞ。","index":1},{"form_id":"0x0008FC|moretosayrorikstead.esp","type":"INFO NAM1","string":"ほんの少しの間でも休戦して手を組んで、このドラゴンどもを片付けるべきだと思わないか？","index":1},{"form_id":"0x0008FC|moretosayrorikstead.esp","type":"INFO NAM1","string":"このことについて、どう思う？","index":2},{"form_id":"0x0008FD|moretosayrorikstead.esp","type":"DIAL FULL","string":"サルモールに対抗できるのは帝国だけだ。"},{"form_id":"0x0008FE|moretosayrorikstead.esp","type":"DIAL FULL","string":"ストームクロークとスカイリムの自由を支持している"},{"form_id":"0x0008FF|moretosayrorikstead.esp","type":"DIAL FULL","string":"どちらの側にも説得力のある主張がある。"},{"form_id":"0x000900|moretosayrorikstead.esp","type":"DIAL FULL","string":"どうでもいい。どちらの側も全体が見えていない。"},{"form_id":"0x000902|moretosayrorikstead.esp","type":"INFO NAM1","string":"そうかもしれないな。考えておくよ。","index":1},{"form_id":"0x000973|moretosayrorikstead.esp","type":"INFO NAM1","string":"なあ、聞いてくれ。ドラゴンボーンだって？ ドラゴンだったのは母ちゃんか、それとも父ちゃんか？ ハハッ！","index":1},{"form_id":"0x000974|moretosayrorikstead.esp","type":"INFO NAM1","string":"そうだ！ ジョークがあるんだ。聞きたかったら、準備ができたら言ってくれ。","index":1},{"form_id":"0x000907|moretosayrorikstead.esp","type":"DIAL FULL","string":"その通りだと思う。彼らは休戦すべきだ。"},{"form_id":"0x000908|moretosayrorikstead.esp","type":"INFO NAM1","string":"本当に？ ああ、もちろん。なかなか高尚な解決策を生み出したって言えるな！","index":1},{"form_id":"0x000909|moretosayrorikstead.esp","type":"DIAL FULL","string":"「高尚」の意味、知らないだろう?"},{"form_id":"0x00090A|moretosayrorikstead.esp","type":"INFO NAM1","string":"いや。でも、いいことだろう？","index":1},{"form_id":"0x00090C|moretosayrorikstead.esp","type":"INFO NAM1","string":"ああ、かつて英雄がいた、その名は鍬押しのエリク…ロリクステッドからホワイトランへやってきた！","index":1},{"form_id":"0x00090D|moretosayrorikstead.esp","type":"INFO NAM1","string":"ああ、かつて英雄がいた、その名は赤のラグナル、ロリクステッドからホワイトランへやってきた！","index":1},{"form_id":"0x000984|moretosayrorikstead.esp","type":"INFO NAM1","string":"ああ、かつて英雄がいた、その名は鍬押しのエリク、ロリクステッドからホワイトランへやってきた！ うん、悪くないな。","index":1},{"form_id":"0x000985|moretosayrorikstead.esp","type":"INFO NAM1","string":"家に帰ってこられてよかった。","index":1},{"form_id":"0x000940|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドへようこそ。今日は何の用かな？","index":1},{"form_id":"0x000942|moretosayrorikstead.esp","type":"DIAL FULL","string":"この村について教えてくれないか？"},{"form_id":"0x000943|moretosayrorikstead.esp","type":"INFO NAM1","string":"ここはロリクステッドだ。静かな場所だが、いい人たちばかりだよ。泊まるなら、このフロストフルーツ亭で部屋も酒も用意できる。","index":1},{"form_id":"0x000945|moretosayrorikstead.esp","type":"DIAL FULL","string":"この辺りを仕切っているのは誰だ？"},{"form_id":"0x000946|moretosayrorikstead.esp","type":"INFO NAM1","string":"それについて詳しいことはロリクに聞くといい。ここはロリクステッドなんだからな。","index":1},{"form_id":"0x000947|moretosayrorikstead.esp","type":"DIAL FULL","string":"じゃあ、彼が首長なの?"},{"form_id":"0x000948|moretosayrorikstead.esp","type":"INFO NAM1","string":"いやいや。それはホワイトランの首長だ。","index":1},{"form_id":"0x000948|moretosayrorikstead.esp","type":"INFO NAM1","string":"ホワイトランには行ったことがあるかい？ 首長の宮殿は一見の価値がある。ドラゴンズリーチと呼ばれていてね。壁にでかいドラゴンの頭蓋骨が掛かってるんだ。","index":2},{"form_id":"0x00094A|moretosayrorikstead.esp","type":"DIAL FULL","string":"道の向かいの農夫はあまり愛想がよくないね。"},{"form_id":"0x00094B|moretosayrorikstead.esp","type":"INFO NAM1","string":"それはレムキルだな。","index":1},{"form_id":"0x00094B|moretosayrorikstead.esp","type":"INFO NAM1","string":"あいつがああなっちまったのを見るのはつらいよ。昔からああだったわけじゃないんだ。冷たいってことだがね。","index":2},{"form_id":"0x00094B|moretosayrorikstead.esp","type":"INFO NAM1","string":"時々、あいつはスカイリムで一番冷たい男なんじゃないかと思うよ。","index":3},{"form_id":"0x00094D|moretosayrorikstead.esp","type":"INFO NAM1","string":"奥さんが亡くなったんだ。何年か前にな。あいつには辛いことだった。","index":1},{"form_id":"0x00094D|moretosayrorikstead.esp","type":"INFO NAM1","string":"悲しい時期だったよ。","index":2},{"form_id":"0x00094D|moretosayrorikstead.esp","type":"INFO NAM1","string":"それでも、娘たちはすくすく育ってる。生まれたばかりの赤ん坊だったのがついこの間のようだ。","index":3},{"form_id":"0x00094D|moretosayrorikstead.esp","type":"INFO NAM1","string":"あいつは娘たちを怠け者の泣き虫だと思ってるが、子どもが遊んでるだけさ。子どもってのはそういうもんだろう。","index":4},{"form_id":"0x00094F|moretosayrorikstead.esp","type":"DIAL FULL","string":"レルディスについて何か知ってる？"},{"form_id":"0x000950|moretosayrorikstead.esp","type":"INFO NAM1","string":"いい人だよ。しかもアルトマーだ。","index":1},{"form_id":"0x000950|moretosayrorikstead.esp","type":"INFO NAM1","string":"エニスを引き取って、ずっと優しくしてやってる。","index":2},{"form_id":"0x000950|moretosayrorikstead.esp","type":"INFO NAM1","string":"神々にかけて、何かの魔法が働いてるんじゃないかと思うよ…あの人は、これまで見た誰よりも腕のいい農夫なんだ。","index":3},{"form_id":"0x000952|moretosayrorikstead.esp","type":"DIAL FULL","string":"戦争をどう思う？"},{"form_id":"0x000953|moretosayrorikstead.esp","type":"INFO NAM1","string":"気の毒に思うのは、この戦争で親を亡くした子どもたちだよ。","index":1},{"form_id":"0x000954|moretosayrorikstead.esp","type":"DIAL FULL","string":"彼女があなたを救った?"},{"form_id":"0x000955|moretosayrorikstead.esp","type":"INFO NAM1","string":"あの人が助けてくれなかったら、俺はたぶん泥棒か傭兵か、もっとひどいものになってた。","index":1},{"form_id":"0x000955|moretosayrorikstead.esp","type":"INFO NAM1","string":"俺は運がよかったし、本当に感謝してるんだ。","index":2},{"form_id":"0x000956|moretosayrorikstead.esp","type":"DIAL FULL","string":"ここでの役割は、具体的には？"},{"form_id":"0x000957|moretosayrorikstead.esp","type":"INFO NAM1","string":"俺はヤギの世話をしてる。それと牛もね。","index":1},{"form_id":"0x000957|moretosayrorikstead.esp","type":"INFO NAM1","string":"母さんはロリクステッドで一番の働き者の農夫だけど、商売の才覚があるのは俺の方さ。","index":2},{"form_id":"0x000959|moretosayrorikstead.esp","type":"DIAL FULL","string":"何か手を打つつもりか? それとも愚痴を言うだけか?"},{"form_id":"0x00095A|moretosayrorikstead.esp","type":"INFO NAM1","string":"あなたのこと好き。妹のシッセルを殴っても、言いつけないからね。","index":1},{"form_id":"0x00095B|moretosayrorikstead.esp","type":"DIAL FULL","string":"あなたの妹じゃないか。優しくしてあげるべきだ。(説得)"},{"form_id":"0x00095C|moretosayrorikstead.esp","type":"INFO NAM1","string":"あ、えっと…わかった。ごめんなさい。","index":1},{"form_id":"0x00095D|moretosayrorikstead.esp","type":"INFO NAM1","string":"ううん。そうは思わない。","index":1},{"form_id":"0x00095E|moretosayrorikstead.esp","type":"DIAL FULL","string":"分かった、引き受けよう。報酬はいくらだ？"},{"form_id":"0x00095F|moretosayrorikstead.esp","type":"INFO NAM1","string":"え、何？ その、わあ。うん。すごくいいと思う、ただ、えっと…なんていうか…","index":1},{"form_id":"0x00095F|moretosayrorikstead.esp","type":"INFO NAM1","string":"誰かを傷つけたりしないよね？","index":2},{"form_id":"0x000960|moretosayrorikstead.esp","type":"DIAL FULL","string":"子供を殴るつもりはない。"},{"form_id":"0x000961|moretosayrorikstead.esp","type":"INFO NAM1","string":"いいよ。","index":1},{"form_id":"0x00096E|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドに来ているよそ者はいる？"},{"form_id":"0x00096F|moretosayrorikstead.esp","type":"INFO NAM1","string":"アリクルの戦士たちがここに隠れてるのは気に入らないな。厄介ごとの種になりそうだ。","index":1},{"form_id":"0x000970|moretosayrorikstead.esp","type":"INFO NAM1","string":"神々よ、また一人来やがった！ よそ者はいつも厄介ごとを持ち込む。荷物をまとめて出ていったらどうだ？","index":1},{"form_id":"0x000987|moretosayrorikstead.esp","type":"INFO NAM1","string":"おいおい。私が気にしているのは、むしろ彼らがどう迎えられるかだ。","index":1},{"form_id":"0x000987|moretosayrorikstead.esp","type":"INFO NAM1","string":"ここスカイリムでは、レッドガードの文化に触れる機会はそうないだろう。宿屋の主人に話しておかねば。","index":2},{"form_id":"0x000987|moretosayrorikstead.esp","type":"INFO RNAM","string":"アリクル人の訪問者は何か問題を起こしてる?"},{"form_id":"0x000989|moretosayrorikstead.esp","type":"INFO NAM1","string":"宿屋にいるわ。探してみて。きっと見つかるわよ。","index":1},{"form_id":"0x000989|moretosayrorikstead.esp","type":"INFO RNAM","string":"レッドガードの来訪者を探している。そういう人を見かけなかった?"},{"form_id":"0x000990|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドに来た人は、たいてい宿屋に泊まるんだ。","index":1},{"form_id":"0x000990|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さんがここの宿屋の主人なんだ。きっと力になってくれるよ。","index":2},{"form_id":"0x000990|moretosayrorikstead.esp","type":"INFO RNAM","string":"最近ロリクステッドで外国からの来訪者を見かけたか？"},{"form_id":"0x000991|moretosayrorikstead.esp","type":"INFO NAM1","string":"宿屋にいるわ。探してみて。きっと見つかるわよ。","index":1},{"form_id":"0x000991|moretosayrorikstead.esp","type":"INFO NAM1","string":"いないなら、すぐ戻ってくるはずだ。よかったらここで待っててくれ。","index":2},{"form_id":"0x000991|moretosayrorikstead.esp","type":"INFO RNAM","string":"レッドガードの旅人を探している。一人じゃないかもしれない。見かけなかった?"},{"form_id":"0x000995|moretosayrorikstead.esp","type":"INFO NAM1","string":"どうも皆が少し神経質になっているようでね。ああいう人たちがここで何をしているのだろう？","index":1},{"form_id":"0x000995|moretosayrorikstead.esp","type":"INFO RNAM","string":"最近ロリクステッドで外国からの来訪者を見かけたか？"},{"form_id":"0x000857|moretosayrorikstead.esp","type":"INFO NAM1","string":"ロリクステッドはノルドの村にしてはまあ快適だが、早く故郷に帰りたいものだ。","index":1},{"form_id":"0x000857|moretosayrorikstead.esp","type":"INFO RNAM","string":"ロリクステッドをどう思う？"},{"form_id":"0x000971|moretosayrorikstead.esp","type":"DIAL FULL","string":"どうぞ。"},{"form_id":"0x000975|moretosayrorikstead.esp","type":"DIAL FULL","string":"(うめく) 頼む、やめて……"},{"form_id":"0x000977|moretosayrorikstead.esp","type":"DIAL FULL","string":"何を言っても止められないんだろう？"},{"form_id":"0x00097B|moretosayrorikstead.esp","type":"INFO NAM1","string":"あのバカ息子のエリクはどうしてる？","index":1},{"form_id":"0x00097F|moretosayrorikstead.esp","type":"INFO NAM1","string":"エリク？ 息子が？ 何かあったのか？ 無事なのか？","index":1},{"form_id":"0x000980|moretosayrorikstead.esp","type":"INFO NAM1","string":"エリク？ 何かあったのか？ お前…大丈夫か？","index":1},{"form_id":"0x00097D|moretosayrorikstead.esp","type":"INFO NAM1","string":"頼むから、声を落としてくれ。俺は大丈夫だ。","index":1},{"form_id":"0x000981|moretosayrorikstead.esp","type":"INFO NAM1","string":"大丈夫だよ、父さん。また会えて嬉しいよ。","index":1},{"form_id":"0x000982|moretosayrorikstead.esp","type":"INFO NAM1","string":"まあ、うまくやってるよ。家に帰ってこられてよかった。","index":1},{"form_id":"0x000988|moretosayrorikstead.esp","type":"DIAL FULL","string":"このアリクルの者たちをどう思う？"},{"form_id":"0x00098A|moretosayrorikstead.esp","type":"INFO NAM1","string":"そういうことには本当に関わらないようにしてるの。","index":1},{"form_id":"0x00098A|moretosayrorikstead.esp","type":"INFO NAM1","string":"ノルドはよそ者に対して、良くても疑いの目を向けるものよ。私としては、人と付き合うより牛や作物を相手にしている方がずっと幸せだわ。","index":2},{"form_id":"0x000992|moretosayrorikstead.esp","type":"INFO NAM1","string":"町の連中の中には違う者もいるが、私はよそ者に何の偏見もないよ。","index":1},{"form_id":"0x000992|moretosayrorikstead.esp","type":"INFO NAM1","string":"何しろ、これは商売だからな。","index":2},{"form_id":"0x000992|moretosayrorikstead.esp","type":"INFO NAM1","string":"機会を与えれば、彼らも十分友好的だよ。それに、金が入るのはありがたい。","index":3},{"form_id":"0x000996|moretosayrorikstead.esp","type":"INFO NAM1","string":"我々は農民の共同体だ。ここに秘密などない。","index":1},{"form_id":"0x000996|moretosayrorikstead.esp","type":"INFO RNAM","string":"誰かを探しているのかもしれない。"},{"form_id":"0x000997|moretosayrorikstead.esp","type":"INFO NAM1","string":"八大神にかけて、声を落としてくれ！ 村中に我々の秘密を知られたいのかね？","index":1},{"form_id":"0x000997|moretosayrorikstead.esp","type":"INFO RNAM","string":"この土地がなぜ肥沃なのか、知られるのが心配？"},{"form_id":"0x00098B|moretosayrorikstead.esp","type":"DIAL FULL","string":"いつまでも彼を守ってはいられない"},{"form_id":"0x00098C|moretosayrorikstead.esp","type":"INFO NAM1","string":"私は…お前の言うことが正しいのは否定できない。","index":1},{"form_id":"0x00098C|moretosayrorikstead.esp","type":"INFO NAM1","string":"だが、エリクは私に残された唯一の家族なんだ。","index":2},{"form_id":"0x00098C|moretosayrorikstead.esp","type":"INFO NAM1","string":"何年か前に妻が死んだとき、あいつを手放せるか自信がなかった。","index":3},{"form_id":"0x00098C|moretosayrorikstead.esp","type":"INFO NAM1","string":"息子がここにいれば…手放さなくて済む。心が安らぐんだ。","index":4},{"form_id":"0x00098F|moretosayrorikstead.esp","type":"INFO NAM1","string":"その上、今度は反乱やらドラゴンやらの話だ。世の中狂ってきてるよ。","index":1},{"form_id":"0x00099A|moretosayrorikstead.esp","type":"DIAL FULL","string":"生まれてからずっとロリクステッドに?"},{"form_id":"0x00099B|moretosayrorikstead.esp","type":"INFO NAM1","string":"このロリクステッドで生まれ育ったんだ。","index":1},{"form_id":"0x00099D|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さんは兵士だった。大戦を戦って、それが終わるとここに隠居して家族を持ったんだ。","index":1},{"form_id":"0x00099D|moretosayrorikstead.esp","type":"INFO NAM1","string":"母さんは俺が赤ん坊の頃に亡くなったから、父さんは男手一つで精一杯俺を育ててくれた。","index":2},{"form_id":"0x0009A0|moretosayrorikstead.esp","type":"INFO NAM1","string":"母さんは俺が赤ん坊の頃に亡くなったんだ。","index":1},{"form_id":"0x0009A0|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さんは…ここの宿屋の主人だったんだけど、死んでしまった。","index":2},{"form_id":"0x0009A0|moretosayrorikstead.esp","type":"INFO NAM1","string":"父さん、会いたくてたまらないよ。俺…ごめん。","index":3},{"form_id":"0x0009A0|moretosayrorikstead.esp","type":"INFO NAM1","string":"(すすり泣き)","index":4},{"form_id":"0x00099F|moretosayrorikstead.esp","type":"INFO NAM1","string":"世界一刺激的な場所ってわけじゃないけど、ここの人たちは一生懸命働くし、誰にも迷惑をかけない。","index":1},{"form_id":"0x0009A2|moretosayrorikstead.esp","type":"DIAL FULL","string":"ロリクステッドの作物はよく育っているね。"},{"form_id":"0x0009A3|moretosayrorikstead.esp","type":"INFO NAM1","string":"本当だよ。物心ついた頃から、うちの作物はいつも豊作だった。","index":1},{"form_id":"0x0009A3|moretosayrorikstead.esp","type":"INFO NAM1","string":"土のおかげか、気候のおかげか、神々のご加護かはわからないけど、不作だったことは一度もないんだ。","index":2},{"form_id":"0x000ED1|moretosayrorikstead.esp","type":"DIAL FULL","string":"作物はどこで売ってる？"},{"form_id":"0x000ED2|moretosayrorikstead.esp","type":"INFO NAM1","string":"時々ホワイトランに行くんだ。たいていは商談でね。","index":1},{"form_id":"0x000ED2|moretosayrorikstead.esp","type":"INFO NAM1","string":"街から来たのかい？ ホワイトランで商売してる知り合いがいるなら、俺のことを知ってるかもな。","index":2},{"form_id":"0x000EDC|moretosayrorikstead.esp","type":"DIAL FULL","string":"実際かなり面白かったよ"},{"form_id":"0x000EE0|moretosayrorikstead.esp","type":"INFO NAM1","string":"ありがとう、ありがとう。いや、拍手はいいから。","index":1},{"form_id":"0x000EE0|moretosayrorikstead.esp","type":"INFO NAM1","string":"私は吟遊詩人のエリク・グリーンサム。あなたの執政の手配で、あなたにお仕えすることになりました。","index":2},{"form_id":"0x000EDD|moretosayrorikstead.esp","type":"DIAL FULL","string":"酷かった"},{"form_id":"0x000EDF|moretosayrorikstead.esp","type":"INFO NAM1","string":"本当に？ それは悪かった。","index":1},{"form_id":"0x000EDF|moretosayrorikstead.esp","type":"INFO NAM1","string":"名誉にかけて、もう二度と心配させないよ。","index":2},{"form_id":"0x000EDE|moretosayrorikstead.esp","type":"DIAL FULL","string":"それは…確かに…冗談と考える人もいるかもしれない…ものだね。うん"},{"form_id":"0x000EE1|moretosayrorikstead.esp","type":"INFO NAM1","string":"わかった、わかったよ。了解だ。あなたにお仕えできて光栄だった。","index":1},{"form_id":"0x000804|moretosayrorikstead.esp","type":"QUST FULL","string":"More to Say ロリクステッド"},{"form_id":"0x000877|moretosayrorikstead.esp","type":"QUST FULL","string":"レムキルの嘆き"},{"form_id":"0x000979|moretosayrorikstead.esp","type":"QUST FULL","string":"エリクとムラルキのシーン"}]
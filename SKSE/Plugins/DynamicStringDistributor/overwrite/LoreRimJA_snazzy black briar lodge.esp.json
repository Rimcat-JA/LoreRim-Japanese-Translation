[{"form_id":"0x00024A|snazzy black briar lodge.esp","type":"NPC_ FULL","string":"ネルダイ"},{"form_id":"0x00024A|snazzy black briar lodge.esp","type":"NPC_ SHRT","string":"ネルダイ"},{"form_id":"0x000361|snazzy black briar lodge.esp","type":"NPC_ FULL","string":"ウィリアード"},{"form_id":"0x000361|snazzy black briar lodge.esp","type":"NPC_ SHRT","string":"ウィリアード"},{"form_id":"0x00076F|snazzy black briar lodge.esp","type":"DIAL FULL","string":"リフトの外、城壁の外でより大きな家を探しているんだ。何かアイデアはないか？"},{"form_id":"0x000770|snazzy black briar lodge.esp","type":"INFO NAM1","string":"まあ、あなたはリフテンの役に立ってきた。うちの家族はもうあそこを訪れる時間がないから、私たちのロッジをあなたに売ってもいいかもしれないね？","index":1},{"form_id":"0x000771|snazzy black briar lodge.esp","type":"DIAL FULL","string":"そのブラック・ブライア・ロッジなら…聞いたことがある。もっと詳しく教えてくれないか？"},{"form_id":"0x000772|snazzy black briar lodge.esp","type":"INFO NAM1","string":"何年も我が家に伝わる品で、これ以外にない逸品だと断言できる！","index":1},{"form_id":"0x000772|snazzy black briar lodge.esp","type":"INFO NAM1","string":"家族や友人を招くのに十分な広さで、いくつもの作業場、広い食堂、完備されたキッチン、ワインセラー、風呂などが付いている","index":2},{"form_id":"0x000772|snazzy black briar lodge.esp","type":"INFO NAM1","string":"それに最近、隣の山へと続く別館を増築したんだ。そこには澄んだ冷たい水の池がある小さな洞窟を見つけてね、泳げるようになっているよ。","index":3},{"form_id":"0x000773|snazzy black briar lodge.esp","type":"DIAL FULL","string":"ブラック・ブライア家に良ければ、俺にも十分だ！　いくらだ？"},{"form_id":"0x000774|snazzy black briar lodge.esp","type":"INFO NAM1","string":"ふむ、たった35,000セプティムで手放してもいいぞ。君の乏しい財力で払えるかな？","index":1},{"form_id":"0x000775|snazzy black briar lodge.esp","type":"DIAL FULL","string":"35,000セプティムは私には高すぎる。遠慮しておくよ。"},{"form_id":"0x000776|snazzy black briar lodge.esp","type":"INFO NAM1","string":"まあ、お前が自分の家と呼ぶどんなあばら家でも、きっと幸せにやっていけるさ。気が変わったら声をかけてくれ…まだ気前よくしてやれるかもしれん。","index":1},{"form_id":"0x000777|snazzy black briar lodge.esp","type":"DIAL FULL","string":"35,000セプティムなら妥当だな…買おう！"},{"form_id":"0x000778|snazzy black briar lodge.esp","type":"INFO NAM1","string":"素晴らしい。では35,000セプティムを頂こう。こちらが君のロッジの鍵だ。","index":1},{"form_id":"0x00077D|snazzy black briar lodge.esp","type":"INFO NAM1","string":"ゴールドが足りないな、十分に持ってから出直せ！","index":1},{"form_id":"0x00077A|snazzy black briar lodge.esp","type":"DIAL FULL","string":"気が変わった。宿屋「ブラック・ブライア」を買いたい。"},{"form_id":"0x00077B|snazzy black briar lodge.esp","type":"INFO NAM1","string":"うーん…運がいいな、まだ気前がいい気分なんだ。よし、35,000セプティムを受け取ろう。これがお前のロッジの鍵だ。","index":1},{"form_id":"0x00077C|snazzy black briar lodge.esp","type":"INFO NAM1","string":"ゴールドが足りないな、十分に持ってから出直せ！","index":1},{"form_id":"0x0007CD|snazzy black briar lodge.esp","type":"DIAL FULL","string":"いつものように楽しいひとときをありがとう、メイビン。"},{"form_id":"0x0007CE|snazzy black briar lodge.esp","type":"INFO NAM1","string":"ああ、それと少しだけ話が…","index":1},{"form_id":"0x0007CE|snazzy black briar lodge.esp","type":"INFO NAM1","string":"最近、全く品のない新しい家政婦のネルダイを雇ったんだ。","index":2},{"form_id":"0x0007CE|snazzy black briar lodge.esp","type":"INFO NAM1","string":"彼女は部屋と食事の代わりに働いている。置いておくもよし、始末するもよし、好きにするがいい。","index":3},{"form_id":"0x0007CE|snazzy black briar lodge.esp","type":"INFO NAM1","string":"それと、そこに子供たちを住まわせるおつもりなら、部下に部屋を用意させます。一度設置したらそのままになることをお忘れなく！","index":4},{"form_id":"0x0007CF|snazzy black briar lodge.esp","type":"DIAL FULL","string":"はい、私はぜひ子供たちにそこに住んでほしいです。"},{"form_id":"0x0007D2|snazzy black briar lodge.esp","type":"INFO NAM1","string":"わかった、出発前に部下に子供部屋を用意させよう。ロッジを楽しんでくれ……汚さないようにな。","index":1},{"form_id":"0x0007D0|snazzy black briar lodge.esp","type":"DIAL FULL","string":"子供はダメだ、少なくともこのロッジではな！"},{"form_id":"0x0007D1|snazzy black briar lodge.esp","type":"INFO NAM1","string":"わかった、部屋はそのままにしておこう。ロッジを楽しんでくれ…汚さないようにな！","index":1},{"form_id":"0x00076C|snazzy black briar lodge.esp","type":"QUST CNAM","string":"今はロッジを買わないことにした","index":10},{"form_id":"0x00076C|snazzy black briar lodge.esp","type":"QUST CNAM","string":"ロッジを購入した！","index":20},{"form_id":"0x00076C|snazzy black briar lodge.esp","type":"QUST CNAM","string":"子供たち はい！","index":30}]
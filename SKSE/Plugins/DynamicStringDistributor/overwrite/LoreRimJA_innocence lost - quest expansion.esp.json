[{"form_id":"0x000889|innocence lost - quest expansion.esp","type":"MGEF FULL","string":"首長の息子の血痕"},{"form_id":"0x00088F|innocence lost - quest expansion.esp","type":"MGEF FULL","string":"毒まみれ"},{"form_id":"0x00088F|innocence lost - quest expansion.esp","type":"MGEF DNAM","string":"グレロッド、死ね、この老いぼれババア"},{"form_id":"0x000890|innocence lost - quest expansion.esp","type":"SPEL FULL","string":"グレロッド 毒"},{"form_id":"0x000888|innocence lost - quest expansion.esp","type":"SPEL FULL","string":"グレロッド 流血"},{"form_id":"0x000894|innocence lost - quest expansion.esp","type":"ACTI FULL","string":"グレロッドへ"},{"form_id":"0x00084C|innocence lost - quest expansion.esp","type":"ALCH FULL","string":"毒入りファイアブランドワイン"},{"form_id":"0x000831|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"来ちゃいけない所をうろついてたね。自分でもわかってるんだろう。","index":1},{"form_id":"0x000896|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"見てごらん、ろくでもないことを企んでる顔だ！ さっさと出て行きな！","index":1},{"form_id":"0x000891|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"年寄りに恥をかかせに来たのかい？ 放っておいておくれ！","index":1},{"form_id":"0x000832|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"放っておいてください！ 取り乱しているのがわからないんですか？！","index":1},{"form_id":"0x000833|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"よりによってあなたが！ 出て行って！","index":1},{"form_id":"0x00085C|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ほら、早く、早く！","index":1},{"form_id":"0x00085D|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"さっさと行くよ、一日中暇じゃないんだ！","index":1},{"form_id":"0x00085E|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ふんふん。","index":1},{"form_id":"0x000887|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"うわぁ！ 誰かがグレロッドを殺したんだって。コンスタンスがそう言ってた！","index":1},{"form_id":"0x000898|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"いやぁぁぁ！","index":1},{"form_id":"0x00088C|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"うぐっ……","index":1},{"form_id":"0x000801|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"グレロッドが孤児院で子供たちを虐待している。何とかしてくれ。"},{"form_id":"0x000802|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"いや、遠慮しておく。他の衛兵に任せるさ。","index":1},{"form_id":"0x000804|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"グレロッドが孤児院で子供たちを虐待している。何とかしてくれ。"},{"form_id":"0x000805|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"悪いが、そういうことは何も知らん。さっさと行け。","index":1},{"form_id":"0x000806|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"彼女は子供たちを壁に鎖で繋いでさえいる。お願いだ、何とかしてほしい。(説得)"},{"form_id":"0x000808|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"俺の知ったことじゃない。行けと言っただろう。今すぐだ！","index":1},{"form_id":"0x000807|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"彼女は子供たちを壁に鎖で繋いでさえいる。お願いだ、何とかしてほしい。(説得)"},{"form_id":"0x000809|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"仕事、仕事、仕事。うえっ。わかったよ、ついて来い。","index":1},{"form_id":"0x00080A|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"頼む、彼女を逮捕してくれ。金なら払う。(<BribeCost>ゴールド)"},{"form_id":"0x00080C|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"その値段で？ いいとも。ついて来い。","index":1},{"form_id":"0x00080B|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"頼む、彼女を逮捕してくれ。金なら払う。(<BribeCost>ゴールド)"},{"form_id":"0x00080D|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"なあ……法ってのは少々融通が利くもんだ。金さえあればな。だがお前には足りない！ さっさと行け。","index":1},{"form_id":"0x00080E|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"私はリフテンの従士だ。今すぐあの女を逮捕するよう命じる。"},{"form_id":"0x00080F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"おっと、失礼しました、従士殿。あなたとは気づきませんでした。ええ……わかりました。ついて来てください。時間がもったいない。","index":1},{"form_id":"0x000814|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"グレロッド、話がある。噂があるんだよ……体罰のな。で、言われていることは本当なのか、ん？","index":1},{"form_id":"0x000816|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"出て行け！ 今すぐ出て行きな！ 自分の孤児院で脅されてたまるもんかい。よくもまあ！","index":1},{"form_id":"0x000816|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"この役立たずのドブネズミが。お前なんか何の価値もない！ リフテンの連中はみんなそうさ。クズばかりだ！","index":2},{"form_id":"0x000819|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ふむ。なるほど。お前を逮捕する。さあ、おとなしくついて来い。","index":1},{"form_id":"0x00081B|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"おや、そうはいかないよ。あたしにそんな口をきいたらどうなるか教えてやる。コンスタンス！ ベルトを。今すぐ！","index":1},{"form_id":"0x00081D|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"下がれ！ 逮捕に抵抗すれば死ぬことになるぞ。好きに選べ。","index":1},{"form_id":"0x00081F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"礼儀知らずだね、武器を抜いたままふんぞり返って、皆を脅して回るなんて、ん？ まったく恥ずかしい。","index":1},{"form_id":"0x00081F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あんたみたいな輩にこんなこと言われる筋合いはないよ。友人の首長に話してやろうかね！ 今に見てな。さあ、出て行きな！","index":2},{"form_id":"0x000821|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"最後の警告だ！","index":1},{"form_id":"0x000823|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"なるほど。おめでとう……お前の勝ちだ。行くぞ。だが手は出すなよ、いいな？！","index":1},{"form_id":"0x000825|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"賢い女だ。さあ、ついて来い。それと、神々にかけて……静かにしててくれ。頼むから！","index":1},{"form_id":"0x00082A|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"考え直した…やっぱりいい。"},{"form_id":"0x00088D|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"お願い……","index":1},{"form_id":"0x000897|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あたしから隠れられると思うんじゃないよ！","index":1},{"form_id":"0x000837|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"後でとっておきのファイアブランド・ワインを開けるんだ。待ちきれないよ……コンスタンス！","index":1},{"form_id":"0x000830|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"なんて汚い場所だ！ 嘆かわしい。","index":1},{"form_id":"0x000852|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あたしのスカイリムはどうなっちまったんだい？ どこを見ても猫にトカゲにエルフ。反吐が出るよ。","index":1},{"form_id":"0x00083A|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"はい、グレロッドさん？","index":1},{"form_id":"0x00083C|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"いいかい。良い教師になるには二つのものが必要だ。一つ目はたっぷりの折檻。二つ目は指の関節を叩くための硬い木の棒だ。わかったかい？！","index":1},{"form_id":"0x00083E|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"でも、私……この子たちには愛情と安らぎが必要だと思うんです。私……","index":1},{"form_id":"0x000840|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"だめだ。そんな馬鹿げたことは終わりにしな。でなきゃ、あたしが終わらせてやる。","index":1},{"form_id":"0x000842|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"私……こうでなければよかったのにと思います。","index":1},{"form_id":"0x000844|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"いいや、いいや、お嬢ちゃん。そんなのは全部無駄な努力さ。","index":1},{"form_id":"0x000846|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ふん。","index":1},{"form_id":"0x000848|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"さて。本当にワインに戻らないとね。何しろ、あんたに教えるのは疲れるんだよ、お嬢ちゃん。","index":1},{"form_id":"0x000854|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"(咳き込み) いや……(あえぎ) ああ……","index":1},{"form_id":"0x000855|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"何だって？！ いや！ 汚い泥棒どもめ！ どこを見ても猫にトカゲにエルフ。反吐が出る！","index":1},{"form_id":"0x000855|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"スカイリムも昔ほど安全じゃなくなったね。また扉に鍵をかけるようにしないと。","index":2},{"form_id":"0x000856|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ああぁ、そうそう。美味しかった。","index":1},{"form_id":"0x000861|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"どこにいるんだい……？ この小僧め！ ほら、出ておいで！","index":1},{"form_id":"0x000862|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"見ろ!あそこにいる!(押す)"},{"form_id":"0x000867|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あのクソガキめ！ 見つけ出してやるとわかってたよ……","index":1},{"form_id":"0x000863|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"やっぱり…彼を見なかったかもしれない。"},{"form_id":"0x000865|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"よくも！ あたしに手を出したらどうなるか教えてやる！ かかってきな！","index":1},{"form_id":"0x000864|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"アレティノ? ウィンドヘルムの家にいるよ。よろしくと言っていた (攻撃)"},{"form_id":"0x000866|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"よくも！ かかってきな！ まだ戦う力は残ってるよ！","index":1},{"form_id":"0x00086A|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"そんな！ 何があったの！ これは……まさか！ 毒……","index":1},{"form_id":"0x00086C|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"なんてこと……グレロッドが！ 殺された……ここで？！ 外の空気を……あなた、あなたはここから出て行って。出て行って！","index":1},{"form_id":"0x000872|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"うーん。もうずいぶん経つのに。グレロッドはどこへ行ったんでしょう？！","index":1},{"form_id":"0x00086E|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"グレロッドが殺されたんです！ どうかお引き取りください。","index":1},{"form_id":"0x000870|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"子供たちの世話で忙しいんです。申し訳ありませんが、どうかお引き取りください。","index":1},{"form_id":"0x00086F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"お願い。無理です。とにかく……とにかく帰って。","index":1},{"form_id":"0x000871|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"申し訳ありませんが、本当にお引き取りください。","index":1},{"form_id":"0x000874|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"ところで…グレロッドが投獄されて、ここの様子はどう?"},{"form_id":"0x000875|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"グレロッドは最近亡くなりました。殺されたんです。ごめんなさい……ご存じなかったんですか？","index":1},{"form_id":"0x000876|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"誰が彼女を殺したか、心当たりは？"},{"form_id":"0x000877|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"噂では……(ため息) その、暗殺者の話があって。ええ……わかりません。グレロッドが死んだなんて、まだ信じられないんです。","index":1},{"form_id":"0x000878|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"子供たちは彼女の死をどう受け止めている?"},{"form_id":"0x000879|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"子供たちはまだ知りません。ええ、まだです。かわいそうに、あの子たちには他に誰もいないんです。まあ、私以外には。","index":1},{"form_id":"0x00087A|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"知らせてくれてありがとう。出発する前にもう一つ…"},{"form_id":"0x00087B|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"わかりました。何でしょう？","index":1},{"form_id":"0x00087C|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"お悔やみ申し上げる。孤児院のこと、頑張って。"},{"form_id":"0x00087D|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ありがとう。さて、子供たちのところに戻らないと。それでは。","index":1},{"form_id":"0x00087E|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"グレロッドに同情するのはやめろ。あいつがいない方が世の中のためだ。"},{"form_id":"0x00087F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"なんて冷酷でひどい人なんですか？ もう……いいです。聞いてください。","index":1},{"form_id":"0x00087F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あの人に好意は持っていませんでしたが、冷酷に殺されるなんて……その……気の毒なことです。","index":2},{"form_id":"0x00087F|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"うーん。子供たちの世話で忙しいので。お帰りください。","index":3},{"form_id":"0x000881|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"実は…グレロッドはもう始末した。彼女のことは片付いたと思ってくれ"},{"form_id":"0x000882|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"本当に？！ 闇の一党が凄腕なのは知ってたけど、まさかここまでとは……あの婆さんを、頼む前に殺しちゃうなんて！","index":1},{"form_id":"0x000D63|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"彼女はもう二度と戻らないと思っていいよ。逮捕させたから。"},{"form_id":"0x000D64|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"やった！ 親切者のグレロッドを殺してくれたんだね！ あんたならやれるって信じてた、絶対やれるって！","index":1},{"form_id":"0x000D65|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"いや、違う、誤解だ、つまり…"},{"form_id":"0x000D66|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"何も言わなくていいよ。必要ないから。","index":1},{"form_id":"0x000D66|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ああ、それと、これを報酬として受け取って。昔からの家宝で、かなり価値があるらしいんだ。いい値で売れるはずだよ。本当にありがとう！","index":2},{"form_id":"0x000DC4|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"子供の一人が逃げ出したと聞いたぞ。"},{"form_id":"0x000DC5|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"アレティノ？ あのクソガキめ。見つけたら、あいつの惨めな人生で最悪の折檻をくれてやる。","index":1},{"form_id":"0x000DC6|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"このくらいの背丈の男か？ さっき波止場で見かけた。案内するよ。(嘘)"},{"form_id":"0x000DC7|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"何だって？！ あんたが？ 獣が戻ってきたってわけかい！ はっ！","index":1},{"form_id":"0x000DC7|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"コンスタンス！ ベルトを。今すぐ！","index":2},{"form_id":"0x000DC7|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"ああ、すまないね。ここにあったよ。よし！ 行くよ。","index":3},{"form_id":"0x000DCF|innocence lost - quest expansion.esp","type":"DIAL FULL","string":"子供たちのことをそんなふうに言うべきじゃない。"},{"form_id":"0x000DD0|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あんたみたいな輩にこんなこと言われる筋合いはないよ。出て行け！ 今すぐ出て行きな！ 自分の孤児院で脅されてたまるもんかい。よくもまあ！","index":1},{"form_id":"0x000DFF|innocence lost - quest expansion.esp","type":"INFO NAM1","string":"あら、こんにちは。何かご用でしょうか？","index":1},{"form_id":"0x000836|innocence lost - quest expansion.esp","type":"QUST NNAM","string":"衛兵にグレロッドの逮捕を頼む (任意)","index":10},{"form_id":"0x000836|innocence lost - quest expansion.esp","type":"QUST NNAM","string":"グレロッドの逮捕を見届ける","index":20},{"form_id":"0x000836|innocence lost - quest expansion.esp","type":"QUST NNAM","string":"グレロッドのワインに毒を入れる (任意)","index":30},{"form_id":"0x000836|innocence lost - quest expansion.esp","type":"QUST NNAM","string":"グレロッドが毒入りのワインを飲むのを待つ","index":40},{"form_id":"0x000851|innocence lost - quest expansion.esp","type":"MESG FULL","string":"グレロッドのファイヤーブランドワイン"},{"form_id":"0x000895|innocence 
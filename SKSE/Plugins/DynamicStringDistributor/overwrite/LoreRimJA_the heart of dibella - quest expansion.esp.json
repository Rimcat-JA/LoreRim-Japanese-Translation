[{"form_id":"0x00082D|the heart of dibella - quest expansion.esp","type":"ARMO FULL","string":"フジョトラのローブ"},{"form_id":"0x00082E|the heart of dibella - quest expansion.esp","type":"ARMO FULL","string":"フジョトラのブーツ"},{"form_id":"0x000817|the heart of dibella - quest expansion.esp","type":"BOOK FULL","string":"マザー・ハマルからの手紙"},{"form_id":"0x000817|the heart of dibella - quest expansion.esp","type":"BOOK DESC","string":"<font face=\"$HandwrittenFont\">\r\n\r\nリーチ地方の従士殿、\r\n\r\nディベラ神殿の大神官として、内密にお話ししたいことがございます。\r\n\r\nあなたの武勇の噂はマルカルスの我々の神殿の壁さえも越えて届いており、我々は互いに助け合えると考えております。神殿を訪れ、セナ姉妹にお声をおかけください。彼女がお待ちしております。そしてどうか、この手紙を他人の目に触れさせないでください。あなたの分別に期待しております。\r\n\r\nディベラのご加護がありますように、\r\nハマル母"},{"form_id":"0x000839|the heart of dibella - quest expansion.esp","type":"BOOK FULL","string":"マザー・ハマルからの手紙"},{"form_id":"0x000839|the heart of dibella - quest expansion.esp","type":"BOOK DESC","string":"<font face=\"$HandwrittenFont\">\r\n\r\nリーチ地方の友よ、\r\n\r\nディベラ神殿の大神官として、あなたと内密に話をしたいと願っている。\r\n\r\nリーチ地方でのあなたの善行の噂は、マルカルスの我らが神殿の壁さえも越えて届いている。我々は互いに助け合えると信じている。我らの神殿を訪れ、シスター・セナに話しかけてほしい。彼女が待っている。そしてどうか、この手紙を詮索好きの目から遠ざけておいてくれ。あなたの分別に頼っている。\r\n\r\nディベラがあなたに幸あらんことを、\r\n母ハマル"},{"form_id":"0x000836|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"これはこれは、シドナ鉱山の友よ。よく来たな。","index":1},{"form_id":"0x000852|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"最初は少し怖かったけど、ここが好き。心が落ち着くの。","index":1},{"form_id":"0x00083E|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あら、こんにちは。何かご用？","index":1},{"form_id":"0x00083F|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ここで何をしてるの？ フォースウォーンが怖くないの？ ここは安全じゃないわ。","index":1},{"form_id":"0x00083A|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"もうしばらく経つわ。寂しいけど、あの人が戻らないのは明らかね。","index":1},{"form_id":"0x00083B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"夫が死んだの。あの人なしでは、何もかも元通りにはならないわ。","index":1},{"form_id":"0x00083C|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"家がとても空っぽで……静かなの。","index":1},{"form_id":"0x00083D|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"もうしばらく経つわね、うーん……今でもあの子が恋しいわ。","index":1},{"form_id":"0x000D62|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あら、なるほど。ふむ……分かりました。彼女と話してきます。","index":1},{"form_id":"0x000D62|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"でも、どうぞ座ってここで待っていて。すぐに戻りますから。","index":2},{"form_id":"0x000D62|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"ハマル母さんから手紙を受け取った"},{"form_id":"0x000800|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"悪いけど、関わりたくない。(クエスト失敗)"},{"form_id":"0x000801|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"何ですって！？ よくもそんなことを。出て行きなさい！","index":1},{"form_id":"0x000803|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"聞きたいことがある…"},{"form_id":"0x000804|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ええ、もちろん。何でも聞いてちょうだい。","index":1},{"form_id":"0x000805|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"今のところ質問は以上だ。"},{"form_id":"0x000806|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"よろしい。他には？","index":1},{"form_id":"0x000807|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"手を貸そう。彼女はどこにいるんだっけ?"},{"form_id":"0x000808|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"素晴らしい。私たちの幻視に現れた場所は、カースワステンだと考えているわ。","index":1},{"form_id":"0x000808|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"さあ、急いで。あの娘をできるだけ早く神殿へ連れてこなければならないの。","index":2},{"form_id":"0x000809|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"男だけ? なぜ?"},{"form_id":"0x00080B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"私……その……あなたの私事に立ち入るつもりはなかったの。それで、何かしら？","index":1},{"form_id":"0x00080B|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"男にしか効かない？なぜ？"},{"form_id":"0x00080C|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"私……その……あなたの私事に立ち入るつもりはなかったの。それで、何かしら？","index":1},{"form_id":"0x00080C|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"それで…それが目的じゃなかったら? "},{"form_id":"0x00080A|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"その祝福は役に立ちそうだ。"},{"form_id":"0x000814|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"もちろん……そうでなければ大した報酬とは言えないでしょう？","index":1},{"form_id":"0x00080D|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"ディベラには、女性が好きだと知っておいてほしい。"},{"form_id":"0x00080E|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ええ、女性を口説くのに役立つわ。それが目的ならね。","index":1},{"form_id":"0x00080F|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"もちろんよ。これからは男たちがより従順に……あるいはより無防備になるでしょう。","index":1},{"form_id":"0x00080F|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"ディベラなら、私が男性を好むと知っているはずだ。"},{"form_id":"0x000810|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"ディベラには、男性も女性も好きだと知っておいてほしい。"},{"form_id":"0x000811|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あら、そう？ あれやこれやを少しずつね。分かったわ。","index":1},{"form_id":"0x000812|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"やっぱり…今のは忘れてくれ。"},{"form_id":"0x000813|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いいわ……早く決めてちょうだい。","index":1},{"form_id":"0x000815|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いいわ……早く決めてちょうだい。","index":1},{"form_id":"0x000815|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"やっぱりいい。実は異性に興味があるんだ。"},{"form_id":"0x00081A|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"実は、どちらの性にも惹かれないんだ。"},{"form_id":"0x00081B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"何ですって？ ああ……あなたがそれを望むなら、ええ、構わないわ。","index":1},{"form_id":"0x00081E|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"シビルについて…"},{"form_id":"0x00081F|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ええ、もちろん。何かしら？","index":1},{"form_id":"0x000822|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"助けに来た。"},{"form_id":"0x000823|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"私を助けに来てくれたの？ どうして分かったの？ ここで死ぬんだと思ってた。ありがとう！","index":1},{"form_id":"0x000825|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"本当にいいのか? 大きな変化だぞ。"},{"form_id":"0x000826|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"もちろん！ 私のことは心配しないで。大丈夫だから。","index":1},{"form_id":"0x000826|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"この務めに選ばれて光栄です。","index":2},{"form_id":"0x000827|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"わかった。ついて来て。"},{"form_id":"0x00082A|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ありがとう。お願い、案内して。","index":1},{"form_id":"0x000828|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"お母さんのところへ連れて行くべきだと思う"},{"form_id":"0x000829|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"えっ？ 何の権利があってそんなことを？ いい、私はマルカルスの神殿に行かなきゃいけないの。お願い、案内して。","index":1},{"form_id":"0x000832|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"頼みたいことがある"},{"form_id":"0x000833|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"なるほど……ふむ、興味深いな。何だ？","index":1},{"form_id":"0x000834|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"ブロークンタワー要塞のお前の部下が娘をさらった。取り戻したい。"},{"form_id":"0x000835|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あの娘か？ ああ、お前には借りがある。いいだろう、何とかしてみよう。","index":1},{"form_id":"0x000835|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"さあ、気が変わらないうちにさっさと行け。","index":2},{"form_id":"0x000841|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"知らせがある…"},{"form_id":"0x000842|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いいわ。何かしら？","index":1},{"form_id":"0x000843|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"残念だが、旦那さんは亡くなった"},{"form_id":"0x000845|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"そんな！ ああ、神様！ エンモン、私……","index":1},{"form_id":"0x000845|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ふう。本当のことを話してくれてありがとう。","index":2},{"form_id":"0x000844|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"でも娘さんは聖堂で無事だよ。"},{"form_id":"0x000846|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"本当？ 私……ありがとう。気持ちが楽になったわ。","index":1},{"form_id":"0x000846|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"しばらく一人になりたいの。さようなら。","index":2},{"form_id":"0x000847|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"娘さんは聖堂で無事だよ。"},{"form_id":"0x000848|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"本当？ 私……ありがとう。気持ちが楽になったわ。","index":1},{"form_id":"0x000848|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"しばらく一人になりたいの。さようなら。","index":2},{"form_id":"0x00084A|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"娘さんに会いたいだろうと思って。"},{"form_id":"0x00084B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ええ、本当に。ごめんなさい、もう行って。","index":1},{"form_id":"0x00084C|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"わかった…今すぐマルカルスへ出発しよう。"},{"form_id":"0x00084D|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"よかった。私……あの子が神殿で幸せだといいけど。さようなら、愛しい子。","index":1},{"form_id":"0x00084E|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"シビルになることをどう思う？"},{"form_id":"0x00084F|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ここは……望んでいたもの全てです。","index":1},{"form_id":"0x000850|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"望むなら、フョトラはここに残ってもいい。"},{"form_id":"0x000851|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いや……お願い、無理よ。もう……もう行って。","index":1},{"form_id":"0x000854|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"よくもそんなことを！","index":1},{"form_id":"0x000855|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"何をしているの！？","index":1},{"form_id":"0x000856|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"そうはさせないわ！","index":1},{"form_id":"0x000859|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"ディベラの祝福はどう役に立つ?"},{"form_id":"0x00085A|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"これからは男たちがより従順に……あるいはより無防備になるでしょう。","index":1},{"form_id":"0x00085B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"女性を口説くのに役立つわ。それが目的ならね。","index":1},{"form_id":"0x00085C|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"こちらはフョートラ。彼女と一緒に奥の聖域に入ってもいい？"},{"form_id":"0x000D58|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"企みに巻き込まないでくれ。"},{"form_id":"0x000D65|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ディベラの神殿へようこそ、我が子よ。ふむ、そうね……あなたなら私たちを助けられるかもしれない。","index":1},{"form_id":"0x000D67|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"私たちの巫女が最近失われたの。つまり、亡くなったのよ。不幸なことだわ。","index":1},{"form_id":"0x000D67|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"次の巫女の幻視を得たの。北の村に住んでいるわ。彼女の瞑想を始めるために、神殿へ連れてこなければならないの。","index":2},{"form_id":"0x000820|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"私たちの巫女が最近失われたの。つまり、亡くなったのよ。不幸なことだわ。","index":1},{"form_id":"0x000820|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"次の巫女の幻視を得たの。北の村に住んでいるわ。彼女の瞑想を始めるために、神殿へ連れてこなければならないの。","index":2},{"form_id":"0x000820|the heart of dibella - quest expansion.esp","type":"INFO RNAM","string":"状況をもう一度説明してくれる？"},{"form_id":"0x000D69|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ディベラの巫女は、その生涯を女神との直接の交わりの中で過ごすの。","index":1},{"form_id":"0x000D69|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"幼い少女の頃から息を引き取る瞬間まで、彼女は天なる母と直接つながっているのよ。","index":2},{"form_id":"0x000D69|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"彼女の瞑想を通して、私たちは神の御心を知るの。","index":3},{"form_id":"0x000D6A|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"なぜこれがそんなに秘密なんだ？"},{"form_id":"0x000D6B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"悪いことが起きれば噂が広まり、人々は不安になる……","index":2},{"form_id":"0x000D6B|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"だから、新しい巫女を紹介できるまでは、巫女の死を公表したくないの。人々は私たちが女神とつながっていると知っていたいものだから。","index":1},{"form_id":"0x000D6D|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"家族にとっては大変な名誉とされているわ。娘は決して苦労を知らず、女神は一家に大いなる恵みを授けてくださるの。","index":1},{"form_id":"0x000D6E|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"彼女の居場所がどうして分かるんだ？"},{"form_id":"0x000D6F|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ディベラの巫女の儀典によって、私たちは次の巫女の住まいを見たの。北の、岩肌に寄り添う小さな村よ。","index":1},{"form_id":"0x000D70|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"このプロトコルとは具体的に何だ？"},{"form_id":"0x000D71|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ディベラの巫女の崇高なる儀典よ。私たちが女神を崇め、女神は私たちに賜物を授けてくださるの。","index":1},{"form_id":"0x000D72|the heart of dibella - quest expansion.esp","type":"DIAL FULL","string":"奥の聖域に入ってもいい?"},{"form_id":"0x000D73|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いいえ。入信していない者は奥の聖域に入れないの。ごめんなさいね。","index":1},{"form_id":"0x000821|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"いいえ。残念ながら、男性は奥の聖域に入れないの。ごめんなさいね。","index":1},{"form_id":"0x000D75|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あなたの噂は聞いているわ……その評判をね。もちろん、良い噂よ。","index":1},{"form_id":"0x000D77|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ねえ、あなたならディベラの祝福を授かることができるわ。これからは男たちがより従順に……あるいはより無防備になるでしょう。","index":1},{"form_id":"0x000D78|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"ディベラの祝福のことは聞いたことがある？ 女性を口説くのに役立つわ。それが目的ならね。","index":1},{"form_id":"0x000D78|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"あるいは、女性の機嫌を損ねてしまった時に力を与えてくれるわ。","index":2},{"form_id":"0x000D78|the heart of dibella - quest expansion.esp","type":"INFO NAM1","string":"普通は男性には授けないのだけど、巫女の護衛役なら例外にしてもいいわ。","index":3}]
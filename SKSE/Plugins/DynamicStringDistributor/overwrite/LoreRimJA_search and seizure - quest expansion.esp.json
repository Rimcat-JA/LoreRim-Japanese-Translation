[{"form_id":"0x0012C5|search and seizure - quest expansion.esp","type":"DIAL FULL","string":"オグマンドがタロス信仰を公言したんだ。"},{"form_id":"0x0012C6|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"ああ、これで決まりだ。これさえあればオグムンドを片付けるのに十分だ。","index":1},{"form_id":"0x0012C8|search and seizure - quest expansion.esp","type":"DIAL FULL","string":"オグマンドがタロスを信奉している証拠はなかった。"},{"form_id":"0x0012C9|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"俺が怒る前にここから出て行け。","index":4},{"form_id":"0x0012CF|search and seizure - quest expansion.esp","type":"DIAL FULL","string":"タルモールはタロス崇拝のことでお前を追っている。気をつけろ。"},{"form_id":"0x0012D0|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"へえ、本当？","index":1},{"form_id":"0x0012D0|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"私は人生をタロスに捧げてきた。今やめるつもりはない。","index":2},{"form_id":"0x0012D0|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"鼻持ちならないエルフに、どの神を崇拝していいか悪いか指図されたくはない。","index":3},{"form_id":"0x0012D0|search and seizure - quest expansion.esp","type":"INFO NAM1","string":"だが、これは私にしてくれた大きな貢献だ。そう簡単には忘れないぞ。","index":4}]
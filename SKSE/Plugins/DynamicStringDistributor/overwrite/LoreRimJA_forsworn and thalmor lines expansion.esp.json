[{"form_id":"0x000802|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ああ、まずい……","index":1},{"form_id":"0x000803|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"目の前から消えろ!","index":1},{"form_id":"0x00085A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"それが最後の過ちだ！","index":1},{"form_id":"0x00088D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚か者め！貴様に勝ち目などない！","index":1},{"form_id":"0x00088E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ、それで終わりか？情けない。","index":1},{"form_id":"0x00088F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かな犬め。","index":1},{"form_id":"0x00082C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"神々よ、まさか！","index":1},{"form_id":"0x00081B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"させるか! 引き裂いて……やる!","index":1},{"form_id":"0x00082D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"そんな！こ……殺してやる！","index":1},{"form_id":"0x00084D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"嘘だ、嘘だ！こんなことがあるはずがない！","index":1},{"form_id":"0x00085B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"神々にかけて、まさか！","index":1},{"form_id":"0x000863|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"何！？そんな！哀れな人間め、殺してやる！","index":1},{"form_id":"0x000890|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"何！？そんな！こ……殺してやる！","index":1},{"form_id":"0x000891|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"神々よ、まさか！お……覚えていろ！","index":1},{"form_id":"0x000805|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"やめろ!","index":1},{"form_id":"0x000807|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ぐあっ!","index":1},{"form_id":"0x00083C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"リーチの民のために血を流そう！","index":1},{"form_id":"0x000833|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"な、何だ……！？","index":1},{"form_id":"0x000840|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"今のは何だ！？","index":1},{"form_id":"0x00084E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"呪われろ！","index":1},{"form_id":"0x00085C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"き……貴様、ただでは済まさんぞ！","index":1},{"form_id":"0x00085E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"そんな……貴様……","index":1},{"form_id":"0x000875|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"よくも！","index":1},{"form_id":"0x000877|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"悪くない！では死ね！","index":1},{"form_id":"0x000876|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"それが『声』か？哀れな！","index":1},{"form_id":"0x000897|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ぐっ！その無礼の報いに、骨から肉を剥ぎ取ってやる。","index":1},{"form_id":"0x000898|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ、情けない。","index":1},{"form_id":"0x00085D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"一人殺せば、三人が代わりに立つ。フォースウォーンは止められない。","index":1},{"form_id":"0x000878|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"スカイリムは汚らわしい連中であふれている。早く故郷に帰りたいものだ。","index":1},{"form_id":"0x000809|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンは、正当に我らのものを取り戻す。","index":1},{"form_id":"0x00080A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"シルバーブラッド家は何にでも税をかける。だが、それも永遠には続かない。","index":1},{"form_id":"0x00081C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"今日もまた、どこかの集落が襲われる。リーチにフォースウォーンから安全な場所などない。ははは!","index":1},{"form_id":"0x00081D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ああ、くたくただ……","index":1},{"form_id":"0x000821|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"スカイリムの問題は私の問題ではない。リーチは再び我らのものになる。","index":1},{"form_id":"0x000822|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ふむ……","index":1},{"form_id":"0x000820|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"この戦争でスカイリムの商人どもは痛手を受けた。いい気味だ。","index":1},{"form_id":"0x00081F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"この地は厳しく、容赦がない。だが、美しくもある。","index":1},{"form_id":"0x00081E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"休みたくてたまらない。今すぐ横になったら、永遠に眠れそうだ。","index":1},{"form_id":"0x00082E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"楽な時代じゃない。だが今の我らは自らの道を自ら選んでいる。フォースウォーンに栄光あれ！","index":1},{"form_id":"0x000830|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"リーチは再び我らのものになる。覚えておけ！","index":1},{"form_id":"0x00082F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"（咳き込む）","index":1},{"form_id":"0x00083D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"戦争の次はドラゴンか。ノルドはどこへ行っても破滅しかもたらさない。","index":1},{"form_id":"0x00083E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンに栄光あれ!","index":1},{"form_id":"0x00083F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"リーチは再び我らのものになる!","index":1},{"form_id":"0x00084F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ここにはスカイリムのどこにもない美しさがある。間違いない。","index":1},{"form_id":"0x000850|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハハ！ノルドの頭蓋骨は最高の斧の刃になる。奴らの使い道なんてそれくらいだ……","index":1},{"form_id":"0x000853|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"妻はいい女だった。神々よ、あいつが恋しい。","index":1},{"form_id":"0x000851|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"……奴はハグレイヴンにブライアハートにしてもらうと決めたらしい……","index":1},{"form_id":"0x000854|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"シルバーブラッド家はリーチの半分を所有している。だがここは我らの土地だ。リーチはフォースウォーンのものだ！","index":1},{"form_id":"0x000852|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"うぐっ……","index":1},{"form_id":"0x00085F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我らはリーチの先住民……古き慣習に従う者……フォースウォーンよ永遠なれ！","index":1},{"form_id":"0x000860|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"兄弟が死んだ……あいつがいなければ、もう元には戻らない。","index":1},{"form_id":"0x00080C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"何かがおかしい……","index":1},{"form_id":"0x000857|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"侵入者は見つけ次第殺せ。","index":1},{"form_id":"0x000861|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"目と耳を研ぎ澄ませておけ。","index":1},{"form_id":"0x00080E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"同族の面汚しめ!","index":1},{"form_id":"0x00080F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ストームクロークに死を!","index":1},{"form_id":"0x000810|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"あの女を捕まえろ!","index":1},{"form_id":"0x000824|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"あいつを捕まえろ!","index":1},{"form_id":"0x000823|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"来い! フォースウォーンと戦え!","index":1},{"form_id":"0x000827|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"いいだろう、やる気か？フォースウォーンと戦ってみろ！","index":1},{"form_id":"0x000825|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"機会があるうちに去るべきだったな、友よ!","index":1},{"form_id":"0x000826|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"こいつは驚いた！ここで貴様の脳みそを道にぶちまけてやらなきゃならんな！","index":1},{"form_id":"0x000835|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"あの女はもらった！","index":1},{"form_id":"0x000844|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハハッ！気をつけろ、行くぞ！","index":1},{"form_id":"0x000843|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンに栄光あれ!","index":1},{"form_id":"0x000855|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"死にたいのか！？来い、フォースウォーンと戦ってみろ！","index":1},{"form_id":"0x000856|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"本気の戦いがお望みか？","index":1},{"form_id":"0x00087B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしいノルドめ！いずれ貴様らの種族は根絶やしにされる！","index":1},{"form_id":"0x00087D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"誰かが痛い目を見ることになる……貴様だ！","index":1},{"form_id":"0x00087F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"誰かが痛い目を見ることになる……貴様だ！愚かなオークめ！","index":1},{"form_id":"0x000880|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなダンマーめ。木箱に詰めてヴァーデンフェルへ送り返してやる。","index":1},{"form_id":"0x000881|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなカジートめ。貴様をブーツに仕立ててやる！","index":1},{"form_id":"0x000882|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かな裏切り者め。貴様はアルトマーの恥さらしだ。","index":1},{"form_id":"0x00087E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"エルフの面汚しめ！","index":1},{"form_id":"0x00089A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"弓使いか？楽勝だ。","index":1},{"form_id":"0x00087C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"さっさと片付けるぞ！","index":1},{"form_id":"0x00089B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"おぞましい蛮族め！","index":1},{"form_id":"0x00089F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様はアルトマーの恥さらしだ。恥を知らんのか！？","index":1},{"form_id":"0x00089C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしい蛮族め！","index":1},{"form_id":"0x00089D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしい獣め！","index":1},{"form_id":"0x00089E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚か者め！貴様に勝ち目などない！","index":1},{"form_id":"0x000812|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"かかれ! あいつは大したことないぞ!","index":1},{"form_id":"0x000815|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"かかれ! あの女は大したことないぞ!","index":1},{"form_id":"0x000813|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンに栄光あれ!","index":1},{"form_id":"0x000814|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"リーチは再び我らのものになる!","index":1},{"form_id":"0x000829|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様らの居場所などここにはない！","index":1},{"form_id":"0x000828|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"もう威勢はなくなったか？","index":1},{"form_id":"0x000883|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様をブーツに仕立ててやる！","index":1},{"form_id":"0x000884|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなカジートめ。貴様がいるだけで反吐が出る。","index":1},{"form_id":"0x000886|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様はアルトマーの恥さらしだ！","index":1},{"form_id":"0x000885|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなオークめ。","index":1},{"form_id":"0x0008A0|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"来い！骨から肉を剥ぎ取ってやる。","index":1},{"form_id":"0x0008A1|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"私がこれまで何人殺してきたか知っているか？今こそ己の過ちの愚かさを思い知るがいい。","index":1},{"form_id":"0x0008A2|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしいカジートめ。貴様をブーツに仕立ててやる！","index":1},{"form_id":"0x0008A3|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしいノルドめ。いずれ貴様らは皆奴隷になる。","index":1},{"form_id":"0x0008A4|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様をブーツに仕立ててやる！","index":1},{"form_id":"0x000817|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"また一人犠牲者か。はっ……","index":1},{"form_id":"0x000819|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"しゃきっとしろよ……ははは。","index":1},{"form_id":"0x000818|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"まったく、なんて有様だ。","index":1},{"form_id":"0x00081A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"時間を無駄にしてくれてどうも。","index":1},{"form_id":"0x000862|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンに栄光あれ!","index":1},{"form_id":"0x00082B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"リーチは再び我らのものになる!","index":1},{"form_id":"0x000848|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我らこそマルカルスの正当な支配者だ！","index":1},{"form_id":"0x000846|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"古き神々にかけて……すごかったな！","index":1},{"form_id":"0x000847|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"危ないところだった！","index":1},{"form_id":"0x000849|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンに栄光あれ。","index":1},{"form_id":"0x0008B8|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハハ！ノルドの頭蓋骨は最高の斧の刃になる。奴らの使い道なんてそれくらいだ……","index":1},{"form_id":"0x000858|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"なんと哀れな。","index":1},{"form_id":"0x000866|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ふん。死んでもほとんど役に立たんな。","index":1},{"form_id":"0x000868|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"もっと時間をかけるべきだったな。あの男にはもっとゆっくりした死がふさわしかった。","index":1},{"form_id":"0x000869|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"もっと時間をかけるべきだったな。あの女にはもっとゆっくりした死がふさわしかった。","index":1},{"form_id":"0x000867|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ。手応えのある奴はいないのか？","index":1},{"form_id":"0x00086A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"情けない。","index":1},{"form_id":"0x00086B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"楽勝だ。","index":1},{"form_id":"0x0008B0|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"それで終わりか？ハッ！楽勝だな。","index":1},{"form_id":"0x0008AB|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしいノルドめ。いずれ貴様らは皆奴隷になる。","index":1},{"form_id":"0x0008B6|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ！いずれ貴様らは皆奴隷になる。","index":1},{"form_id":"0x0008B2|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"エルフの面汚しめ。","index":1},{"form_id":"0x0008AE|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我らの脅しが口先だけだと本気で思ったのか？ハッ！愚か者め……","index":1},{"form_id":"0x0008B7|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ！すぐに死んでしまうな。次は手加減してみるか。もっと逃げ回る的になってもらわんと。いい練習になる！","index":1},{"form_id":"0x0008B1|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"悪く思うな。","index":1},{"form_id":"0x0008AC|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我らの邪魔をして、ただで済むと本気で思ったのか！？","index":1},{"form_id":"0x0008B5|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ふん。情けない。","index":1},{"form_id":"0x0008B4|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ふん。手応えのある奴はいないのか！？","index":1},{"form_id":"0x0008B3|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"見ろ。ハッ！コレクションにまた一つ死体が増えた。","index":1},{"form_id":"0x0008AD|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ！実に楽しかったぞ。","index":1},{"form_id":"0x0008AF|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハッ！炎が骨から肉を焼き払うがごとく、この地から異端を一掃してやる。","index":1},{"form_id":"0x000832|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"まだ死にたくない。頼む……慈悲を！","index":1},{"form_id":"0x000837|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"古き神々よ、力を！","index":1},{"form_id":"0x00084A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"死ぬ時が来たぞ、犬め！","index":1},{"form_id":"0x00084B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"もう威勢はなくなったか？","index":1},{"form_id":"0x000864|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我が力を見よ！","index":1},{"form_id":"0x000865|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"元素の力は我が意のままだ！","index":1},{"form_id":"0x000889|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ああ、焼けた肉の甘い香り。これに勝るものはないな。","index":1},{"form_id":"0x000887|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"死ね、汚らわしい裏切り者め！","index":1},{"form_id":"0x000888|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"ハハハハハ！哀れな人間め！","index":1},{"form_id":"0x00088B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなカジートめ！","index":1},{"form_id":"0x00088C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなオークめ！","index":1},{"form_id":"0x00088A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"死ね、愚か者！","index":1},{"form_id":"0x000839|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"同胞のために死ぬ……","index":1},{"form_id":"0x00084C|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"（咳き込む）","index":1},{"form_id":"0x00083B|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"古き神々の加護を。","index":1},{"form_id":"0x000873|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"見ろ……タロスのアミュレットなど身につけて。人間を崇拝するなど不道徳だ。しかも違法でもある。よって貴様は異端者として死ぬのだ。","index":1},{"form_id":"0x000874|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"その武器を収めろ。さもなくば我が怒りの全てを味わうことになるぞ。","index":1},{"form_id":"0x000896|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我々にはしかるべき敬意を払うことだ。貴様のような者にそれができるならな。","index":1},{"form_id":"0x00086D|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"沼へ帰れ、アルゴニアン。","index":1},{"form_id":"0x00086E|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様を生んだ穴ぐらへ這い戻れ、オーク。","index":1},{"form_id":"0x000870|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなカジートめ。貴様がいるだけで反吐が出る。","index":1},{"form_id":"0x000871|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"愚かなダンマーめ。貴様がいるだけで反吐が出る。","index":1},{"form_id":"0x000872|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"汚らわしいノルドめ。貴様がいるだけで反吐が出る。","index":1},{"form_id":"0x000894|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"そこをどけ。","index":1},{"form_id":"0x000892|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"沼へ帰れ、アルゴニアン。","index":1},{"form_id":"0x000893|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"下賤の者に構っている暇など今はない。去れ。","index":1},{"form_id":"0x00086F|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"さあ、私の前から失せろ。","index":1},{"form_id":"0x000895|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"行け。そのくだらぬ営みに戻るがいい。","index":1},{"form_id":"0x00087A|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"奴はこの辺りにいるはずだ……","index":1},{"form_id":"0x000899|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"奴はどこだ！？","index":1},{"form_id":"0x0008A6|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"私が愚か者に寛容な者に見えるか？失せろ！","index":1},{"form_id":"0x0008A7|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"これはサルモールの問題だ。貴様には関係ない。","index":1},{"form_id":"0x0008A8|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"我らの問題に首を突っ込めば、速やかで苦痛に満ちた最期を迎えることになるぞ。","index":1},{"form_id":"0x0008A9|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"貴様はサルモールの公務を妨害している。身の安全が惜しければ、直ちに立ち去れ。","index":1},{"form_id":"0x0008AA|forsworn and thalmor lines expansion.esp","type":"INFO NAM1","string":"失せろ……私の忍耐が尽きる前にな。","index":1},{"form_id":"0x000800|forsworn and thalmor lines expansion.esp","type":"QUST FULL","string":"フォースウォーンとサルモールのセリフ拡張"}]
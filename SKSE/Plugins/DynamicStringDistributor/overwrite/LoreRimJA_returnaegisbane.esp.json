[{"form_id":"0x000802|returnaegisbane.esp","type":"DIAL FULL","string":"あなたの家に伝わるウォーハンマーについて…"},{"form_id":"0x000803|returnaegisbane.esp","type":"INFO NAM1","string":"何だ?","index":1},{"form_id":"0x000804|returnaegisbane.esp","type":"DIAL FULL","string":"見つけた…でも、失くしてしまった。"},{"form_id":"0x000806|returnaegisbane.esp","type":"INFO NAM1","string":"どうやったんだ?","index":1},{"form_id":"0x000806|returnaegisbane.esp","type":"INFO NAM1","string":"頼む、放っておいてくれ。一人になりたいんだ。","index":2},{"form_id":"0x000809|returnaegisbane.esp","type":"DIAL FULL","string":"売った"},{"form_id":"0x000D65|returnaegisbane.esp","type":"DIAL FULL","string":"家宝のウォーハンマーを失くしたそうだね。"},{"form_id":"0x000D66|returnaegisbane.esp","type":"INFO NAM1","string":"ああ、そうだな。","index":1},{"form_id":"0x000D66|returnaegisbane.esp","type":"INFO NAM1","string":"人生、何事も当たり前だと思うな。永遠に続くものなど何もない。","index":2},{"form_id":"0x000D67|returnaegisbane.esp","type":"DIAL FULL","string":"ほら、全部あなたのものだ。(イージスベインを渡す)"},{"form_id":"0x000D68|returnaegisbane.esp","type":"INFO NAM1","string":"本当か? 見事だ。ほら、これを受け取ってくれ。礼のしるしだ。","index":1},{"form_id":"0x000D68|returnaegisbane.esp","type":"INFO NAM1","string":"今日一番の幸運だな。","index":2},{"form_id":"0x000D69|returnaegisbane.esp","type":"DIAL FULL","string":"イージスベインを見つけた。"},{"form_id":"0x000D6A|returnaegisbane.esp","type":"INFO NAM1","string":"なんてことだ……何と言っていいか分からない。","index":1},{"form_id":"0x000D6B|returnaegisbane.esp","type":"DIAL FULL","string":"自分のものにする"},{"form_id":"0x000D6C|returnaegisbane.esp","type":"INFO NAM1","string":"馬鹿げている。無礼な……侮辱だ! あちこちから追い立てられるのはもううんざりだ!","index":1},{"form_id":"0x000D6C|returnaegisbane.esp","type":"INFO NAM1","string":"お前のような奴にこんなことを言われる筋合いはない。","index":2},{"form_id":"0x000D6D|returnaegisbane.esp","type":"DIAL FULL","string":"奪えるものなら奪ってみろ。"},{"form_id":"0x000D6E|returnaegisbane.esp","type":"INFO NAM1","string":"神々は施しをする者に微笑むものだ。覚えておくといい。","index":1},{"form_id":"0x000D6E|returnaegisbane.esp","type":"INFO NAM1","string":"神々の罰が下ればいい。","index":2},{"form_id":"0x000D6F|returnaegisbane.esp","type":"DIAL FULL","string":"冗談だよ、全部あなたのものだ。(イージスベインを渡す)"},{"form_id":"0x000D72|returnaegisbane.esp","type":"INFO NAM1","string":"からかうんじゃないぞ。よこせ。","index":1},{"form_id":"0x000D72|returnaegisbane.esp","type":"INFO NAM1","string":"なあ……お前、そう悪い奴じゃないな。ほら。これを受け取れ……","index":2},{"form_id":"0x000D74|returnaegisbane.esp","type":"INFO NAM1","string":"はいはい……","index":1},{"form_id":"0x000D75|returnaegisbane.esp","type":"DIAL FULL","string":"500ゴールドで譲るよ。"},{"form_id":"0x000D76|returnaegisbane.esp","type":"INFO NAM1","string":"金があれば大抵のことは解決する、そうだろう?","index":1},{"form_id":"0x000D76|returnaegisbane.esp","type":"INFO NAM1","string":"ああ。どうでもいい。","index":2},{"form_id":"0x000800|returnaegisbane.esp","type":"QUST FULL","string":"イージスベインの返還"},{"form_id":"0x000800|returnaegisbane.esp","type":"QUST CNAM","string":"イージスベインを取り戻す","index":10},{"form_id":"0x000800|returnaegisbane.esp","type":"QUST CNAM","string":"イージスベインを返すか、手元に残す","index":20},{"form_id":"0x000800|returnaegisbane.esp","type":"QUST NNAM","string":"シャッター・シールド家のウォーハンマーを取り戻す","index":10},{"form_id":"0x000800|returnaegisbane.esp","type":"QUST NNAM","string":"イージスベインについてトルビョルン・シャッターシールドと話す","index":20},{"form_id":"0x000D62|returnaegisbane.esp","type":"QUST CNAM","string":"グッドエンド","index":10},{"form_id":"0x000D62|returnaegisbane.esp","type":"QUST CNAM","string":"バッドエンド","index":20}]
[{"form_id":"0x000802|silusjournal_dialogue.esp","type":"INFO NAM1","string":"何の話か分からないな。","index":1},{"form_id":"0x000805|silusjournal_dialogue.esp","type":"INFO NAM1","string":"わかった、わかった。そこまで言うなら乗ろう。","index":1},{"form_id":"0x000809|silusjournal_dialogue.esp","type":"INFO NAM1","string":"君には関係のないことだ。二度とその話はしないでもらえるとありがたい。","index":1},{"form_id":"0x00080A|silusjournal_dialogue.esp","type":"DIAL FULL","string":"鍵を渡せ、さもなくば死体から奪う。(威圧)"},{"form_id":"0x00080B|silusjournal_dialogue.esp","type":"INFO NAM1","string":"わかった、わかった。早まった真似はやめてくれ。","index":1},{"form_id":"0x00080C|silusjournal_dialogue.esp","type":"INFO NAM1","string":"それはどうかな。","index":1},{"form_id":"0x00080D|silusjournal_dialogue.esp","type":"DIAL FULL","string":"代金は払うつもりだ。"},{"form_id":"0x00080E|silusjournal_dialogue.esp","type":"INFO NAM1","string":"私はそういうやり方はしない。だから忘れてくれ。","index":1},{"form_id":"0x000D75|silusjournal_dialogue.esp","type":"DIAL FULL","string":"これは間違っている。博物館を閉めるべきだ。"},{"form_id":"0x000D76|silusjournal_dialogue.esp","type":"INFO NAM1","string":"そこまでする必要はないだろう！","index":1},{"form_id":"0x000D76|silusjournal_dialogue.esp","type":"INFO NAM1","string":"私の家族は深遠の暁の一員だった。この博物館は我々の遺産なんだ。","index":2},{"form_id":"0x000D76|silusjournal_dialogue.esp","type":"INFO NAM1","string":"今こそ我々の時代だ。","index":3},{"form_id":"0x000D77|silusjournal_dialogue.esp","type":"DIAL FULL","string":"深淵の暁は邪悪だった。こんなことから良いことは生まれない。(説得)"},{"form_id":"0x000D78|silusjournal_dialogue.esp","type":"INFO NAM1","string":"なぜ隠れなければならない？ これは私の一族の遺産なんだぞ！","index":1},{"form_id":"0x000D78|silusjournal_dialogue.esp","type":"INFO NAM1","string":"話は終わりのようだな。","index":2},{"form_id":"0x000D78|silusjournal_dialogue.esp","type":"INFO NAM1","string":"他の奴に構ってくれ。","index":3},{"form_id":"0x000D79|silusjournal_dialogue.esp","type":"DIAL FULL","string":"博物館を閉めろ。さもなくば今ここで死ね。（威圧）"},{"form_id":"0x000D7A|silusjournal_dialogue.esp","type":"INFO NAM1","string":"いいだろう。黙って死ぬつもりはないぞ！","index":1}]
[{"form_id":"0x000836|caught red handed - quest expansion.esp","type":"MGEF FULL","string":"熟練の恋人の安らぎ"},{"form_id":"0x000834|caught red handed - quest expansion.esp","type":"SPEL FULL","string":"熟練の恋人の安らぎ"},{"form_id":"0x000834|caught red handed - quest expansion.esp","type":"SPEL DESC","string":"<8>時間、すべてのスキルの上昇速度が<20>%速くなる。"},{"form_id":"0x00082F|caught red handed - quest expansion.esp","type":"ARMO FULL","string":"ディベラの技の首飾り"},{"form_id":"0x000804|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"客に好き勝手させちゃだめだ。言い返すんだ。(説得)"},{"form_id":"0x000805|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"私……あなたの言う通りね。ノルドの女は、その気になればできないことはないって言うもの。","index":1},{"form_id":"0x000805|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あんな口の利き方をしたこと、みんなに思い知らせてやるわ。ありがとう。はい、これをあげる。","index":2},{"form_id":"0x000806|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"私……わ、私……ただ、これは……ごめんなさい、でも本当に無理なの。","index":1},{"form_id":"0x000807|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"代わりに彼らと「話」をつけてやろうか…"},{"form_id":"0x000808|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"やってくれるの？ じゃあ……タ、タイシスよ。あいつ……あいつは最低なの！ 痛い目に遭わせて、でもやりすぎないでね。殺しはなしよ、いい？","index":1},{"form_id":"0x000809|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"わかった。その話を持ち出してすまない。"},{"form_id":"0x00080A|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"気にしないで。","index":1},{"form_id":"0x00080C|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"もうティシスに悩まされることはないよ。"},{"form_id":"0x00080D|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"ありがとう。あのろくでなしには当然の報いよ。","index":1},{"form_id":"0x00080D|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"はい、これをあげる。","index":2},{"form_id":"0x00080D|caught red handed - quest expansion.esp","type":"INFO RNAM","string":"タイシスを懲らしめてやった。もう迷惑はかけてこないだろう。"},{"form_id":"0x00084A|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"本当？ ありがとう。はい、これをあげる。本当に助かったわ。","index":1},{"form_id":"0x00084A|caught red handed - quest expansion.esp","type":"INFO RNAM","string":"タイティスと少し話をつけた。もう迷惑をかけることはない"},{"form_id":"0x00080F|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"スヴァナへの口のきき方を聞いた。やめろ。さもないと (威圧)"},{"form_id":"0x000810|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"分かった、なんとかする。だから頼む、放っておいてくれ！","index":1},{"form_id":"0x000811|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"そもそもマーラの名にかけて、お前は一体何者なんだ？ ん？ わざわざ来て、人のことに口を出しやがって。","index":1},{"form_id":"0x000812|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"自業自得だ。思い知らせてやる(殴り合い)"},{"form_id":"0x000815|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"スヴァナに手を出すな、わかったか?"},{"form_id":"0x000816|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"分かった、なんとかする、だから頼む、放っておいてくれ！","index":1},{"form_id":"0x000818|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"あなたのディベラの技について噂が広まっている。知らせておこうと思って。"},{"form_id":"0x000819|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あら、あの話を聞いたの？ そう、知らせてくれてありがとう。","index":1},{"form_id":"0x000819|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"私がリフテンでディベラの技を実践してるなんて噂が広まったら、町から追い出されちゃうわ。","index":2},{"form_id":"0x000819|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"ねえ、スカイリムの善良な人たちって、ほんのひとときの楽しみさえ自分に許さないのよ。残念なことよね？","index":3},{"form_id":"0x00081A|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"秘密は守るよ。ただ、もう少し慎重にしてくれ。"},{"form_id":"0x00081B|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。感謝するわ。それで……他に何か？","index":1},{"form_id":"0x00081C|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"それって…? い、いや… あの… あ、あなた… ちがう! 話はそれだけ! じゃあ元気でね! さよなら!"},{"form_id":"0x00081D|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あはは！ いいわ。さあ、ささやかなお礼の印を受け取って。また会いましょう、色男さん。","index":1},{"form_id":"0x00081E|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あはは！ いいわ。さあ、ささやかなお礼の印を受け取って。また会いましょう、かわいい子。","index":1},{"form_id":"0x00081F|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"あなたの「ディベラの技」についてもっと知りたいな。(説得)"},{"form_id":"0x000820|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あら、ぜひお願い！ あなたって素敵な人ね。素敵どころじゃないわ。お役に立てると思うの。","index":1},{"form_id":"0x000820|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"それじゃ、私のベッドには十分な広さがあるの。そこで会いましょう、色男さん。","index":2},{"form_id":"0x000821|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あら、ぜひお願い！ あなたって素敵な人ね。素敵どころじゃないわ。お役に立てると思うの。","index":1},{"form_id":"0x000821|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"それじゃ、私のベッドには十分な広さがあるの。そこで会いましょう、かわいい子。","index":2},{"form_id":"0x000822|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あはは！ だめ。それはできないわ、ごめんなさいね。","index":1},{"form_id":"0x000822|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"ねえ、そんなに怒って帰らないで。ささやかなお礼の印を受け取って。","index":2},{"form_id":"0x000822|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"また会いましょう、色男さん。","index":3},{"form_id":"0x000823|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あはは！ だめ。それはできないわ、ごめんなさいね。","index":1},{"form_id":"0x000823|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"ねえ、そんなに怒って帰らないで。ささやかなお礼の印を受け取って。","index":2},{"form_id":"0x000823|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"また会いましょう、かわいい子。","index":3},{"form_id":"0x000825|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"なんと…言葉にできない。すごい。"},{"form_id":"0x000826|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"気持ちよかったわ。ささやかなお礼の印を受け取って。またどこかで会えるといいわね。楽しかったわ。","index":1},{"form_id":"0x000828|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"この前は最高だった。次の勝負も準備できてるよ。"},{"form_id":"0x000829|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。私がそれ以下だと思った？","index":1},{"form_id":"0x00082A|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。その欲求を満たしてあげましょうか、ね？","index":1},{"form_id":"0x00082B|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。私の魅力に抗える人なんてそういないわ。さあ、始めましょう。","index":1},{"form_id":"0x00082C|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。完璧には献身が必要だものね。","index":1},{"form_id":"0x00082D|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"もちろん。与えて、与えて、与え続けるの。私がいつだって準備万端以上なのは知ってるでしょ。","index":1},{"form_id":"0x000832|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"この…サファイアがあるんだ。これでネックレスを作れるか？"},{"form_id":"0x000833|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"はは！ ヘルガの奴、手がつけられないな。ほら、店のおごりだ。","index":1},{"form_id":"0x00083C|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"その通りだ。余計なお世話だった。すまない。(クエスト失敗)"},{"form_id":"0x000844|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"おお！ 見ろよ、あれ！ 見ものだぜ！ おいスヴァナ、客を喉の渇いたままにしとくなよ、はは！","index":1},{"form_id":"0x000845|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"おやおや！ 俺みたいな男には朝飯前だ。おいスヴァナ！ 俺は口が堅いうえに機転も利くんだぜ。会いに来いよ、な？ 応えてやれると思うぜ。","index":1},{"form_id":"0x000846|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"あの腰つきを見ろよ！ たまらんね！ おいスヴァナ！ 昔はもっと小さかったよな、はは！","index":1},{"form_id":"0x000849|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"なあ、スヴァナ……ダークエルフが好きなんだってな。本物のダークエルフがどんなことをしてやれるか、教えてやろうか。","index":1},{"form_id":"0x000848|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"頼む、怒ってまた痛めつけないでくれ！","index":1},{"form_id":"0x000D62|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"楽しませてあげなよ。何も悪くない。ごく普通のことだよ。"},{"form_id":"0x000800|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"ふーん。そうでしょうね。いいわ。今のは……忘れて。","index":1},{"form_id":"0x000D63|caught red handed - quest expansion.esp","type":"DIAL FULL","string":"正直…これは全部こっちには関係ないことだ。"},{"form_id":"0x000801|caught red handed - quest expansion.esp","type":"INFO NAM1","string":"いいわ。今のは忘れて。","index":1},{"form_id":"0x000802|caught red handed - quest expansion.esp","type":"QUST FULL","string":"強きノルドの女"},{"form_id":"0x000802|caught red handed - quest expansion.esp","type":"QUST NNAM","string":"ティシスと話す","index":20},{"form_id":"0x000802|caught red handed - quest expansion.esp","type":"QUST NNAM","string":"タイシスとの殴り合いに勝つ","index":30},{"form_id":"0x000802|caught red handed - quest expansion.esp","type":"QUST NNAM","string":"タイシスを脅す","index":40}]
[{"form_id":"0x0E006B|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"ラグナ"},{"form_id":"0x0E006C|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"フォルケ"},{"form_id":"0x113061|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"巡礼者"},{"form_id":"0x113062|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"巡礼者"},{"form_id":"0x03868C|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"エスキル"},{"form_id":"0x0A2EA1|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"ガラ"},{"form_id":"0x0E0069|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"ヘルレイフ・ノットベアード"},{"form_id":"0x12239A|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"ブランド"},{"form_id":"0x12239C|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"フリッグ"},{"form_id":"0x12239E|the great village of kynesgrove.esp","type":"NPC_ FULL","string":"クヌートおじさん"},{"form_id":"0x16436D|the great village of kynesgrove.esp","type":"KEYM FULL","string":"巡礼者の家の鍵"},{"form_id":"0x16436C|the great village of kynesgrove.esp","type":"KEYM FULL","string":"ロッギの家の鍵"},{"form_id":"0x16436E|the great village of kynesgrove.esp","type":"KEYM FULL","string":"ガラの家の鍵"},{"form_id":"0x164370|the great village of kynesgrove.esp","type":"KEYM FULL","string":"カインズビーの鍵"},{"form_id":"0x16436F|the great village of kynesgrove.esp","type":"KEYM FULL","string":"ヘルレイフとラグナの家の鍵"},{"form_id":"0x0DFF5C|the great village of kynesgrove.esp","type":"CELL FULL","string":"カインスビー"},{"form_id":"0x0845D4|the great village of kynesgrove.esp","type":"CELL FULL","string":"ヘルレイフとラグナの農場"},{"form_id":"0x033491|the great village of kynesgrove.esp","type":"CELL FULL","string":"ガラの家"},{"form_id":"0x0E5251|the great village of kynesgrove.esp","type":"CELL FULL","string":"カイネの間"},{"form_id":"0x0EF5F4|the great village of kynesgrove.esp","type":"CELL FULL","string":"ロギの家"},{"form_id":"0x02E2AB|the great village of kynesgrove.esp","type":"CELL FULL","string":"巡礼者の家"},{"form_id":"0x15A14A|the great village of kynesgrove.esp","type":"REFR FULL","string":"ガラの家"},{"form_id":"0x042896|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ、あなたは巡礼者ですね。","index":1},{"form_id":"0x042897|the great village of kynesgrove.esp","type":"INFO NAM1","string":"嵐に怯えなどしない。私は女神の力に酔いしれている。","index":1},{"form_id":"0x042898|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この森に来てくれることを願っているぞ？","index":1},{"form_id":"0x042899|the great village of kynesgrove.esp","type":"INFO NAM1","string":"つい先週、マンモスを狩ったばかりだ。","index":1},{"form_id":"0x04289A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"宿屋「ブレイドウッド」には飲み物がたっぷりあるぞ、旅の人。","index":1},{"form_id":"0x04289B|the great village of kynesgrove.esp","type":"INFO NAM1","string":"クジェルドのことは気にするな。あれは牛乳飲みだ。","index":1},{"form_id":"0x04289C|the great village of kynesgrove.esp","type":"INFO NAM1","string":"故郷からずいぶん遠くへ来たものだな、アルゴニアン。","index":1},{"form_id":"0x04289D|the great village of kynesgrove.esp","type":"INFO NAM1","string":"カジートがスカイリムに来ることは滅多にない。","index":1},{"form_id":"0x15A143|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この林は私によく合っている。心が静まる。悩みを忘れさせてくれる。","index":1},{"form_id":"0x15A144|the great village of kynesgrove.esp","type":"INFO NAM1","string":"今すぐハチミツ酒の樽が欲しいところだ。","index":1},{"form_id":"0x15A145|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この森に起きたことは、まったく不名誉なことだ。","index":1},{"form_id":"0x15A146|the great village of kynesgrove.esp","type":"INFO NAM1","string":"西部の領地は我々に不名誉をもたらす。己の神々を忘れるとは！ふん。","index":1},{"form_id":"0x15A147|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ごめん？ 考え事をしていた。","index":1},{"form_id":"0x15A148|the great village of kynesgrove.esp","type":"INFO NAM1","string":"え？ 何か言った？","index":1},{"form_id":"0x182997|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ようこそ、旅の人。この森を見に来たんだろう。","index":1},{"form_id":"0x182998|the great village of kynesgrove.esp","type":"INFO NAM1","string":"確かにスカイリムでの農作業は難しいかもしれないが、それだけにやりがいがあるというものだ。","index":1},{"form_id":"0x182999|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ここは古くからある神聖な場所だ、旅人よ。","index":1},{"form_id":"0x18299A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"宿泊先が必要なら、宿屋「ブレイドウッド」に温かいベッドとたっぷりのハチミツ酒があるぞ。","index":1},{"form_id":"0x18299B|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ、労働者たちが戦争へ行ってからというもの、この農場は大変でな。","index":1},{"form_id":"0x18299C|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ヒェルドは自分がカインズグローブを所有していると思っているかもしれないが、エスキルは何年もこの森を世話してきた","index":1},{"form_id":"0x1DDBFA|the great village of kynesgrove.esp","type":"INFO NAM1","string":"よくもまあ、カイネスグローブに製材所を建てることを許したものだ。","index":1},{"form_id":"0x1DDBFB|the great village of kynesgrove.esp","type":"INFO NAM1","string":"カイネの広間は思っていたよりずっと大きいな。","index":1},{"form_id":"0x1DDBFC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"エスキルは色々なことを教えてくれる。鹿の皮がそんなに多くの用途に使えるなんて知らなかったよ。","index":1},{"form_id":"0x1DDBFD|the great village of kynesgrove.esp","type":"INFO NAM1","string":"いつか一人でマンモスを倒せるようになりたいものだ。","index":1},{"form_id":"0x1DDBFE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"狩りには、私を生きていると感じさせる何かがある。","index":1},{"form_id":"0x1DDBFF|the great village of kynesgrove.esp","type":"INFO NAM1","string":"あの二人の帝国人が我らの神聖な木を切り倒したと聞いて、悲しくなる。","index":1},{"form_id":"0x0479A2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ、空高く舞う祝福されし鷹、カイネよ。彼女は嵐を司る我らが愛しき女神であり、戦士にしてショールの妻、そして寡婦であり、すべての人間と獣の母なのだ。","index":1},{"form_id":"0x0479A2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"作物を育てる雨を運ぶのは彼女の風であり、人間に嵐の声を授けたのも彼女なのだ。","index":2},{"form_id":"0x0479A2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"彼女は我々の神々の中で最も崇拝されている。帝国人はキナレスとして知っている。","index":3},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"多くの者は、カインズグローブは静かで退屈な場所だと言うだろう。","index":1},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"小さな鉱山の集落で、毎晩人々がブレイドウッドの宿に集まって酒で悲しみを流している。","index":2},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"しかし私にとっては、ここはスカイリムで最も美しい場所だ。この古く神聖な地は、我らが女神カイネに捧げられている。","index":3},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この聖域では、静けさと安らぎを求めて訪れる者もいれば、穏やかな天候を願う者、戦での力を祈る戦士もいる。","index":4},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"でも私は？ 私は耳を傾けに来たの。女神の囁きにじっくりと耳を傾けるために。","index":5},{"form_id":"0x04CAA6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"彼女が話すと葉が彼女の調べに合わせて舞い、池は轟く海と化す。","index":6},{"form_id":"0x051BA9|the great village of kynesgrove.esp","type":"DIAL FULL","string":"他のノルドの神々について教えてくれ。"},{"form_id":"0x051BAA|the great village of kynesgrove.esp","type":"INFO NAM1","string":"いいですよ。何を知りたいんです？","index":1},{"form_id":"0x051BAB|the great village of kynesgrove.esp","type":"DIAL FULL","string":"ショルについて教えてくれ。"},{"form_id":"0x051BAC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ショールは神々の王でした。彼の勇気の間、ソブンガルデこそ、多くの戦士が求める場所なのです。","index":1},{"form_id":"0x051BAC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"彼は冥界の神とも呼ばれている。古の時代、エルフとの戦争で人類を導いたのだ。","index":2},{"form_id":"0x051BAC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"やがてエルフの神々が彼を殺した。多くの者にロルカーンの名で知られている。","index":3},{"form_id":"0x051BAD|the great village of kynesgrove.esp","type":"DIAL FULL","string":"イスミルについて教えてくれ"},{"form_id":"0x051BAE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"イスミールは北のドラゴン。人類の英雄神だ。ウルフハースや強きタロスなど、多くの者がその名を担っている。","index":1},{"form_id":"0x051BAE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"タロスは帝国の創始者であり、神へと昇華した偉大な戦士だ。","index":2},{"form_id":"0x051BAE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"そしてご存じの通り、彼の信仰はエルフによって禁じられている。","index":3},{"form_id":"0x051BAF|the great village of kynesgrove.esp","type":"DIAL FULL","string":"アルドゥインについて何を知っている？"},{"form_id":"0x051BB0|the great village of kynesgrove.esp","type":"INFO NAM1","string":"アルドゥインは世界を喰らう者。終末の導き手であり、同時に創造主でもある。この世界の灰は次の世界へと形を変えるのだから。 ","index":1},{"form_id":"0x051BB0|the great village of kynesgrove.esp","type":"INFO NAM1","string":"神話の時代、アルドゥインはその役割を捨て、ドラゴン戦争で敗れるまで人類の暴虐な支配者となった。","index":2},{"form_id":"0x051BB1|the great village of kynesgrove.esp","type":"DIAL FULL","string":"マーラについて教えてくれ。"},{"form_id":"0x051BB2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"マラはカイネの侍女。愛と結婚の女神であり、その祝福によって二つの魂が結ばれ、存在を一つにするのです。","index":1},{"form_id":"0x051BB3|the great village of kynesgrove.esp","type":"DIAL FULL","string":"ツンの話を聞きたい"},{"form_id":"0x051BB4|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ツンは逆境の試練の神であり、エルフの神々からショールを守って命を落とした。","index":1},{"form_id":"0x051BB4|the great village of kynesgrove.esp","type":"INFO NAM1","string":"彼は今、ショールの館への道を守り、入ろうとする者すべてを試す。","index":2},{"form_id":"0x051BB5|the great village of kynesgrove.esp","type":"DIAL FULL","string":"ススンについて教えてくれ"},{"form_id":"0x051BB6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ススンは偉大な戦士で、ツンの兄弟です。彼はアルドメリの神々と戦い、捕虜を身代金目的で取る価値を我々に教えました。","index":1},{"form_id":"0x051BB6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"帝国では彼はステンダールとして知られている。","index":2},{"form_id":"0x051BB8|the great village of kynesgrove.esp","type":"DIAL FULL","string":"オーキーについて知りたい"},{"form_id":"0x051BB9|the great village of kynesgrove.esp","type":"INFO NAM1","string":"オーキーは死すべき定めの神だ。伝説によれば、人間とエルフの寿命はかつて同じだったが、オーキーがアルドゥインを召喚してノルドの寿命を縮めたのだ。","index":1},{"form_id":"0x051BB9|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ウルフハース王はショアに助けを求め、ショアは蛇と戦った。彼は勝利し、オーキーの民であるオークは滅びた。","index":2},{"form_id":"0x051BB9|the great village of kynesgrove.esp","type":"INFO NAM1","string":"オーキーは謎めいた存在だが、マラカスとアーケイの両方と繋がりがあることは疑いない。","index":3},{"form_id":"0x051BBA|the great village of kynesgrove.esp","type":"DIAL FULL","string":"ジュナールについて聞きたい"},{"form_id":"0x051BBB|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ジュナルは秘儀結社とルーンの神であり、言語と数学の父である。","index":1},{"form_id":"0x051BBB|the great village of kynesgrove.esp","type":"INFO NAM1","string":"しかし、多くのノルドはもはや論理や知恵をあまり気にかけておらず、そのため彼はほとんど忘れ去られています。帝国人にとってはジュリアノスです。","index":2},{"form_id":"0x051BBC|the great village of kynesgrove.esp","type":"DIAL FULL","string":"ディベラについて教えてくれ。"},{"form_id":"0x051BBD|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ディベラは美と愛の女神。私たちは彼女を芸術と人生の悦楽のために崇拝しているの。","index":1},{"form_id":"0x056CC3|the great village of kynesgrove.esp","type":"INFO NAM1","string":"俺たちの伝統に唾を吐きに来たのか？神聖な木を切り倒すために？ああ？","index":1},{"form_id":"0x056CC4|the great village of kynesgrove.esp","type":"DIAL FULL","string":"なぜ時代遅れの伝統なんかを気にしなければならないんだ？"},{"form_id":"0x056CC5|the great village of kynesgrove.esp","type":"INFO NAM1","string":"時代遅れの伝統だと?! 我々は先祖の知恵の上に生きている。それがなければ我々は何者でもない。","index":1},{"form_id":"0x056CC5|the great village of kynesgrove.esp","type":"INFO NAM1","string":"確かに、時には先祖が間違っていたこともある。だが、過去に目を背けるのは愚か者だけだ。","index":2},{"form_id":"0x056CC6|the great village of kynesgrove.esp","type":"DIAL FULL","string":"なぜ私がそんなことを？"},{"form_id":"0x056CC7|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ふむ。あの帝国人どもが我らの森を汚したのだ。製材所を建て、我らの木を切り倒そうとした。","index":1},{"form_id":"0x056CC7|the great village of kynesgrove.esp","type":"INFO NAM1","string":"さらに悪いことに、私が気づくまで誰も彼らを止めようとしなかった。この人たちが自分をノルドと名乗るなんて？","index":2},{"form_id":"0x07A3D0|the great village of kynesgrove.esp","type":"DIAL FULL","string":"他にも質問がある"},{"form_id":"0x0A2E97|the great village of kynesgrove.esp","type":"DIAL FULL","string":"君がこの森の手入れを？"},{"form_id":"0x0A2E98|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ええ、そうよ。私は「森の守護者」と呼ばれる古い宗派の一員なの。私たちは森の手入れをし、カイネの古き戦いを受け継いでいるのよ。 ","index":1},{"form_id":"0x0A2E98|the great village of kynesgrove.esp","type":"INFO NAM1","string":"私には兄が二人と姉が一人いるが、みんな出て行った。","index":2},{"form_id":"0x0A2E99|the great village of kynesgrove.esp","type":"DIAL FULL","string":"なぜ彼らは去ったんだ？"},{"form_id":"0x0A2E9A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"なぜだと思う？　彼らはストームクロークに加わったんだ。周りを見てみろ。我らの宗教がどうなったか分かっているのか？　カイネがどうなったか？","index":1},{"form_id":"0x0A2E9A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ノルドはカイネの息子と娘であるのに、ホワイトランの神殿は彼女をキナレスと呼びたがる。","index":2},{"form_id":"0x0A2E9A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ふん、キナレスなど我らの女神を嘲笑うものにすぎん。","index":3},{"form_id":"0x15A13F|the great village of kynesgrove.esp","type":"INFO NAM1","string":"私は自分の名を明かしたくない男だ。","index":1},{"form_id":"0x15A140|the great village of kynesgrove.esp","type":"DIAL FULL","string":"それで、なぜカイネスグローブへ？"},{"form_id":"0x15A141|the great village of kynesgrove.esp","type":"INFO NAM1","string":"なぜなら私はホワイトランの平原で戦った男だからだ。","index":1},{"form_id":"0x15A141|the great village of kynesgrove.esp","type":"INFO NAM1","string":"死を前にして慈悲を乞うことなく、ショールの栄光の館に入る資格を得た者がいただろうか。","index":2},{"form_id":"0x15A141|the great village of kynesgrove.esp","type":"INFO NAM1","string":"あの日、私は自分と家族の名を汚した。私はカインズグローブに来た…希望を抱いて","index":3},{"form_id":"0x15A141|the great village of kynesgrove.esp","type":"INFO NAM1","string":"いつか自分の名に名誉を取り戻せますように。もう一度家族と向き合う勇気が持てるのは、カイネの祝福があってこそなのです。","index":4},{"form_id":"0x173686|the great village of kynesgrove.esp","type":"DIAL FULL","string":"放棄された家のことを話していたな？"},{"form_id":"0x173687|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ。小麦畑の近くにある二階建ての家だ。カインズビーという名だよ。何年も売ろうとしてるんだが、なかなか難しくてね。","index":1},{"form_id":"0x173687|the great village of kynesgrove.esp","type":"INFO NAM1","string":"エスキルはこれ以上農民がカインズグローヴに定住することを望んでいない。戦争のせいで、住む人より家の方が多いらしい。","index":2},{"form_id":"0x173687|the great village of kynesgrove.esp","type":"INFO NAM1","string":"なあ、これを買ってみる気はないか？ 大したものじゃないかもしれないが、カイネスグローブは住むには美しい場所なんだ。","index":3},{"form_id":"0x173687|the great village of kynesgrove.esp","type":"INFO NAM1","string":"2000セプティムで売ってやるよ。","index":4},{"form_id":"0x173689|the great village of kynesgrove.esp","type":"DIAL FULL","string":"家を買いたい (2000)"},{"form_id":"0x17368A|the great village of kynesgrove.esp","type":"INFO NAM1","string":"素晴らしい！鍵だ！","index":1},{"form_id":"0x17368B|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ではゴールドを持ってからまた戻ってきな。","index":1},{"form_id":"0x17368D|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この放棄された家を何年も売ろうとしているんだがね。","index":1},{"form_id":"0x17368E|the great village of kynesgrove.esp","type":"INFO NAM1","string":"戦争以来、カインズビーは放棄されたままだ。","index":1},{"form_id":"0x182992|the great village of kynesgrove.esp","type":"DIAL FULL","string":"巨人や獣が農場を襲うのが怖くないのか？"},{"form_id":"0x182993|the great village of kynesgrove.esp","type":"INFO NAM1","string":"スカイリムの他の農場ならどこでもいいが、カインズグローブだけはごめんだ。この森は野生動物を落ち着かせるようだ。","index":1},{"form_id":"0x182993|the great village of kynesgrove.esp","type":"INFO NAM1","string":"巨人たちはよくこの森を訪れるけれど、決して誰も傷つけない。すべての命はカイネを敬うべきだと知っているようだ。","index":2},{"form_id":"0x182995|the great village of kynesgrove.esp","type":"DIAL FULL","string":"あなたの農場は順調のようだ"},{"form_id":"0x182996|the great village of kynesgrove.esp","type":"INFO NAM1","string":"そうだ。ノルドならどんな厳しい気候でも作物を育てられると言うだろうが、カイネの加護も助けになっているのさ。","index":1},{"form_id":"0x182996|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この林の近くでは作物がよく育つようだ。","index":2},{"form_id":"0x18299E|the great village of kynesgrove.esp","type":"DIAL FULL","string":"農場は一人でやっているのか？"},{"form_id":"0x18299F|the great village of kynesgrove.esp","type":"INFO NAM1","string":"いいえ。ヘルレイフとラグナ、それに子供たちが農場を手伝ってくれているし、クヌートおじさんは重労働には年を取りすぎているけれど、いい話し相手になってくれているわ。","index":1},{"form_id":"0x18299F|the great village of kynesgrove.esp","type":"INFO NAM1","string":"昔はもっと大勢いたんだがね、私の夫のように。","index":2},{"form_id":"0x18299F|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ、この愚かな豚め。戦争で栄光を求めて出て行ったのに、私たちには養うべき子供が三人もいるというのに！","index":3},{"form_id":"0x18CBA3|the great village of kynesgrove.esp","type":"INFO NAM1","string":"なぜ帝国と戦いに出ないんだ、エスキル？臆病者か？","index":1},{"form_id":"0x18CBA5|the great village of kynesgrove.esp","type":"INFO NAM1","string":"臆病者がカイネの栄光のためにマンモスを狩るか？ 私は真のノルドだし、ウルフリックの言うことは正しい。だが、身内同士の戦いに名誉はない。","index":1},{"form_id":"0x18CBA7|the great village of kynesgrove.esp","type":"INFO NAM1","string":"エスキル、あなたを尊敬しているわ。でも、あなたの言葉は間違っている。","index":1},{"form_id":"0x1B02BC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ガラ、この聖域のすぐそばで農作業をするべきではない。","index":1},{"form_id":"0x1B02BE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"またこれか？エスキル、俺はどうすればいいんだ？人は食わなきゃならん。","index":1},{"form_id":"0x1B02C0|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ああ。我らが先祖のように、カイネが望んだ通りに狩りをして暮らしていれば、こんな問題は起きなかっただろうに。","index":1},{"form_id":"0x1B02C2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"外にどれだけの人間がいるか分かってるのか？狩るマンモスが残っていなければ、どうやって女神に名誉を捧げるつもりだ？","index":1},{"form_id":"0x1B02C4|the great village of kynesgrove.esp","type":"INFO NAM1","string":"せめてどいてくれよ。","index":1},{"form_id":"0x1B02C6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"それでどこへ行くっていうの？ いい土地は全部取られてるし、荒野じゃ最初に出くわしたサーベルキャットに殺されちゃうわ。","index":1},{"form_id":"0x1B02CA|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ガラ、俺は、ええと、農業のことはよく分からないかもしれないが、お前は……本当に、ええと、分かってるみたいだな。","index":1},{"form_id":"0x1B02CC|the great village of kynesgrove.esp","type":"INFO NAM1","string":"まあ、ありがとう、エスキル。","index":1},{"form_id":"0x1B02CE|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ただ、ただ知らせておこうと思っただけよ…","index":1},{"form_id":"0x1B02D2|the great village of kynesgrove.esp","type":"INFO NAM1","string":"森のことはすまなかった、エスキル。","index":1},{"form_id":"0x1B02D4|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ありがとう、ガラ。まだ我らの伝統を気にかけるノルドがいるのは嬉しいことだ。","index":1},{"form_id":"0x1B02D9|the great village of kynesgrove.esp","type":"INFO NAM1","string":"またシェルドに絡まれたわ。","index":1},{"form_id":"0x1B02DB|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この牛乳飲みが。俺が話をしてくる。","index":1},{"form_id":"0x1B02DD|the great village of kynesgrove.esp","type":"INFO NAM1","string":"エスキル、何度も彼を叱ったが、あの分厚い頭蓋骨には何も届かない。","index":1},{"form_id":"0x1B02DF|the great village of kynesgrove.esp","type":"INFO NAM1","string":"ふん。よくもまあ自分をノルドと名乗れるものだ。","index":1},{"form_id":"0x1DDBF4|the great village of kynesgrove.esp","type":"INFO NAM1","string":"私は狩人だ。いや、そうなりたいと努めているところだ！","index":1},{"form_id":"0x1DDBF5|the great village of kynesgrove.esp","type":"DIAL FULL","string":"それで、なぜカイネスグローブに来たんだ？"},{"form_id":"0x1DDBF6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"これは伝統なの。私の村では皆、巡礼に出ることが求められているの。","index":1},{"form_id":"0x1DDBF6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"我々はカイネの道を敬い、自然が与えてくれるものだけを取る。","index":2},{"form_id":"0x1DDBF6|the great village of kynesgrove.esp","type":"INFO NAM1","string":"カインの聖域の近くこそ、彼女の導きから最もよく学び、やがて彼女の寵愛を得られる場所だ。","index":3},{"form_id":"0x1DDC03|the great village of kynesgrove.esp","type":"INFO NAM1","string":"やあ、大丈夫か？あまり話さないようだな。","index":1},{"form_id":"0x1DDC05|the great village of kynesgrove.esp","type":"INFO NAM1","string":"はい、はい、大丈夫です。","index":1},{"form_id":"0x1DDC07|the great village of kynesgrove.esp","type":"INFO NAM1","string":"わかった、君がそう言うなら。","index":1},{"form_id":"0x1DDC0B|the great village of kynesgrove.esp","type":"INFO NAM1","string":"この森は美しいだろう？","index":1},{"form_id":"0x1DDC0D|the great village of kynesgrove.esp","type":"INFO NAM1","string":"はい、そうです。","index":1},{"form_id":"0x1DDC11|the great village of kynesgrove.esp","type":"INFO NAM1","string":"エスキル、色々とありがとう。","index":1},{"form_id":"0x042894|the great village of kynesgrove.esp","type":"QUST FULL","string":"カイネスグローブの対話"},{"form_id":"0x0E5236|the great village of kynesgrove.esp","type":"LCTN FULL","string":"キメスビー"},{"form_id":"0x164367|the great village of kynesgrove.esp","type":"LCTN FULL","string":"ガラの家"},{"form_id":"0x164368|the great village of kynesgrove.esp","type":"LCTN FULL","string":"ヘルレイフとラグナの農場"},{"form_id":"0x16436A|the great village of kynesgrove.esp","type":"LCTN FULL","string":"巡礼者の家"},{"form_id":"0x16436B|the great village of kynesgrove.esp","type":"LCTN FULL","string":"カイネの間"},{"form_id":"0x164369|the great village of kynesgrove.esp","type":"LCTN FULL","string":"ロギの家"}]
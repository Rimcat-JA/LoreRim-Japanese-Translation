[{"form_id":"0x0AD7E7|guard dialogue overhaul.esp","type":"INFO NAM1","string":"すべて大丈夫か？","index":1},{"form_id":"0x00EA61|guard dialogue overhaul.esp","type":"INFO NAM1","string":"お元気そうで何よりです、従士。","index":1},{"form_id":"0x00EA62|guard dialogue overhaul.esp","type":"INFO NAM1","string":"ご機嫌いかがです、従士様？","index":1},{"form_id":"0x019C3C|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私はあなたのタンだ！命令するなどおこがましい。"},{"form_id":"0x019C46|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私はウィンターホールド大学の大魔術師だ。今すぐ私から離れろ、馬鹿者！"},{"form_id":"0x01B27C|guard dialogue overhaul.esp","type":"DIAL FULL","string":"他の話題から抜粋した台詞用のプレースホルダー"},{"form_id":"0x01B901|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私は同胞団の頭領だ。私のことで恐れる必要はない。"},{"form_id":"0x01B903|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私を恐れるのは当然だ、私は虚無そのものだからな。私の真実を見てみたいか？"},{"form_id":"0x01BE67|guard dialogue overhaul.esp","type":"DIAL FULL","string":"あんな臆病者は口を閉ざすことを学ぶべきだ。兵士、頼んだぞ。"},{"form_id":"0x01BE69|guard dialogue overhaul.esp","type":"DIAL FULL","string":"お前のような民間人に命令されるために、この戦争に勝ったわけではない……"},{"form_id":"0x01D3F7|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私はお前のタンだ！私の仕事に口を出すな。わかったな？"},{"form_id":"0x01D96B|guard dialogue overhaul.esp","type":"DIAL FULL","string":"アークメイジの忍耐を試すなと、母に教わらなかったのか？"},{"form_id":"0x01D96C|guard dialogue overhaul.esp","type":"DIAL FULL","string":"本当に私の目に留まることが賢明だと思うのか？ よかろう……"},{"form_id":"0x01D96D|guard dialogue overhaul.esp","type":"DIAL FULL","string":"面白いな。同胞団の誰かに吹き込まれたんだな？"},{"form_id":"0x01D96E|guard dialogue overhaul.esp","type":"DIAL FULL","string":"お前のような民間人に命令されるために、この戦争に勝ったわけではない……"},{"form_id":"0x01D96F|guard dialogue overhaul.esp","type":"DIAL FULL","string":"何をすべきか分かっている、兵士。持ち場に戻れ！"},{"form_id":"0x01D978|guard dialogue overhaul.esp","type":"DIAL FULL","string":"私を怒らせるな。怒った私を、お前は好まないだろう…"},{"form_id":"0x01DEDE|guard dialogue overhaul.esp","type":"DIAL FULL","string":"叫んでなどいない、ドラゴンは皆こう話すのだ！"}]
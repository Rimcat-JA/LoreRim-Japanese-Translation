[{"form_id":"0x000D66|goodnightskyrim.esp","type":"INFO NAM1","string":"とても疲れた。","index":1},{"form_id":"0x000D67|goodnightskyrim.esp","type":"INFO NAM1","string":"ベッドに入るわ。本当に眠らないと。","index":1},{"form_id":"0x000D68|goodnightskyrim.esp","type":"INFO NAM1","string":"ベッドの時間だ - もう眠らせてくれ。","index":1},{"form_id":"0x000805|goodnightskyrim.esp","type":"INFO NAM1","string":"本当にゆっくり休みたい。","index":1},{"form_id":"0x000D6B|goodnightskyrim.esp","type":"INFO NAM1","string":"へとへとだ。ベッドに入るとする。","index":1},{"form_id":"0x000D6C|goodnightskyrim.esp","type":"INFO NAM1","string":"ベッドに行くよ。もうヘトヘトだ。","index":1},{"form_id":"0x000D6D|goodnightskyrim.esp","type":"INFO NAM1","string":"疲れたな。","index":1},{"form_id":"0x000D6E|goodnightskyrim.esp","type":"INFO NAM1","string":"そろそろ寝るか。","index":1},{"form_id":"0x000D6F|goodnightskyrim.esp","type":"INFO NAM1","string":"休みたくてたまりません。","index":1},{"form_id":"0x000D70|goodnightskyrim.esp","type":"INFO NAM1","string":"少し眠らせてくれ。荷物は他の誰かに運んでもらえ。","index":1},{"form_id":"0x000D71|goodnightskyrim.esp","type":"INFO NAM1","string":"そろそろ毛皮の下にもぐり込むとしよう","index":1},{"form_id":"0x000D72|goodnightskyrim.esp","type":"INFO NAM1","string":"急にとても疲れ果ててしまった。","index":1},{"form_id":"0x000D73|goodnightskyrim.esp","type":"INFO NAM1","string":"もう寝る。美しい肌を保つ睡眠が本当に必要なのだ。","index":1},{"form_id":"0x000D74|goodnightskyrim.esp","type":"INFO NAM1","string":"少し眠らないと。","index":1},{"form_id":"0x000D75|goodnightskyrim.esp","type":"INFO NAM1","string":"もうベッドに入る。放っておいてくれ。","index":1},{"form_id":"0x000D76|goodnightskyrim.esp","type":"INFO NAM1","string":"神々よ、疲れた。","index":1},{"form_id":"0x000D77|goodnightskyrim.esp","type":"INFO NAM1","string":"もう寝かせてくれ。","index":1},{"form_id":"0x000D78|goodnightskyrim.esp","type":"INFO NAM1","string":"一晩中眠る、眠る眠る眠る。","index":1},{"form_id":"0x000D79|goodnightskyrim.esp","type":"INFO NAM1","string":"よし。私はベッドに入るとしよう。","index":1},{"form_id":"0x000D7A|goodnightskyrim.esp","type":"INFO NAM1","string":"そろそろ毛皮の下にもぐり込むとしよう","index":1},{"form_id":"0x000D7B|goodnightskyrim.esp","type":"INFO NAM1","string":"やっと眠れる。","index":1},{"form_id":"0x000D7C|goodnightskyrim.esp","type":"INFO NAM1","string":"眠らなければ。邪魔しないでくれ。","index":1},{"form_id":"0x000D7D|goodnightskyrim.esp","type":"INFO NAM1","string":"疲れた。","index":1},{"form_id":"0x000D7E|goodnightskyrim.esp","type":"INFO NAM1","string":"ふぁ～あ。すっごく眠い。","index":1},{"form_id":"0x000800|goodnightskyrim.esp","type":"INFO NAM1","string":"疲れたな。","index":1},{"form_id":"0x000801|goodnightskyrim.esp","type":"INFO NAM1","string":"カジートは疲れている。カジートは眠る必要がある。","index":1},{"form_id":"0x000802|goodnightskyrim.esp","type":"INFO NAM1","string":"寝かせてくれよ。","index":1},{"form_id":"0x000803|goodnightskyrim.esp","type":"INFO NAM1","string":"私は年寄りだ。眠りが必要なんだ――だから眠らせてくれ。","index":1},{"form_id":"0x000807|goodnightskyrim.esp","type":"INFO NAM1","string":"私は眠る。邪魔をすることなど考えないことだ。","index":1},{"form_id":"0x000808|goodnightskyrim.esp","type":"INFO NAM1","string":"眠るつもりだ――だから静かにしてくれ。","index":1},{"form_id":"0x000809|goodnightskyrim.esp","type":"INFO NAM1","string":"眠るとするか。神のみぞ知る、私には必要だ。","index":1},{"form_id":"0x00080A|goodnightskyrim.esp","type":"INFO NAM1","string":"眠るとするか。神のみぞ知る、私には必要だ。","index":1},{"form_id":"0x00080B|goodnightskyrim.esp","type":"INFO NAM1","string":"必要な睡眠を取らせてもらう。","index":1},{"form_id":"0x00080C|goodnightskyrim.esp","type":"INFO NAM1","string":"おやすみなさい","index":1},{"form_id":"0x00080D|goodnightskyrim.esp","type":"INFO NAM1","string":"おやすみなさい","index":1},{"form_id":"0x00080E|goodnightskyrim.esp","type":"INFO NAM1","string":"カジートは眠る必要がある。","index":1},{"form_id":"0x00080F|goodnightskyrim.esp","type":"INFO NAM1","string":"出て行って、寝かせてくれ！","index":1},{"form_id":"0x000810|goodnightskyrim.esp","type":"INFO NAM1","string":"出て行ってくれ、眠らせてくれ。","index":1},{"form_id":"0x000811|goodnightskyrim.esp","type":"INFO NAM1","string":"疲れた。おやすみ。","index":1},{"form_id":"0x000812|goodnightskyrim.esp","type":"INFO NAM1","string":"もうくたくただ。ベッドに入るとするよ。","index":1},{"form_id":"0x000813|goodnightskyrim.esp","type":"INFO NAM1","string":"とても疲れた。ベッドに入るよ。","index":1},{"form_id":"0x000814|goodnightskyrim.esp","type":"INFO NAM1","string":"今からベッドに入るわ。","index":1}]
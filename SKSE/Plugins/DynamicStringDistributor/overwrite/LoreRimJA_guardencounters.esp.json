[{"form_id":"0x000802|guardencounters.esp","type":"DIAL FULL","string":"どうしてそんなふうに私の方を見る？"},{"form_id":"0x000808|guardencounters.esp","type":"INFO NAM1","string":"それはタロスのアミュレットか？ そんな格好でうろついて、どういうつもりだ？","index":1},{"form_id":"0x000808|guardencounters.esp","type":"INFO NAM1","string":"タロスの崇拝は、白金協定の条項によって固く禁じられている。","index":2},{"form_id":"0x000803|guardencounters.esp","type":"INFO NAM1","string":"タロスの装束でここをうろつくとはいい度胸だ。正気か？ 痛い目に遭いたいのか？","index":2},{"form_id":"0x000803|guardencounters.esp","type":"INFO NAM1","string":"大戦後のエルフとの条約で、タロスの自由な崇拝は禁じられている。","index":3},{"form_id":"0x000809|guardencounters.esp","type":"INFO NAM1","string":"タロスの装束でうろついて、どういうつもりだ？ 痛い目に遭いたいのか？","index":1},{"form_id":"0x000806|guardencounters.esp","type":"INFO NAM1","string":"まあいい。今回は見逃してやる。だが、それは外したほうが賢明だぞ。誤解する奴がいるかもしれないからな。","index":1},{"form_id":"0x000805|guardencounters.esp","type":"DIAL FULL","string":"誇り高きタロスの信者だ。何か文句でも?"},{"form_id":"0x000807|guardencounters.esp","type":"INFO NAM1","string":"「問題」は、お前がこの地の法を軽んじていることだ。首長の裁きを受けてもらうぞ。","index":1},{"form_id":"0x00085A|guardencounters.esp","type":"DIAL FULL","string":"何か言うことは？"},{"form_id":"0x00085F|guardencounters.esp","type":"INFO NAM1","string":"何だ、エルフ？","index":1},{"form_id":"0x000860|guardencounters.esp","type":"INFO NAM1","string":"何だ、オーク？","index":1},{"form_id":"0x000861|guardencounters.esp","type":"INFO NAM1","string":"何だ、帝国人？","index":1},{"form_id":"0x000862|guardencounters.esp","type":"INFO NAM1","string":"何だ、レッドガード？","index":1},{"form_id":"0x000863|guardencounters.esp","type":"INFO NAM1","string":"何だ、カジート？","index":1},{"form_id":"0x000864|guardencounters.esp","type":"INFO NAM1","string":"何だ、アルゴニアン？","index":1},{"form_id":"0x000865|guardencounters.esp","type":"INFO NAM1","string":"何の用だ、吟遊詩人？","index":1},{"form_id":"0x000866|guardencounters.esp","type":"INFO NAM1","string":"名誉ある同胞団の方。何かお手伝いしましょうか？","index":1},{"form_id":"0x000867|guardencounters.esp","type":"INFO NAM1","string":"はい、ドヴァーキン？ 何かご用ですか？","index":1},{"form_id":"0x000868|guardencounters.esp","type":"INFO NAM1","string":"何なりと、ドラゴンボーン。一言おっしゃってください。","index":1},{"form_id":"0x000869|guardencounters.esp","type":"INFO NAM1","string":"街に問題がないとよいのですが、従士殿。","index":1},{"form_id":"0x00086A|guardencounters.esp","type":"INFO NAM1","string":"同胞のノルドのために、何をしてやれる？","index":1},{"form_id":"0x00086B|guardencounters.esp","type":"INFO NAM1","string":"何の用だ……猫？","index":1},{"form_id":"0x00086C|guardencounters.esp","type":"INFO NAM1","string":"俺に逆らうなよ、エルフ。","index":1},{"form_id":"0x0008D6|guardencounters.esp","type":"INFO NAM1","string":"いい感じの小村だが、衛兵の配属先としては退屈だ。","index":1},{"form_id":"0x0008D7|guardencounters.esp","type":"INFO NAM1","string":"ついてないな。こんな田舎に押し込められて。","index":1},{"form_id":"0x000964|guardencounters.esp","type":"INFO NAM1","string":"首長なら広間にいる。","index":1},{"form_id":"0x0008EE|guardencounters.esp","type":"INFO NAM1","string":"首長なら砦の中だ。","index":1},{"form_id":"0x00090C|guardencounters.esp","type":"INFO NAM1","string":"これこそ本物の衛兵の仕事だ。この場所を見てみろ。","index":1},{"form_id":"0x000916|guardencounters.esp","type":"INFO NAM1","string":"リフテンが寒いなんて文句を言ってた自分が信じられないよ……","index":1},{"form_id":"0x00091A|guardencounters.esp","type":"INFO NAM1","string":"厳しい冬だ。これほど寒くて、これほど長く続いた冬は記憶にない。","index":1},{"form_id":"0x000920|guardencounters.esp","type":"INFO NAM1","string":"この降ったばかりの雪を見てくれ！ 長年生きてきたが、こんなに美しいものは見たことがない。","index":1},{"form_id":"0x000A32|guardencounters.esp","type":"INFO NAM1","string":"よくわからないな。ここは何も問題ないように見える。何か見かけたら知らせてくれ。衛兵が対処する。","index":1},{"form_id":"0x000960|guardencounters.esp","type":"DIAL FULL","string":"なぜウィンドヘルムではノルドだけが好きな所に住めるんだ？"},{"form_id":"0x000961|guardencounters.esp","type":"INFO NAM1","string":"忠実なノルドならいつでも歓迎だ。それ以外の奴は、足元に気をつけるんだな。","index":1},{"form_id":"0x000962|guardencounters.esp","type":"DIAL FULL","string":"もううんざりだ。これ以上我慢はしない。"},{"form_id":"0x000963|guardencounters.esp","type":"INFO NAM1","string":"そうか？ なら、首長の安寧を乱した罪で告発させてもらう。","index":1},{"form_id":"0x00096E|guardencounters.esp","type":"DIAL FULL","string":"何をじろじろ見ているんだ？"},{"form_id":"0x000971|guardencounters.esp","type":"INFO NAM1","string":"よくもぬけぬけと顔を出せたもんだな。汚らわしいクズめ。","index":1},{"form_id":"0x000971|guardencounters.esp","type":"INFO NAM1","string":"我らが民への侮辱だ。ウィンドヘルムはスカイリムのもの、お前らの種族のものじゃない。","index":2},{"form_id":"0x000973|guardencounters.esp","type":"DIAL FULL","string":"へえ、そうかい？それでどうするつもりだ？"},{"form_id":"0x000974|guardencounters.esp","type":"DIAL FULL","string":"落ち着こう。何かの間違いに違いない。"},{"form_id":"0x000975|guardencounters.esp","type":"DIAL FULL","string":"すみません。お願い…放っておいて"},{"form_id":"0x000979|guardencounters.esp","type":"DIAL FULL","string":"ふざけるな！ 出て行くものか。で、どうする？ 牢屋行きか？(牢屋へ行く)"},{"form_id":"0x00097A|guardencounters.esp","type":"DIAL FULL","string":"どこにも一緒に行くつもりはない。(戦う)"},{"form_id":"0x00097D|guardencounters.esp","type":"DIAL FULL","string":"ウルフリックがこんなことを認めるはずがない。(説得)"},{"form_id":"0x000980|guardencounters.esp","type":"DIAL FULL","string":"何か…取り決めができないかな? (<BribeCost>ゴールド)"},{"form_id":"0x000981|guardencounters.esp","type":"DIAL FULL","string":"立ち去ったほうがいい。今すぐに (威圧)"},{"form_id":"0x000982|guardencounters.esp","type":"DIAL FULL","string":"同族を代表して…謝罪する。道を空けるよ。"},{"form_id":"0x000987|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ。","index":1},{"form_id":"0x000988|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、アルゴニアン。","index":1},{"form_id":"0x000989|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、カジート。","index":1},{"form_id":"0x00098A|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、ブレトン。","index":1},{"form_id":"0x00098B|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、帝国人。","index":1},{"form_id":"0x00098C|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、レッドガード。","index":1},{"form_id":"0x00098D|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、オーク。","index":1},{"form_id":"0x00098E|guardencounters.esp","type":"INFO NAM1","string":"そこで止まれ、エルフ。","index":1},{"form_id":"0x00098F|guardencounters.esp","type":"INFO NAM1","string":"出ていってもらおう。スカイリムにお前らの種族は必要ない。","index":1},{"form_id":"0x000990|guardencounters.esp","type":"INFO NAM1","string":"間違いなんかじゃない。スカイリムにお前らの種族は必要ない。出ていけ。","index":1},{"form_id":"0x000991|guardencounters.esp","type":"INFO NAM1","string":"見かけよりは賢いようだな。","index":1},{"form_id":"0x000992|guardencounters.esp","type":"INFO NAM1","string":"見かけよりは賢いようだな。さあ、行け。","index":1},{"form_id":"0x000993|guardencounters.esp","type":"INFO NAM1","string":"勝手にしろ。だが、タダで済むと思うなよ。","index":1},{"form_id":"0x000998|guardencounters.esp","type":"INFO NAM1","string":"いいだろう。","index":1},{"form_id":"0x000999|guardencounters.esp","type":"INFO NAM1","string":"もういい。お前に構うだけ無駄だ。行け……他の衛兵の厄介になれ。","index":1},{"form_id":"0x00099A|guardencounters.esp","type":"INFO NAM1","string":"騙されないぞ。この場で斬り捨てられないだけ運がいいと思え。","index":1},{"form_id":"0x00099B|guardencounters.esp","type":"INFO NAM1","string":"わかった。だが気をつけるんだな。次はこう甘くはないかもしれないぞ。","index":1},{"form_id":"0x00099C|guardencounters.esp","type":"INFO NAM1","string":"口先で切り抜けられると思うなよ。","index":1},{"form_id":"0x00099D|guardencounters.esp","type":"INFO NAM1","string":"方法は二つだ。おとなしく砦まで一緒に歩くか、それとも俺がお前の死体を引きずっていくか。好きなほうを選べ。","index":1},{"form_id":"0x0009A1|guardencounters.esp","type":"INFO NAM1","string":"タダで済むと思うなよ。","index":1},{"form_id":"0x0009A2|guardencounters.esp","type":"INFO NAM1","string":"おい！ どこへ行くつもりだ？","index":1},{"form_id":"0x0009A3|guardencounters.esp","type":"INFO NAM1","string":"おい！ どこへ行くつもりだ？ タダで済むと思うなよ。","index":1},{"form_id":"0x0009A9|guardencounters.esp","type":"INFO NAM1","string":"望みどおりにしてやろう。","index":1},{"form_id":"0x0009DA|guardencounters.esp","type":"INFO NAM1","string":"勝手にしろ。","index":1},{"form_id":"0x0009DB|guardencounters.esp","type":"INFO NAM1","string":"これで済んだ。さあ行け、俺が面倒に巻き込まれる前にな。","index":1},{"form_id":"0x000996|guardencounters.esp","type":"DIAL FULL","string":"あそこにあるのは何だ？(逃げる)"},{"form_id":"0x00099F|guardencounters.esp","type":"DIAL FULL","string":"あそこにあるのは何だ？(逃げる)"},{"form_id":"0x0009A5|guardencounters.esp","type":"DIAL FULL","string":"何も悪いことはしていないが、いいだろう。牢屋に連れて行け。"},{"form_id":"0x0009A6|guardencounters.esp","type":"DIAL FULL","string":"何だと？牢屋に入るくらいなら死んだほうがましだ。それに、何も悪いことはしていない。"},{"form_id":"0x0009A7|guardencounters.esp","type":"DIAL FULL","string":"その通りだと思う"},{"form_id":"0x0009A8|guardencounters.esp","type":"DIAL FULL","string":"何だと？落ち着いてくれ！何も悪いことはしていない。(説得)"},{"form_id":"0x0009AF|guardencounters.esp","type":"DIAL FULL","string":"興味深いね。さて、もう行くよ。"},{"form_id":"0x0009B1|guardencounters.esp","type":"DIAL FULL","string":"えっと…さようなら。"},{"form_id":"0x0009B3|guardencounters.esp","type":"DIAL FULL","string":"考え直してみると、その方針は正しいと思う。"},{"form_id":"0x0009BC|guardencounters.esp","type":"DIAL FULL","string":"どうしてそんなふうに私の方を見る？"},{"form_id":"0x0009C0|guardencounters.esp","type":"DIAL FULL","string":"何かの間違いだ。罪なんて犯していない。"},{"form_id":"0x0009C1|guardencounters.esp","type":"INFO NAM1","string":"そうか？ なら、首長の安寧を乱した罪で告発させてもらう。","index":1},{"form_id":"0x0009C2|guardencounters.esp","type":"DIAL FULL","string":"何か…取り決めができないかな? (<BribeCost>ゴールド)"},{"form_id":"0x0009C3|guardencounters.esp","type":"DIAL FULL","string":"お前の腐敗に手を貸すくらいなら死んだほうがましだ！"},{"form_id":"0x0009C4|guardencounters.esp","type":"DIAL FULL","string":"冷静になってくれ。何も悪いことはしていない (説得)"},{"form_id":"0x0009C5|guardencounters.esp","type":"DIAL FULL","string":"立ち去れ。今すぐ。(威圧)"},{"form_id":"0x0009C6|guardencounters.esp","type":"DIAL FULL","string":"わかった。逮捕しろ。でも無実だ! (牢屋へ行く)"},{"form_id":"0x0009C7|guardencounters.esp","type":"DIAL FULL","string":"こんなことをしている暇はないんだろう?"},{"form_id":"0x0009D1|guardencounters.esp","type":"DIAL FULL","string":"後ろにあるのは何だ？(逃げる)"},{"form_id":"0x0009B9|guardencounters.esp","type":"QUST FULL","string":"リフテンの汚職衛兵"},{"form_id":"0x00095E|guardencounters.esp","type":"QUST FULL","string":"不快な衛兵"},{"form_id":"0x000800|guardencounters.esp","type":"QUST FULL","string":"熱心なソリチュードの衛兵"},{"form_id":"0x0009BA|guardencounters.esp","type":"MESG DESC","string":"怪しいリフテン衛兵"},{"form_id":"0x0009BA|guardencounters.esp","type":"MESG FULL","string":"怪しいリフテン衛兵"},{"form_id":"0x0009B5|guardencounters.esp","type":"MESG DESC","string":"好戦的なウィンドヘルムの衛兵"},{"form_id":"0x0009B5|guardencounters.esp","type":"MESG FULL","string":"喧嘩腰のウィンドヘルム衛兵"},{"form_id":"0x00099E|guardencounters.esp","type":"MESG DESC","string":"不快なウィンドヘルム衛兵"},{"form_id":"0x00099E|guardencounters.esp","type":"MESG FULL","string":"不快なウィンドヘルム衛兵"}]
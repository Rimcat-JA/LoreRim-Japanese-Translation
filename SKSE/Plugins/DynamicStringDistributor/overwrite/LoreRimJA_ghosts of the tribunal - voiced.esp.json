[{"form_id":"0x000802|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"我らは万物の母アルマレクシアの最後の真に忠実なる僕だ。御方への信仰が我らを癒やし、支えている。","index":1},{"form_id":"0x000803|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"トリビュナルは再び立ち上がる。そしてアッシュフォールズ・ティアこそが、その全ての始まりの地だ。","index":1},{"form_id":"0x000804|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"三大神にかけて、我が権利と義務を。","index":1},{"form_id":"0x000805|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"三大神に従え。精霊たちと汝の主君たちに。","index":1},{"form_id":"0x000806|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"三柱の神、唯一の真の信仰。","index":1},{"form_id":"0x000807|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"つま先のヴェスパースだ。御方のつま先、というわけさ。お見知りおきを。","index":1},{"form_id":"0x000808|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"それらしく見えないからって、他の連中より劣ってるってわけじゃないぞ。","index":1},{"form_id":"0x000809|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"こっちがいなけりゃ、この陰気な連中の毎日を誰が明るくするってんだ？","index":1},{"form_id":"0x00080A|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"番兵シンドラスだ。よろしく頼む。","index":1},{"form_id":"0x00080B|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"先に言っておくが、兜は脱がないぞ。","index":1},{"form_id":"0x00080C|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"相手が見られていると気づいていない時にこそ、多くのことが見えてくるものだ。","index":1},{"form_id":"0x00080D|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"お前が話している相手は、御手の最後の一人だ。","index":1},{"form_id":"0x00080E|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"我らは女神の命を待つ。御方の言葉こそ我らの法だ。","index":1},{"form_id":"0x00080F|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"アルマレクシアは全てを知り、全てを見ておられる。","index":1},{"form_id":"0x000810|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"私が御手の最後の一人だ。","index":1},{"form_id":"0x000811|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"我らは女神の命を待つ。御方の言葉こそ我らの法だ。","index":1},{"form_id":"0x000812|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"アルマレクシアは全てを知り、全てを見ておられる。","index":1},{"form_id":"0x000813|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"ここレイヴン・ロックでの計画を急ぐ時が来た。我々はあまりにも長く身を潜めすぎた。","index":1},{"form_id":"0x000814|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"間もなくトリビュナルをかつての栄光に戻し、そしてこの戦いを本土へと広げるのだ。","index":1},{"form_id":"0x000815|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"彫刻家ヴィシュタルだ。任されてるのは……まあ、わかるだろう、彫刻さ。","index":1},{"form_id":"0x000816|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"入り口で立ち止まって、栄光に満ちた御方のお姿を眺めたかい？我らが女神は驚くほど美しく、完璧だと思わないか？","index":1},{"form_id":"0x000817|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"それなのに、御方をこんな湿っぽい洞窟に潜ませておくなんて……いつか必ず、そんな状況は終わらせてみせる。","index":1},{"form_id":"0x000818|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"アルマレクシアを讃えよ。","index":1},{"form_id":"0x000819|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"我らは女神の命を待つ。御方の言葉こそ我らの法だ。","index":1},{"form_id":"0x00081A|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"トリビュナルは再び立ち上がる。","index":1},{"form_id":"0x00081B|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"アッシュヤムはよく育っている。ここで栽培するのは簡単じゃなかったんだ。","index":1},{"form_id":"0x00081C|ghosts of the tribunal - voiced.esp","type":"INFO NAM1","string":"好きなものを持っていってくれていい。でも私たちの分も少しは残しておいてくれ。","index":1}]
[{"form_id":"0x00088B|npcs react to necromancy.esp","type":"INFO NAM1","string":"何だ…？やめろ！今すぐ！！","index":1},{"form_id":"0x000801|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ？近寄るな。","index":1},{"form_id":"0x000802|npcs react to necromancy.esp","type":"INFO NAM1","string":"何だ…？神々よ、何と言えばいいのかもわからない！","index":1},{"form_id":"0x000804|npcs react to necromancy.esp","type":"INFO NAM1","string":"やめてくれ！魔法は嫌いなんだ。","index":1},{"form_id":"0x000803|npcs react to necromancy.esp","type":"INFO NAM1","string":"近寄るな。","index":1},{"form_id":"0x000805|npcs react to necromancy.esp","type":"INFO NAM1","string":"うわっ！死体だ！","index":1},{"form_id":"0x000806|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは？","index":1},{"form_id":"0x000807|npcs react to necromancy.esp","type":"INFO NAM1","string":"その呪文は危なそうだ。離れていてくれ。","index":1},{"form_id":"0x000808|npcs react to necromancy.esp","type":"INFO NAM1","string":"あっちへ行ってくれ…","index":1},{"form_id":"0x000809|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは？","index":1},{"form_id":"0x00080C|npcs react to necromancy.esp","type":"INFO NAM1","string":"あいつ…死んでるのか？","index":1},{"form_id":"0x00080E|npcs react to necromancy.esp","type":"INFO NAM1","string":"何だ…？イスグラモルが見たら恥じるぞ！","index":1},{"form_id":"0x00080D|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは？","index":1},{"form_id":"0x00080F|npcs react to necromancy.esp","type":"INFO NAM1","string":"その呪文は危なそうだ。離れていてくれ。","index":1},{"form_id":"0x000810|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは？","index":1},{"form_id":"0x000811|npcs react to necromancy.esp","type":"INFO NAM1","string":"本当に…死んでるのか？何の魔法だ、これは！？","index":1},{"form_id":"0x000812|npcs react to necromancy.esp","type":"INFO NAM1","string":"頼む、その魔法を近づけないでくれ！","index":1},{"form_id":"0x000813|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ？あっちへ行け！","index":1},{"form_id":"0x000814|npcs react to necromancy.esp","type":"INFO NAM1","string":"どうやったんだ？","index":1},{"form_id":"0x000815|npcs react to necromancy.esp","type":"INFO NAM1","string":"どう見ても死んでるな。本当に胸糞悪い！","index":1},{"form_id":"0x000816|npcs react to necromancy.esp","type":"INFO NAM1","string":"あっちへ行け！","index":1},{"form_id":"0x000818|npcs react to necromancy.esp","type":"INFO NAM1","string":"神々よ！なんて下品な見せ物だ…","index":1},{"form_id":"0x000819|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは！？恥を知れ！","index":1},{"form_id":"0x00081A|npcs react to necromancy.esp","type":"INFO NAM1","string":"何の魔法だ、これは！？ひどすぎる！あっちへ行け！","index":1},{"form_id":"0x00081B|npcs react to necromancy.esp","type":"INFO NAM1","string":"死んでる！？何の魔法だ、これは？","index":1},{"form_id":"0x00081C|npcs react to necromancy.esp","type":"INFO NAM1","string":"あんたは歓迎されてない。出て行け！","index":1},{"form_id":"0x00081E|npcs react to necromancy.esp","type":"INFO NAM1","string":"忌々しい魔術師め。やめろ！","index":1},{"form_id":"0x00081F|npcs react to necromancy.esp","type":"INFO NAM1","string":"ご大層な魔法なら、どこか他所で使ってくれ。不自然だ。","index":1},{"form_id":"0x000820|npcs react to necromancy.esp","type":"INFO NAM1","string":"そいつをここから連れ出せ。今すぐだ！","index":1},{"form_id":"0x000822|npcs react to necromancy.esp","type":"INFO NAM1","string":"呪文がいくつか使えるってわけか。感心しろとでも？","index":1},{"form_id":"0x00081D|npcs react to necromancy.esp","type":"INFO NAM1","string":"気味の悪い連れがいるな。不自然だ！","index":1},{"form_id":"0x000827|npcs react to necromancy.esp","type":"INFO NAM1","string":"おいおいおい！魔法に気をつけろ！","index":1},{"form_id":"0x000826|npcs react to necromancy.esp","type":"INFO NAM1","string":"神々よ。世の中どうなってるんだ？","index":1},{"form_id":"0x000823|npcs react to necromancy.esp","type":"INFO NAM1","string":"あの…化け物。不自然だ！","index":1},{"form_id":"0x000825|npcs react to necromancy.esp","type":"INFO NAM1","string":"なんて汚らわしくて不自然な仲間だ。近寄るな！","index":1},{"form_id":"0x000828|npcs react to necromancy.esp","type":"INFO NAM1","string":"イスグラモルが見たら恥じるぞ！","index":1},{"form_id":"0x000829|npcs react to necromancy.esp","type":"INFO NAM1","string":"魔法か。邪悪な魔法だ！顔に書いてあるぞ。あっちへ
[{"form_id":"0x000A2A|environs - riften warehouse.esp","type":"CONT FULL","string":"東帝都社前哨地の商人チェスト"},{"form_id":"0x000804|environs - riften warehouse.esp","type":"NPC_ FULL","string":"ゲルミル"},{"form_id":"0x000A48|environs - riften warehouse.esp","type":"NPC_ FULL","string":"ビェンス"},{"form_id":"0x0008DE|environs - riften warehouse.esp","type":"KEYM FULL","string":"東帝都社前哨地の鍵"},{"form_id":"0x000A55|environs - riften warehouse.esp","type":"INFO NAM1","string":"東帝都社へようこそ。何かご用かな?","index":1},{"form_id":"0x000A56|environs - riften warehouse.esp","type":"INFO NAM1","string":"うう、この散らかりよう。人手をケチった報いだな。","index":1},{"form_id":"0x000A57|environs - riften warehouse.esp","type":"INFO NAM1","string":"ああ、一番のお得意様だ。何が必要かな?","index":1},{"form_id":"0x000A73|environs - riften warehouse.esp","type":"INFO NAM1","string":"何か物が必要なら、言ってくれ。","index":1},{"form_id":"0x000A6B|environs - riften warehouse.esp","type":"INFO NAM1","string":"これがリフテンか。故郷にいればよかった。","index":1},{"form_id":"0x000A6C|environs - riften warehouse.esp","type":"INFO NAM1","string":"盗賊ギルドはラットウェイをねぐらにしている。なんてひどい場所だ、想像もしたくない。","index":1},{"form_id":"0x000A6D|environs - riften warehouse.esp","type":"INFO NAM1","string":"東帝都社に用があるなら、私の居場所は分かっているだろう。","index":1},{"form_id":"0x000A6E|environs - riften warehouse.esp","type":"INFO NAM1","string":"仕事を探しているなら、ウィンドヘルムを当たってみるといい。","index":1},{"form_id":"0x000A6F|environs - riften warehouse.esp","type":"INFO NAM1","string":"何をじろじろ見ている?","index":1},{"form_id":"0x000A8A|environs - riften warehouse.esp","type":"INFO NAM1","string":"いらっしゃい、今日の商売はどうだい?","index":1},{"form_id":"0x000A8B|environs - riften warehouse.esp","type":"INFO NAM1","string":"俺はたいてい掃いたりシャベルですくったりしてる。ちょっと退屈だが、まっとうな仕事さ。","index":1},{"form_id":"0x000A8C|environs - riften warehouse.esp","type":"INFO NAM1","string":"今日はひどく腰が痛むんだ。","index":1},{"form_id":"0x000A8D|environs - riften warehouse.esp","type":"INFO NAM1","string":"また今度話そう。ここでやらなきゃならない仕事があるんだ。","index":1},{"form_id":"0x000A8E|environs - riften warehouse.esp","type":"INFO NAM1","string":"よう、我が友よ。言っとくが、しらふなんてのは買いかぶられすぎだぜ。","index":1},{"form_id":"0x000A8F|environs - riften warehouse.esp","type":"INFO NAM1","string":"ブラック・ブライア・メダリーにはぜひ行ってみな。見逃しようがないぜ。","index":1},{"form_id":"0x000A90|environs - riften warehouse.esp","type":"INFO NAM1","string":"厄介な時代だよ。まあ、酒を飲むのに厄介なことは何もないがね。","index":1},{"form_id":"0x000A58|environs - riften warehouse.esp","type":"INFO NAM1","string":"まあ、少なくとも仕事には戻れる。うう……くそっ。","index":1},{"form_id":"0x000A59|environs - riften warehouse.esp","type":"INFO NAM1","string":"取引できて嬉しいよ。","index":1},{"form_id":"0x000A5A|environs - riften warehouse.esp","type":"INFO NAM1","string":"友よ、アズラの英知があらんことを。","index":1},{"form_id":"0x000A70|environs - riften warehouse.esp","type":"INFO NAM1","string":"用心しろよ、友よ。","index":1},{"form_id":"0x000A5C|environs - riften warehouse.esp","type":"DIAL FULL","string":"代わりに海岸近くに拠点を開いたらどうだ？"},{"form_id":"0x000A5D|environs - riften warehouse.esp","type":"INFO NAM1","string":"本気か? 北には巨大な氷原があって、凍えるほど寒いんだぞ。","index":1},{"form_id":"0x000A5D|environs - riften warehouse.esp","type":"INFO NAM1","string":"ドーンスターは食うに困った鉱夫だらけだ。あそこの話はしないでくれ。","index":2},{"form_id":"0x000A5D|environs - riften warehouse.esp","type":"INFO NAM1","string":"それに比べてブラックライトは、まともな街だ。頭に斧を食らう心配も少ない。","index":3},{"form_id":"0x000A5F|environs - riften warehouse.esp","type":"DIAL FULL","string":"最近は商人にとって道が危険だ。"},{"form_id":"0x000A60|environs - riften warehouse.esp","type":"INFO NAM1","string":"ああ、まったくだ。忌々しい山賊どもは、故郷の灰の荒野にはびこる害獣よりたちが悪い。危険手当がかさむばかりだよ。","index":1},{"form_id":"0x000A63|environs - riften warehouse.esp","type":"INFO NAM1","string":"何なりとお申し付けを。","index":1},{"form_id":"0x000A64|environs - riften warehouse.esp","type":"INFO NAM1","string":"ほう、ただの流れ者ではなかったか。","index":1},{"form_id":"0x000A65|environs - riften warehouse.esp","type":"INFO NAM1","string":"きっといい取引ができるはずだ。","index":1},{"form_id":"0x000A66|environs - riften warehouse.esp","type":"INFO NAM1","string":"必要なものは何でも、相応の値段でね。","index":1},{"form_id":"0x000A68|environs - riften warehouse.esp","type":"INFO NAM1","string":"合図をくれれば、必要なときは手を貸そう。","index":1},{"form_id":"0x000A69|environs - riften warehouse.esp","type":"INFO NAM1","string":"そうか、では好きにするといい。","index":1},{"form_id":"0x000A6A|environs - riften warehouse.esp","type":"INFO NAM1","string":"物資を探しているなら、うちはなかなか評判がいいぞ。","index":1},{"form_id":"0x000A89|environs - riften warehouse.esp","type":"INFO NAM1","string":"前の雇い主は、山賊が詰めた砦にたった一人で挑んで殺されたよ。まったく、とんだ災難だ。","index":1},{"form_id":"0x000A71|environs - riften warehouse.esp","type":"DIAL FULL","string":"どうやってやっていくつもり?"},{"form_id":"0x000A72|environs - riften warehouse.esp","type":"INFO NAM1","string":"傭兵も何人か雇うつもりだ。1セプティムたりとも無駄にはならん。もっとも、彼らは異論があるかもしれないがね。死んだ連中は特に。","index":1},{"form_id":"0x0008D4|environs - riften warehouse.esp","type":"LCTN FULL","string":"東帝都社の前哨地"}]
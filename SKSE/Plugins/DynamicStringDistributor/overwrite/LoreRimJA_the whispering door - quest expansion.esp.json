[{"form_id":"0x000D7F|the whispering door - quest expansion.esp","type":"MGEF FULL","string":"首長の息子の血痕"},{"form_id":"0x000D80|the whispering door - quest expansion.esp","type":"SPEL FULL","string":"子供の血の呪文"},{"form_id":"0x000D71|the whispering door - quest expansion.esp","type":"BOOK FULL","string":"血まみれのメモ"},{"form_id":"0x000D71|the whispering door - quest expansion.esp","type":"BOOK DESC","string":"<font face='$HandwrittenFont'>彼女が囁き、私は聞く。\r\n\r\n 彼女が囁き、私は動く。\r\n\r\n ついに扉は開かれた。だから私は彼女の望むままに行う。 \r\n\r\n魔術師の鍵を盗むのは朝飯前だった。\r\n\r\nいよいよ従者をここへおびき寄せ、契約を結ぶ時だ。 \r\n\r\n刃は望むものを手に入れるだろう。 </font>"},{"form_id":"0x000838|the whispering door - quest expansion.esp","type":"CONT FULL","string":"番人の金庫"},{"form_id":"0x00082C|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"息子が死んだ！ 出て行け、出て行って二度と戻ってくるな！ 衛兵、侵入者だ！","index":1},{"form_id":"0x00082D|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"それで……何かわかったか？","index":1},{"form_id":"0x00082E|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ああ……息子はどこだ……教えてくれ。","index":1},{"form_id":"0x000826|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"いつか、あいつの顔を引き裂いてやる、見てなよ。今にわかるさ！ はははは。","index":1},{"form_id":"0x000828|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"血が……あんなにたくさんの血が！","index":1},{"form_id":"0x000827|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"首長の息子さん……本当に気味が悪いんだから。","index":1},{"form_id":"0x000806|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"息子さんが先に剣を手にした。使用人のフィアナが殺された。"},{"form_id":"0x000807|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"なんと、本気なのか！ 息子のところへ行ってくれ。さあ、急いで！ だが傷つけないでくれ！ あれは私の息子なんだ！","index":1},{"form_id":"0x000807|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"それと頼む！ このことは誰にも言わないでくれ！ 秘密にしておかねばならんのだ。","index":2},{"form_id":"0x00080F|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"この黒檀の刃を見つけた。呪われていると思う。"},{"form_id":"0x000810|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"見せてみろ。","index":1},{"form_id":"0x000810|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"それはデイドラのアーティファクトではないか！ 渡せ！","index":2},{"form_id":"0x000001|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"見せてみろ。","index":1},{"form_id":"0x000001|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"それはデイドラのアーティファクトではないか！ 渡せ！","index":2},{"form_id":"0x000811|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"もちろん。大事に持っていてくれ。"},{"form_id":"0x000812|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"賢明な判断だ。番人の間の宝物庫が、これを今後の誘惑から守るだろう。","index":1},{"form_id":"0x000813|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"賢明な判断だ。ステンダールの番人が、これを今後の誘惑から守るだろう。","index":1},{"form_id":"0x000814|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"考え直した、自分で持っておくことにする。"},{"form_id":"0x000815|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ならば、ステンダールの慈悲を受ける覚悟をしろ。","index":1},{"form_id":"0x000818|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"これでやっと、ここでも楽しめるぞ！ へへへ。","index":1},{"form_id":"0x000819|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ちょっと楽しんだだけだよ、それが何さ？","index":1},{"form_id":"0x00081A|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"王様を燃やせ！ それと首長も……はははは。","index":1},{"form_id":"0x00081B|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"いつか、あいつの顔を引き裂いてやる、見てなよ。今にわかるさ！ はははは。","index":1},{"form_id":"0x00081C|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"何かあったんだ。よく思い出せないけど……","index":1},{"form_id":"0x00081D|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"うーん……","index":1},{"form_id":"0x00081E|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"すごく疲れた……","index":1},{"form_id":"0x000820|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"友達が死んだの。あの子がいないと、もう前のようにはいかない。","index":1},{"form_id":"0x000822|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"血が……あんなにたくさんの血が！","index":1},{"form_id":"0x00081F|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"この建物で、私が掃除してない場所なんて一寸もないよ。","index":1},{"form_id":"0x000821|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"首長の息子さん……本当に気味が悪いんだから。","index":1},{"form_id":"0x00082A|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"ネルキルは助からなかった"},{"form_id":"0x00082B|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"息子が死んだ！ 出て行け、出て行って二度と戻ってくるな！ 衛兵、侵入者だ！","index":1},{"form_id":"0x000830|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"首長について何か言ってたよね?"},{"form_id":"0x000831|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"シーッ！ 私から聞いたって言わないでよ。バルグルーフ首長？ それがね……","index":1},{"form_id":"0x000831|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"首長のお子さんたちについて、妙な噂を耳にするのよ。一人は邪悪になりつつあって、他の子たちも不吉な顔つきをしてるって。","index":2},{"form_id":"0x000831|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"良くないことでしょ？ あの一家は呪われてるのよ、本当に！","index":3},{"form_id":"0x000834|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"宿屋ではいろんな話を耳にするだろう。面白い噂はある?"},{"form_id":"0x000835|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"シーッ！ 頼むから声を落としてくれ！","index":1},{"form_id":"0x000835|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ああ……首長のお子さんたちについて妙な噂を聞くんだ。一人は邪悪になりつつあって、他の子たちも不吉な顔つきをしてるってね。","index":2},{"form_id":"0x000835|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"関わらないのが一番だよ。","index":3},{"form_id":"0x000836|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"聞いた？ 首長のお子さんたちについて妙な噂があるの。関わらないのが一番よ！","index":1},{"form_id":"0x000D63|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"息子さんが地下室の扉の向こうでデイドラと話していた。"},{"form_id":"0x000D64|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"何だと？ ああ、まさか、そんな！ こんなことがあってたまるか！ あれは邪悪なものなんだ、本当だ！","index":1},{"form_id":"0x000D64|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"お前なら、これを終わらせられるかもしれん。扉の鍵だ。頼む、力を貸してくれ！","index":2},{"form_id":"0x000D65|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"扉の向こうには何が待っている?"},{"form_id":"0x000D66|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"古代の剣だ……わかるだろう……呪われている。囁くんだ。まともなものじゃない。","index":1},{"form_id":"0x000D66|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"そういうことには詳しくないが、それだけでは済まない何かがあるはずだ。","index":3},{"form_id":"0x000D66|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"あの剣はどうもおかしい、信じてくれ。馬鹿げて聞こえるのはわかっているが、本当なんだ。","index":2},{"form_id":"0x000D67|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"調べてみよう。"},{"form_id":"0x000D68|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ありがとう。それと、くれぐれも気をつけてくれ。次にあの扉に手を出したら何が起きるかわからん。","index":1},{"form_id":"0x000D85|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"息子さんは無事だ。ドラゴンズリーチの地下トンネルへ迎えを寄越してくれ。"},{"form_id":"0x000D86|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ああ、神々に感謝を！ これでようやく深く息ができる。さあ、感謝の印にこれを受け取ってくれ。","index":1},{"form_id":"0x000D87|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"死んだ召使いのことはどうするんだ？"},{"form_id":"0x000D88|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ああ……残念だ。後始末は誰かに任せよう。アーケイが我々を死と和解させてくださる。","index":1},{"form_id":"0x000D89|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"ネルキルはしたことの罰を受けるのか?"},{"form_id":"0x000D8A|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"何だと？！ 違う！ あんなことがあれば立ち直るのは難しい。あの子には癒える時間が必要なだけだ、それだけだ。","index":1},{"form_id":"0x000D8B|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"安心していい、もう全部終わった。剣は私が預かる"},{"form_id":"0x000D8C|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"このことは二度と口にしないと誓おう。いいな？ よし。もう心は十分に重い。さらばだ。","index":1},{"form_id":"0x000D8F|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"ネルキル…?"},{"form_id":"0x000D90|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ここにいてはいけない。今すぐ出て行け！","index":1},{"form_id":"0x000D91|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"あの女性を殺したのか? なぜ?"},{"form_id":"0x000D92|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"はははは。ああ、そうさ、やったよ。またやってやるさ。","index":1},{"form_id":"0x000D92|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"あいつ「お願い、お慈悲を、どうか！」なんて言ってさ。はははは、ちょっと楽しんだだけだよ、それが何さ？！","index":2},{"form_id":"0x000D93|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"剣に操られているんだ。それは本当のあなたじゃない。(説得)"},{"form_id":"0x000D9C|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ぼ……僕……あの女の声が聞こえるんだ。お願い、もう……止めてよ。","index":1},{"form_id":"0x000D94|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"剣に操られているんだ。それは本当のあなたじゃない。(説得)"},{"form_id":"0x000D9D|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"バカじゃないの。あっち行けよ！","index":1},{"form_id":"0x000D95|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"終わりだ、坊主。目を覚まして剣を渡せ。今すぐ!(威圧)"},{"form_id":"0x000D98|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"ぼ……僕……あの女の声が聞こえるんだ。お願い、もう……止めてよ。","index":1},{"form_id":"0x000D96|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"終わりだ、坊主。目を覚まして剣を渡せ。今すぐ!(威圧)"},{"form_id":"0x000D9B|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"いや、やだね。触るな！","index":1},{"form_id":"0x000D97|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"もうたくさんだ (気絶させる)"},{"form_id":"0x000D9E|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"何するつもりだよ？ うあっ！ やめろ！","index":1},{"form_id":"0x000D99|the whispering door - quest expansion.esp","type":"DIAL FULL","string":"いいから、剣を渡してくれ。"},{"form_id":"0x000D9A|the whispering door - quest expansion.esp","type":"INFO NAM1","string":"うん……なんだか……気分が……よくない……しばらく横になるよ……","index":1},{"form_id":"0x00080A|the whispering door - quest expansion.esp","type":"MESG DESC","string":"ネルキルは深い眠りに落ちているようだ。父親と話すべきだろう。"}]
[{"form_id":"0x000863|civil war lines expansion.esp","type":"INFO NAM1","string":"何をする!?　ああっ……分かった。今回だけだぞ！","index":1},{"form_id":"0x000908|civil war lines expansion.esp","type":"INFO NAM1","string":"ありがとう。もう痛みが引いてきた。","index":1},{"form_id":"0x00090A|civil war lines expansion.esp","type":"INFO NAM1","string":"もう楽になってきた。","index":1},{"form_id":"0x000909|civil war lines expansion.esp","type":"INFO NAM1","string":"正直に言うと、まだかなりひどい。","index":1},{"form_id":"0x00090B|civil war lines expansion.esp","type":"INFO NAM1","string":"神々の祝福を、治療師殿。","index":1},{"form_id":"0x000802|civil war lines expansion.esp","type":"INFO NAM1","string":"悪くない、悪くないな……","index":1},{"form_id":"0x00083D|civil war lines expansion.esp","type":"INFO NAM1","string":"それが軍団の精鋭か!?","index":1},{"form_id":"0x000864|civil war lines expansion.esp","type":"INFO NAM1","string":"叩きのめしてやる！","index":1},{"form_id":"0x000865|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか、ああ!?","index":1},{"form_id":"0x000891|civil war lines expansion.esp","type":"INFO NAM1","string":"間違いを犯しているぞ！","index":1},{"form_id":"0x0008AE|civil war lines expansion.esp","type":"INFO NAM1","string":"それが精一杯か!?","index":1},{"form_id":"0x000905|civil war lines expansion.esp","type":"INFO NAM1","string":"少々力不足のようだな!?","index":1},{"form_id":"0x000906|civil war lines expansion.esp","type":"INFO NAM1","string":"それだけか!?　まったく、退屈な奴だ。","index":1},{"form_id":"0x000950|civil war lines expansion.esp","type":"INFO NAM1","string":"それが最後の過ちだ。","index":1},{"form_id":"0x000804|civil war lines expansion.esp","type":"INFO NAM1","string":"何だと!?　そんな!!","index":1},{"form_id":"0x000872|civil war lines expansion.esp","type":"INFO NAM1","string":"神よ！　そんな！","index":1},{"form_id":"0x000873|civil war lines expansion.esp","type":"INFO NAM1","string":"やめろ、くそっ！","index":1},{"form_id":"0x000874|civil war lines expansion.esp","type":"INFO NAM1","string":"イスミールの髭にかけて！　突っ立ってないで、そいつを殺せ！","index":1},{"form_id":"0x000899|civil war lines expansion.esp","type":"INFO NAM1","string":"許さん！　ストームクロークは血には血で報いる！","index":1},{"form_id":"0x0008B3|civil war lines expansion.esp","type":"INFO NAM1","string":"何だと!?　許さん!!　ストームクロークは血には血で報いる！","index":1},{"form_id":"0x000952|civil war lines expansion.esp","type":"INFO NAM1","string":"神々よ！　そんな！","index":1},{"form_id":"0x000953|civil war lines expansion.esp","type":"INFO NAM1","string":"やめろぉ！　殺して……やる！","index":1},{"form_id":"0x0008AF|civil war lines expansion.esp","type":"INFO NAM1","string":"よし。やるべきことは山ほどある。","index":1},{"form_id":"0x000806|civil war lines expansion.esp","type":"INFO NAM1","string":"よし。おしゃべりの時間は終わりだ。","index":1},{"form_id":"0x00083E|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの密偵に目を光らせろ！","index":1},{"form_id":"0x00089A|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国軍に目を光らせておけ。","index":1},{"form_id":"0x0008B0|civil war lines expansion.esp","type":"INFO NAM1","string":"九大神のご加護を。","index":1},{"form_id":"0x0008B1|civil war lines expansion.esp","type":"INFO NAM1","string":"分かり合う者同士に、無駄な言葉は要らない。","index":1},{"form_id":"0x0008B2|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークに出くわしたら、私の分も十数人は殺してくれ！","index":1},{"form_id":"0x000955|civil war lines expansion.esp","type":"INFO NAM1","string":"テュリウス将軍がすべて掌握している。心配するな。","index":1},{"form_id":"0x000956|civil war lines expansion.esp","type":"INFO NAM1","string":"うーん。魔法使いやその呪文は好きになれん。","index":1},{"form_id":"0x000921|civil war lines expansion.esp","type":"INFO NAM1","string":"うっ……痛い……正直に言うと、まだかなりひどい……","index":1},{"form_id":"0x000809|civil war lines expansion.esp","type":"INFO NAM1","string":"*咳き込む*","index":1},{"form_id":"0x000812|civil war lines expansion.esp","type":"INFO NAM1","string":"あ……ぐあっ……","index":1},{"form_id":"0x000920|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあっ……痛い！","index":1},{"form_id":"0x000846|civil war lines expansion.esp","type":"INFO NAM1","string":"痛い……","index":1},{"form_id":"0x00087C|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあぁ……","index":1},{"form_id":"0x00087D|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあぁ……うぅ……","index":1},{"form_id":"0x00095F|civil war lines expansion.esp","type":"INFO NAM1","string":"気分が悪い…","index":1},{"form_id":"0x000808|civil war lines expansion.esp","type":"INFO NAM1","string":"目を光らせておけ。どこに危険が潜んでいるか分からん。","index":1},{"form_id":"0x00080F|civil war lines expansion.esp","type":"INFO NAM1","string":"スカイリムは帝国発祥の地だ。ならず者の集まりに、その血統を奪わせはしない。","index":1},{"form_id":"0x000810|civil war lines expansion.esp","type":"INFO NAM1","string":"戦に勝つのは兵士だ。だが、どこに配置するかが鍵になる……","index":1},{"form_id":"0x000811|civil war lines expansion.esp","type":"INFO NAM1","string":"戦いたくてうずうずしている。","index":1},{"form_id":"0x00080A|civil war lines expansion.esp","type":"INFO NAM1","string":"どうも気に入らないな。待ち伏せにはうってつけの場所だ……","index":1},{"form_id":"0x00080E|civil war lines expansion.esp","type":"INFO NAM1","string":"リフテンが皇帝に背くとは……ふん。忌々しいストームクロークの反乱者どもめ。","index":1},{"form_id":"0x00080B|civil war lines expansion.esp","type":"INFO NAM1","string":"おっと！　落ち着け！","index":1},{"form_id":"0x000847|civil war lines expansion.esp","type":"INFO NAM1","string":"ちょっと待ってくれ……息が切れた。","index":1},{"form_id":"0x000992|civil war lines expansion.esp","type":"INFO NAM1","string":"警戒を怠るな。ストームクロークの犬どもがいつ突撃してくるか分からん。","index":1},{"form_id":"0x00084A|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークの反乱者どもめ……","index":1},{"form_id":"0x000994|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークの反乱者どもめ……","index":1},{"form_id":"0x000849|civil war lines expansion.esp","type":"INFO NAM1","string":"父は軍団兵だった……その父もな。他の道なんて考えたこともなかったよ。","index":1},{"form_id":"0x000993|civil war lines expansion.esp","type":"INFO NAM1","string":"父は軍団兵だった……その父もな。他の道なんて考えたこともなかったよ。","index":1},{"form_id":"0x00084D|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークがリーチを取っただと？　タロスは本当に奴らの味方なのかもな……","index":1},{"form_id":"0x00084B|civil war lines expansion.esp","type":"INFO NAM1","string":"そのストームクロークの鎧、癇に障るな……","index":1},{"form_id":"0x000875|civil war lines expansion.esp","type":"INFO NAM1","string":"うぐ……この帝国の鎧、やたらと重いな。","index":1},{"form_id":"0x00084E|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しい不信心な帝国の連中め……","index":1},{"form_id":"0x00084F|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中は、我々に自分たちの法が必要だと思っている……ふん。","index":1},{"form_id":"0x000997|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の犬どもめ…あいつらはどんな卑劣なことでもやる。","index":1},{"form_id":"0x000850|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中は我々を無法の獣だと思っている。私がその無知の証拠だ。","index":1},{"form_id":"0x000851|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中がどこかに隠れていないだろうか……","index":1},{"form_id":"0x00087E|civil war lines expansion.esp","type":"INFO NAM1","string":"この危機の時代、軍団兵の一人一人が、いついかなる状況でも最善の自分でなければならない……","index":1},{"form_id":"0x00087F|civil war lines expansion.esp","type":"INFO NAM1","string":"少しずつ、我々はこの地に名誉をもたらしていく。","index":1},{"form_id":"0x000885|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国は人間の最後の砦だ。決して忘れるな。","index":1},{"form_id":"0x000886|civil war lines expansion.esp","type":"INFO NAM1","string":"両親は旅の商人で、最後はシロディールに落ち着いた。放浪癖はその血を受け継いだんだろうな。","index":1},{"form_id":"0x000884|civil war lines expansion.esp","type":"INFO NAM1","string":"私にとっての我が家とは、一日の終わりの温かいエール一杯と、戦いのない五分間だ。","index":1},{"form_id":"0x000883|civil war lines expansion.esp","type":"INFO NAM1","string":"これはスカイリムとその民のためにやっているんだ。決して忘れるな。","index":1},{"form_id":"0x00088B|civil war lines expansion.esp","type":"INFO NAM1","string":"剣の道は大戦で学んだ。帝都の外で危うく命を落とすところだった。","index":1},{"form_id":"0x000880|civil war lines expansion.esp","type":"INFO NAM1","string":"最も冷え込む夜には、吐く息の白さの中に、死者たちの数多の顔が見える。","index":1},{"form_id":"0x000888|civil war lines expansion.esp","type":"INFO NAM1","string":"我々は兄弟としてこの寒空の下に立っている。帝国の自由な市民すべての権利のために戦っている、その自覚に温められながら。","index":1},{"form_id":"0x000881|civil war lines expansion.esp","type":"INFO NAM1","string":"軍団はこの地の支配を取り戻す。覚えておけ。","index":1},{"form_id":"0x00088C|civil war lines expansion.esp","type":"INFO NAM1","string":"この反乱は必ず鎮圧する。そうしなければならないんだ。","index":1},{"form_id":"0x000887|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国は安定をもたらした。ウルフリックも権力欲に目がくらんでいなければ、我々が同じ側だと分かるだろうに。","index":1},{"form_id":"0x000882|civil war lines expansion.esp","type":"INFO NAM1","string":"西のフォースウォーンは洞窟に住んでいるらしい。ウィンドヘルムで暮らそうとするよりはましだろうな。","index":1},{"form_id":"0x000889|civil war lines expansion.esp","type":"INFO NAM1","string":"少し息をつけ、友よ。","index":1},{"form_id":"0x00088A|civil war lines expansion.esp","type":"INFO NAM1","string":"言っておくが、この地方は統制を失いつつある。山賊どもは日に日に図々しくなっている。","index":1},{"form_id":"0x00088D|civil war lines expansion.esp","type":"INFO NAM1","string":"ウィンドヘルムはどうも好きになれない。気が滅入る場所だ。","index":1},{"form_id":"0x0008A4|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの密偵に目を光らせておけ。","index":1},{"form_id":"0x0008A5|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークなど武装した暴徒にすぎん。この戦争もそう長くは続かないだろう。","index":1},{"form_id":"0x0008A6|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中は、我々の邪魔をしたことを後悔するだろう。","index":1},{"form_id":"0x0008AA|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国は倒れる……そして我々が立ち上がるのだ！","index":1},{"form_id":"0x0008A8|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の犬どもめ。奴らにできない卑劣な真似などない。","index":1},{"form_id":"0x0008A9|civil war lines expansion.esp","type":"INFO NAM1","string":"ふん。帝国の乳飲み子どもめ！","index":1},{"form_id":"0x0008A7|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国のクズめ。","index":1},{"form_id":"0x000848|civil war lines expansion.esp","type":"INFO NAM1","string":"警戒を怠るな。ストームクロークの犬どもがいつ突撃してくるか分からん。","index":1},{"form_id":"0x0008CA|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークなど武装した暴徒にすぎん。","index":1},{"form_id":"0x0008CB|civil war lines expansion.esp","type":"INFO NAM1","string":"ドラゴンにストームクローク、まったく困った時代だ。","index":1},{"form_id":"0x0008CC|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークの反乱者どもめ……一人残らずな。","index":1},{"form_id":"0x0008CD|civil war lines expansion.esp","type":"INFO NAM1","string":"生まれてこの方ずっと軍団にいる。仕えることに満足しているよ。","index":1},{"form_id":"0x0008D0|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの裏切り者みたいな格好でうろつくとは、どういうつもりだ。","index":1},{"form_id":"0x0008CF|civil war lines expansion.esp","type":"INFO NAM1","string":"こうして突っ立っているのはくだらん。こちらからストームクロークに攻め込むべきだ。","index":1},{"form_id":"0x0008D1|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークめ。オブリビオンに落ちろ！　一人残らずな。","index":1},{"form_id":"0x0008CE|civil war lines expansion.esp","type":"INFO NAM1","string":"ウルフリック・ストームクロークが!?　正統な上級王だと？　はっはっは。笑わせる。","index":1},{"form_id":"0x0008D3|civil war lines expansion.esp","type":"INFO NAM1","string":"スカイリムにお前らの居場所はない……忌々しい物見遊山どもめ。","index":1},{"form_id":"0x00099B|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークにリーチを奪われた。だが必ず戻ってくる。帝国が秩序をもたらすのだ。","index":1},{"form_id":"0x0008D2|civil war lines expansion.esp","type":"INFO NAM1","string":"スカイリムにはよそ者がもう十分いるってのに……","index":1},{"form_id":"0x0008D4|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しい不信心な帝国の連中め……一人残らずな。","index":1},{"form_id":"0x0008D6|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国は我々をサルモールの奴隷にするつもりだ。","index":1},{"form_id":"0x0008D9|civil war lines expansion.esp","type":"INFO NAM1","string":"人は、命を懸けられるもののために生きるものだ……","index":1},{"form_id":"0x0008DA|civil war lines expansion.esp","type":"INFO NAM1","string":"じきにスカイリムからエルフどもを追い出してやる。奴らの忌々しい司法高官も、奴らの言いなりの首長たちもな。一人残らずだ。","index":1},{"form_id":"0x0008D8|civil war lines expansion.esp","type":"INFO NAM1","string":"あの腰抜けの帝国の連中は、サルモールにひれ伏した時に人間であることを捨てたんだ。","index":1},{"form_id":"0x0008D5|civil war lines expansion.esp","type":"INFO NAM1","string":"いい度胸だな……帝国の軍団兵みたいな格好でここをうろつくとは。","index":1},{"form_id":"0x0008D7|civil war lines expansion.esp","type":"INFO NAM1","string":"スカイリムにお前らは用無しだ、オーク。","index":1},{"form_id":"0x0008DB|civil war lines expansion.esp","type":"INFO NAM1","string":"我々こそスカイリムの真の息子と娘だ。そしてウルフリック。あの方こそ誰よりも真のスカイリムの子だ。","index":1},{"form_id":"0x0008DC|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークは各地で勝利を収めている。いいぞ！","index":1},{"form_id":"0x0008DD|civil war lines expansion.esp","type":"INFO NAM1","string":"ホワイトランは今や真のスカイリムの息子達のものだ。当然のことだな。","index":1},{"form_id":"0x0008DE|civil war lines expansion.esp","type":"INFO NAM1","string":"また静かな一日だ……","index":1},{"form_id":"0x0008DF|civil war lines expansion.esp","type":"INFO NAM1","string":"ひどい冬だ。最後にこんなに寒かったのがいつだったか思い出せない……しかもこんなに長く。","index":1},{"form_id":"0x0008E0|civil war lines expansion.esp","type":"INFO NAM1","string":"あと数時間で毛皮にくるまれる。","index":1},{"form_id":"0x0008E1|civil war lines expansion.esp","type":"INFO NAM1","string":"聞こえたか？　確かに何かいる……暗闇の中に。","index":1},{"form_id":"0x000922|civil war lines expansion.esp","type":"INFO NAM1","string":"反乱者どもが我々に勝てると思っているなら、考えを改めることになるだろう。","index":1},{"form_id":"0x000923|civil war lines expansion.esp","type":"INFO NAM1","string":"早く反乱者どもの腹をかっさばいてやりたい……","index":1},{"form_id":"0x000924|civil war lines expansion.esp","type":"INFO NAM1","string":"早くまたウルフリックの手下を殺してやりたい……","index":1},{"form_id":"0x000925|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークどもがこんなに……落ち着かないな。","index":1},{"form_id":"0x000926|civil war lines expansion.esp","type":"INFO NAM1","string":"外交には大賛成だが……帝国が内戦の後始末を早く終えれば、それだけ早くシロディールに帰れるんだ。","index":1},{"form_id":"0x000927|civil war lines expansion.esp","type":"INFO NAM1","string":"厄介事に目を光らせておけ。時間の問題だからな。","index":1},{"form_id":"0x000928|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しい反乱者どもめ……","index":1},{"form_id":"0x000929|civil war lines expansion.esp","type":"INFO NAM1","string":"うーん……さっきから影の中で何かが動いている気がする……","index":1},{"form_id":"0x00092A|civil war lines expansion.esp","type":"INFO NAM1","string":"ソリチュードは噂どおり壮麗な街だ。私が育ったファルクリースとは大違いだな。","index":1},{"form_id":"0x00092B|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークめ……この街には帝国軍がうじゃうじゃいるってのに、どうだ？　それでも落ち着かない。","index":1},{"form_id":"0x00092C|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークめ……この街には帝国軍がうじゃうじゃいるってのに、どうだ？　それでも落ち着かない。","index":1},{"form_id":"0x00092D|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークめ……この街には帝国軍がうじゃうじゃいるってのに、どうだ？　それでも落ち着かない。","index":1},{"form_id":"0x00092E|civil war lines expansion.esp","type":"INFO NAM1","string":"矢を受けたところがまだ痛む。弓兵は大嫌いだ。","index":1},{"form_id":"0x00092F|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークめ。落ち着かない。奴らがソリチュードを支配するなんて、夢にも思わなかった。","index":1},{"form_id":"0x000930|civil war lines expansion.esp","type":"INFO NAM1","string":"退屈で仕方ない。ここ数週間で戦いはたった一度だけ。気が変になりそうだ。","index":1},{"form_id":"0x000931|civil war lines expansion.esp","type":"INFO NAM1","string":"反乱者どもが忘れたがっているのは、帝国こそがアルドメリ自治領をスカイリムから締め出しているという事実だ。","index":1},{"form_id":"0x000932|civil war lines expansion.esp","type":"INFO NAM1","string":"魔法使いか……取り締まる法律があるべきだな。","index":1},{"form_id":"0x000960|civil war lines expansion.esp","type":"INFO NAM1","string":"八大神にかけて、腹ペコだ！","index":1},{"form_id":"0x000970|civil war lines expansion.esp","type":"INFO NAM1","string":"腹が減った…","index":1},{"form_id":"0x000961|civil war lines expansion.esp","type":"INFO NAM1","string":"ここはちょっと暗いな…","index":1},{"form_id":"0x000967|civil war lines expansion.esp","type":"INFO NAM1","string":"影の中で何かが動いているような気がしてならない…","index":1},{"form_id":"0x000962|civil war lines expansion.esp","type":"INFO NAM1","string":"パンとシチュー？ 神々よ、またか！ 今度はホーカーにしてくれないか！？ あれ、うまいんだぞ！","index":1},{"form_id":"0x000963|civil war lines expansion.esp","type":"INFO NAM1","string":"最後に故郷へ帰ったのがいつだったか思い出せない。まともなベッドがどんなものか忘れてしまったよ。寝心地なんて…なおさらだ。","index":1},{"form_id":"0x000966|civil war lines expansion.esp","type":"INFO NAM1","string":"畑仕事なんて退屈なもんだ。斧を振るう方がずっといい。","index":1},{"form_id":"0x000964|civil war lines expansion.esp","type":"INFO NAM1","string":"フォースウォーンってのは妙な連中だ。まるで野蛮人のような暮らしをしている。","index":1},{"form_id":"0x000965|civil war lines expansion.esp","type":"INFO NAM1","string":"いつかスカイリムから腐敗がなくなるといいんだが…そしてみんなが平和に暮らせるように。","index":1},{"form_id":"0x000968|civil war lines expansion.esp","type":"INFO NAM1","string":"ああ。まだ青二才だが…経験が足りない分は、勇気で補ってみせる。","index":1},{"form_id":"0x00096C|civil war lines expansion.esp","type":"INFO NAM1","string":"みんな兵士になるには若すぎると思ってる。でも、それが間違いだと証明してみせる。","index":1},{"form_id":"0x000969|civil war lines expansion.esp","type":"INFO NAM1","string":"最初は畑仕事が恋しくなると思ってた。もう十分やり尽くしたんだろうな、まったく恋しくないよ。","index":1},{"form_id":"0x00096A|civil war lines expansion.esp","type":"INFO NAM1","string":"父は兵士だった。大戦で戦ったんだ。その伝統をできる限り受け継ぐつもりだ。","index":1},{"form_id":"0x00096B|civil war lines expansion.esp","type":"INFO NAM1","string":"戦争日和のいい天気だな、そう思わないか？","index":1},{"form_id":"0x00096F|civil war lines expansion.esp","type":"INFO NAM1","string":"ああ、なんていい日だ！ この空気を吸ってみろ！ 最高だろう？","index":1},{"form_id":"0x00096E|civil war lines expansion.esp","type":"INFO NAM1","string":"待つのはもううんざりだ。いつになったら戦いがあるんだ！？","index":1},{"form_id":"0x00096D|civil war lines expansion.esp","type":"INFO NAM1","string":"死んだら…よろよろ歩く死体にだけはなりたくないな。","index":1},{"form_id":"0x000978|civil war lines expansion.esp","type":"INFO NAM1","string":"タイバー・セプティムもここで戦ったことがあると思うか？ つまり…ここでだぞ！ すごいな…","index":1},{"form_id":"0x000974|civil war lines expansion.esp","type":"INFO NAM1","string":"殺した相手が夢に出てくることはあるか？ こっちはあるよ…","index":1},{"form_id":"0x000971|civil war lines expansion.esp","type":"INFO NAM1","string":"なあ…夜、目を閉じると…まだそこにいるみたいに、目の前に戦場が広がって見えることがあるんだ。","index":1},{"form_id":"0x000972|civil war lines expansion.esp","type":"INFO NAM1","string":"うーむ…矢の蓄えが少し心もとなくなってきたな。","index":1},{"form_id":"0x000973|civil war lines expansion.esp","type":"INFO NAM1","string":"あのアルゴニアン、何か企んでるぞ。","index":1},{"form_id":"0x000975|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークに我々は止められない。","index":1},{"form_id":"0x00097A|civil war lines expansion.esp","type":"INFO NAM1","string":"ウルフリックが気にかけてるのはただ一つ。ウルフリック自身だけだ。反吐が出る。","index":1},{"form_id":"0x00097B|civil war lines expansion.esp","type":"INFO NAM1","string":"ウルフリック…あの男は嘘そのものだ。胸の内にあるのは玉座への欲望だけさ。","index":1},{"form_id":"0x000977|civil war lines expansion.esp","type":"INFO NAM1","string":"この新しい鎧、体にぴったりだ。","index":1},{"form_id":"0x000976|civil war lines expansion.esp","type":"INFO NAM1","string":"暗い時代だ…だが少なくとも、世の中を良くするために自分たちの役目を果たしているのは確かだろ？","index":1},{"form_id":"0x000979|civil war lines expansion.esp","type":"INFO NAM1","string":"木々が…ここのは美しいな。故郷の秋を思い出すよ。","index":1},{"form_id":"0x00099E|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあっ……痛い！","index":1},{"form_id":"0x00099F|civil war lines expansion.esp","type":"INFO NAM1","string":"痛い……","index":1},{"form_id":"0x0009A0|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあぁ……","index":1},{"form_id":"0x0009A1|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐあぁ……うぅ……","index":1},{"form_id":"0x00099A|civil war lines expansion.esp","type":"INFO NAM1","string":"うっ……痛い……正直に言うと、まだかなりひどい……","index":1},{"form_id":"0x0009A2|civil war lines expansion.esp","type":"INFO NAM1","string":"気分が悪い…","index":1},{"form_id":"0x00099D|civil war lines expansion.esp","type":"INFO NAM1","string":"あ……ぐあっ……","index":1},{"form_id":"0x00099C|civil war lines expansion.esp","type":"INFO NAM1","string":"(咳き込む)","index":1},{"form_id":"0x00080C|civil war lines expansion.esp","type":"INFO NAM1","string":"おっと！　落ち着け！","index":1},{"form_id":"0x00083F|civil war lines expansion.esp","type":"INFO NAM1","string":"その鎧からすると、帝国の斥候だな。そうなら、よく来てくれた！","index":1},{"form_id":"0x000840|civil war lines expansion.esp","type":"INFO NAM1","string":"見事な帝国の鎧を着ているな。","index":1},{"form_id":"0x000841|civil war lines expansion.esp","type":"INFO NAM1","string":"そのストームクロークの鎧、癇に障るな……","index":1},{"form_id":"0x000842|civil war lines expansion.esp","type":"INFO NAM1","string":"何の用だ、帝国の者よ？","index":1},{"form_id":"0x000843|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の鎧を着て話しかけてくるとは!?　頭の中にシチューでも詰まってるのか？","index":1},{"form_id":"0x000844|civil war lines expansion.esp","type":"INFO NAM1","string":"そのストームクロークの鎧、よく似合ってるな、友よ。","index":1},{"form_id":"0x00084C|civil war lines expansion.esp","type":"INFO NAM1","string":"そのストームクロークの鎧、癇に障るな……","index":1},{"form_id":"0x000876|civil war lines expansion.esp","type":"INFO NAM1","string":"大事な用なんだろうな。","index":1},{"form_id":"0x00087A|civil war lines expansion.esp","type":"INFO NAM1","string":"警戒を怠るな。ストームクロークの犬どもがいつ突撃してくるか分からん。","index":1},{"form_id":"0x000877|civil war lines expansion.esp","type":"INFO NAM1","string":"見ない顔だな……見張っているぞ。","index":1},{"form_id":"0x000878|civil war lines expansion.esp","type":"INFO NAM1","string":"何か手助けが必要なのか？　今は忙しい時期なんだ。","index":1},{"form_id":"0x000879|civil war lines expansion.esp","type":"INFO NAM1","string":"自分の名誉をそんなに安く扱う者とは話したくないな……","index":1},{"form_id":"0x00087B|civil war lines expansion.esp","type":"INFO NAM1","string":"少し息をつけ、友よ！","index":1},{"form_id":"0x0008B4|civil war lines expansion.esp","type":"INFO NAM1","string":"何の用でここへ？","index":1},{"form_id":"0x0008B5|civil war lines expansion.esp","type":"INFO NAM1","string":"リバーウッドは我々が守る。任せておけ。","index":1},{"form_id":"0x0008B6|civil war lines expansion.esp","type":"INFO NAM1","string":"お前が味方でよかった。","index":1},{"form_id":"0x0008B7|civil war lines expansion.esp","type":"INFO NAM1","string":"お前が味方でよかった。","index":1},{"form_id":"0x0008B8|civil war lines expansion.esp","type":"INFO NAM1","string":"目を光らせているからな。","index":1},{"form_id":"0x0008B9|civil war lines expansion.esp","type":"INFO NAM1","string":"ここに何か公的な用でもあるのか？","index":1},{"form_id":"0x0008BA|civil war lines expansion.esp","type":"INFO NAM1","string":"それは何の杖だ？","index":1},{"form_id":"0x0008BB|civil war lines expansion.esp","type":"INFO NAM1","string":"その盾……ドワーフ製じゃないか？","index":1},{"form_id":"0x0008BC|civil war lines expansion.esp","type":"INFO NAM1","string":"その鎧からすると、帝国の斥候だな。そうなら、よく来てくれた！","index":1},{"form_id":"0x0008BD|civil war lines expansion.esp","type":"INFO NAM1","string":"身のためにも、その鎧は帝国の斥候の死体から奪った物であってほしいものだな。","index":1},{"form_id":"0x0008BE|civil war lines expansion.esp","type":"INFO NAM1","string":"見事な帝国の鎧を着ているな。","index":1},{"form_id":"0x0008BF|civil war lines expansion.esp","type":"INFO NAM1","string":"薄汚いストームクロークの皮をまとって、ここをうろつくとはいい度胸だな？","index":1},{"form_id":"0x0008C0|civil war lines expansion.esp","type":"INFO NAM1","string":"妙な気を起こすなよ、猫め。","index":1},{"form_id":"0x0008C5|civil war lines expansion.esp","type":"INFO NAM1","string":"面倒は起こすなよ、カジート。","index":1},{"form_id":"0x0008C8|civil war lines expansion.esp","type":"INFO NAM1","string":"面倒は起こすなよ、オーク。","index":1},{"form_id":"0x0008C6|civil war lines expansion.esp","type":"INFO NAM1","string":"面倒は起こすなよ、レッドガード。","index":1},{"form_id":"0x0008C7|civil war lines expansion.esp","type":"INFO NAM1","string":"面倒は起こすなよ、インペリアル。","index":1},{"form_id":"0x0008C1|civil war lines expansion.esp","type":"INFO NAM1","string":"何か盗むところを見つけたら、首をへし折ってやる……猫め！","index":1},{"form_id":"0x0008C2|civil war lines expansion.esp","type":"INFO NAM1","string":"真のノルドの装いをしているな。敬意を表する。","index":1},{"form_id":"0x0008C3|civil war lines expansion.esp","type":"INFO NAM1","string":"なぜエルフの剣なんだ、ええ!?　ノルドの鋼じゃ不満か？","index":1},{"form_id":"0x0008C4|civil war lines expansion.esp","type":"INFO NAM1","string":"面倒は起こすなよ、エルフ。","index":1},{"form_id":"0x0008C9|civil war lines expansion.esp","type":"INFO NAM1","string":"逆らうなよ、エルフ。","index":1},{"form_id":"0x00090C|civil war lines expansion.esp","type":"INFO NAM1","string":"建物を間違えて迷い込んだんじゃないか、友よ。","index":1},{"form_id":"0x000914|civil war lines expansion.esp","type":"INFO NAM1","string":"お前みたいな乳飲み子がこんなところで何をしている？","index":1},{"form_id":"0x000912|civil war lines expansion.esp","type":"INFO NAM1","string":"すべて順調だ。","index":1},{"form_id":"0x000913|civil war lines expansion.esp","type":"INFO NAM1","string":"最近はホワイトランへの道も安全じゃない。気を抜くなよ。","index":1},{"form_id":"0x000957|civil war lines expansion.esp","type":"INFO NAM1","string":"お前はここにいるべき者じゃなさそうだな。","index":1},{"form_id":"0x000958|civil war lines expansion.esp","type":"INFO NAM1","string":"気を抜くな。反乱者どもがどこに潜んでいるか分からん。","index":1},{"form_id":"0x000959|civil war lines expansion.esp","type":"INFO NAM1","string":"くそっ、おい。我々を挑発してるのか!?","index":1},{"form_id":"0x00095A|civil war lines expansion.esp","type":"INFO NAM1","string":"くそっ、女め。我々を挑発してるつもりか！？","index":1},{"form_id":"0x00095B|civil war lines expansion.esp","type":"INFO NAM1","string":"どうも…落ち着かないな。何か用か？","index":1},{"form_id":"0x000814|civil war lines expansion.esp","type":"INFO NAM1","string":"やめろ!!　もういい！","index":1},{"form_id":"0x0008F9|civil war lines expansion.esp","type":"INFO NAM1","string":"頼む、お慈悲を！","index":1},{"form_id":"0x0008FA|civil war lines expansion.esp","type":"INFO NAM1","string":"もういい！　やめろ！","index":1},{"form_id":"0x0008FB|civil war lines expansion.esp","type":"INFO NAM1","string":"降参だ！　降参する、ストームクローク！","index":1},{"form_id":"0x000988|civil war lines expansion.esp","type":"INFO NAM1","string":"お願いだ、慈悲を、頼む！","index":1},{"form_id":"0x000816|civil war lines expansion.esp","type":"INFO NAM1","string":"覚悟はできているだろうな。","index":1},{"form_id":"0x000823|civil war lines expansion.esp","type":"INFO NAM1","string":"いいだろう、やる気か？　それが最後の過ちだ。","index":1},{"form_id":"0x000817|civil war lines expansion.esp","type":"INFO NAM1","string":"後悔することになるぞ。","index":1},{"form_id":"0x00081A|civil war lines expansion.esp","type":"INFO NAM1","string":"おやおや。また踏み潰してやる蛆虫が来たか。","index":1},{"form_id":"0x00081D|civil war lines expansion.esp","type":"INFO NAM1","string":"私が怖がるとでも？　あんたの手に負える女じゃないよ。かかってきな！","index":1},{"form_id":"0x00081C|civil war lines expansion.esp","type":"INFO NAM1","string":"血を流させてやれ！","index":1},{"form_id":"0x000819|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいストームクロークの反乱者どもめ……皆殺しにしろ！","index":1},{"form_id":"0x00081F|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！","index":1},{"form_id":"0x000820|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　薄汚い裏切り者どもめ！","index":1},{"form_id":"0x000822|civil war lines expansion.esp","type":"INFO NAM1","string":"本物の兵士ってものを反乱者どもに見せてやろう。","index":1},{"form_id":"0x00081E|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークどもを逃がすな！","index":1},{"form_id":"0x000854|civil war lines expansion.esp","type":"INFO NAM1","string":"ドラゴン!?　ドラゴンだ！　神よ、お助けを！","index":1},{"form_id":"0x000855|civil war lines expansion.esp","type":"INFO NAM1","string":"軍団だ！","index":1},{"form_id":"0x000857|civil war lines expansion.esp","type":"INFO NAM1","string":"軍団が来たぞ！","index":1},{"form_id":"0x000858|civil war lines expansion.esp","type":"INFO NAM1","string":"自由か、ソブンガルデか！","index":1},{"form_id":"0x00085B|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の犬どもめ！","index":1},{"form_id":"0x000866|civil war lines expansion.esp","type":"INFO NAM1","string":"ドラゴン……","index":1},{"form_id":"0x000868|civil war lines expansion.esp","type":"INFO NAM1","string":"来い、お前の実力を見せてみろ！","index":1},{"form_id":"0x00086A|civil war lines expansion.esp","type":"INFO NAM1","string":"やっと静かな一日になると思ったのに……","index":1},{"form_id":"0x000867|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しい反乱者どもめ！","index":1},{"form_id":"0x00086B|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！","index":1},{"form_id":"0x00086C|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　反乱者どもめ……殺せ！","index":1},{"form_id":"0x00086D|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x00086E|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国から汚物を一掃する時だ！","index":1},{"form_id":"0x000870|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか!?　なら皇帝の怒りを思い知れ！","index":1},{"form_id":"0x000871|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか!?　望むところだ……","index":1},{"form_id":"0x00086F|civil war lines expansion.esp","type":"INFO NAM1","string":"吸血鬼だ！　焼き払え！","index":1},{"form_id":"0x00089B|civil war lines expansion.esp","type":"INFO NAM1","string":"いよいよだ。ストームクロークどもの実力を見せてもらおう！","index":1},{"form_id":"0x00089C|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x00089E|civil war lines expansion.esp","type":"INFO NAM1","string":"それが運命なら、戦って死ぬまでだ。勝利か、ソブンガルデか!!","index":1},{"form_id":"0x0008EA|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか？　来い。首をへし折ってやる。","index":1},{"form_id":"0x0008EB|civil war lines expansion.esp","type":"INFO NAM1","string":"いいだろう、やる気か!?","index":1},{"form_id":"0x0008EC|civil war lines expansion.esp","type":"INFO NAM1","string":"うおおっ！　行くぞ、勝てる相手だ！","index":1},{"form_id":"0x0008EE|civil war lines expansion.esp","type":"INFO NAM1","string":"突っ立ってないで、その女を殺せ！","index":1},{"form_id":"0x0008F4|civil war lines expansion.esp","type":"INFO NAM1","string":"行くぞ。ストームクロークどもの実力を見せてもらおう。","index":1},{"form_id":"0x0008ED|civil war lines expansion.esp","type":"INFO NAM1","string":"おやおや。また踏み潰してやる蛆虫が来たか。","index":1},{"form_id":"0x0008EF|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか？　来い。実力を見せてみろ。","index":1},{"form_id":"0x00097F|civil war lines expansion.esp","type":"INFO NAM1","string":"山賊も盗人もくたばれ！","index":1},{"form_id":"0x0008F2|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しい反乱者どもめ！　オブリビオンに落ちろ、一人残らずな！","index":1},{"form_id":"0x0008F3|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国から汚物を一掃する時だ！","index":1},{"form_id":"0x000984|civil war lines expansion.esp","type":"INFO NAM1","string":"スプリガンだ！ うえっ！","index":1},{"form_id":"0x0008F5|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x000980|civil war lines expansion.esp","type":"INFO NAM1","string":"ドラウグルか…くそ、あいつらは大嫌いだ。","index":1},{"form_id":"0x0008F6|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国に災いあれ！","index":1},{"form_id":"0x0008F7|civil war lines expansion.esp","type":"INFO NAM1","string":"スカイリムの息子達のために！","index":1},{"form_id":"0x0008F8|civil war lines expansion.esp","type":"INFO NAM1","string":"タロスよ、お救いを。ドラゴンだ！","index":1},{"form_id":"0x000933|civil war lines expansion.esp","type":"INFO NAM1","string":"本気の勝負がしたいのか、ああ!?","index":1},{"form_id":"0x000934|civil war lines expansion.esp","type":"INFO NAM1","string":"雲の中にいるぞ！","index":1},{"form_id":"0x000982|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！ ドラウグルだ！","index":1},{"form_id":"0x000935|civil war lines expansion.esp","type":"INFO NAM1","string":"八大神にかけて、こいつは一体何なんだ？","index":1},{"form_id":"0x000936|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国から汚物を一掃する時だ！","index":1},{"form_id":"0x000938|civil war lines expansion.esp","type":"INFO NAM1","string":"このクズどもに思い知らせてやろう。","index":1},{"form_id":"0x00093E|civil war lines expansion.esp","type":"INFO NAM1","string":"武器を取れ、兄弟たち！","index":1},{"form_id":"0x000939|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x00093D|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x00093A|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！","index":1},{"form_id":"0x00093B|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　薄汚い裏切り者どもめ！","index":1},{"form_id":"0x00093C|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x00093F|civil war lines expansion.esp","type":"INFO NAM1","string":"吸血鬼だ！　武器を取れ！","index":1},{"form_id":"0x000940|civil war lines expansion.esp","type":"INFO NAM1","string":"ウェアウルフだ！　化け物を殺せ！","index":1},{"form_id":"0x00097E|civil war lines expansion.esp","type":"INFO NAM1","string":"うおおっ！ さあ来い！ やれるぞ！","index":1},{"form_id":"0x000985|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！　かかれ！","index":1},{"form_id":"0x000983|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！ ストームクロークだ…","index":1},{"form_id":"0x000986|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークだ！","index":1},{"form_id":"0x000981|civil war lines expansion.esp","type":"INFO NAM1","string":"死にたいのなら、望み通りにしてやる。","index":1},{"form_id":"0x000987|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国から汚物を一掃する時だ！","index":1},{"form_id":"0x000825|civil war lines expansion.esp","type":"INFO NAM1","string":"もう強がれないだろう？","index":1},{"form_id":"0x000828|civil war lines expansion.esp","type":"INFO NAM1","string":"怖がるとでも思ったか!?　とんだ大馬鹿者だ！","index":1},{"form_id":"0x000826|civil war lines expansion.esp","type":"INFO NAM1","string":"軍団を侮辱する気か!?","index":1},{"form_id":"0x000827|civil war lines expansion.esp","type":"INFO NAM1","string":"来い！　抵抗してみせろ！","index":1},{"form_id":"0x00082F|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！　ウッドエルフだ！","index":1},{"form_id":"0x000832|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！　トカゲだ！","index":1},{"form_id":"0x000830|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！　オークだ！","index":1},{"form_id":"0x000831|civil war lines expansion.esp","type":"INFO NAM1","string":"気をつけろ！　レッドガードだ！","index":1},{"form_id":"0x00085C|civil war lines expansion.esp","type":"INFO NAM1","string":"愚か者め！　帝国軍がお前の血を流させてやる！","index":1},{"form_id":"0x000892|civil war lines expansion.esp","type":"INFO NAM1","string":"さっさと終わらせよう。","index":1},{"form_id":"0x000893|civil war lines expansion.esp","type":"INFO NAM1","string":"来い！　お前の実力を見せてみろ！","index":1},{"form_id":"0x000894|civil war lines expansion.esp","type":"INFO NAM1","string":"お前に勝ち目はない！","index":1},{"form_id":"0x0008FC|civil war lines expansion.esp","type":"INFO NAM1","string":"お前じゃ相手にならん、間抜けめ！","index":1},{"form_id":"0x0008FD|civil war lines expansion.esp","type":"INFO NAM1","string":"愚か者め！　帝国軍がお前の血を流させてやる！","index":1},{"form_id":"0x0008FE|civil war lines expansion.esp","type":"INFO NAM1","string":"お前のような反乱者のクズを、軍団はこう扱うんだ。","index":1},{"form_id":"0x0008FF|civil war lines expansion.esp","type":"INFO NAM1","string":"軍団を侮辱する気か!?　愚かな真似を！","index":1},{"form_id":"0x000941|civil war lines expansion.esp","type":"INFO NAM1","string":"うおおっ！　行くぞ、勝てる相手だ！","index":1},{"form_id":"0x000944|civil war lines expansion.esp","type":"INFO NAM1","string":"かかれ、殺せ！","index":1},{"form_id":"0x000942|civil war lines expansion.esp","type":"INFO NAM1","string":"来い。実力を見せてみろ。","index":1},{"form_id":"0x000943|civil war lines expansion.esp","type":"INFO NAM1","string":"薄汚い裏切り者どもめ！","index":1},{"form_id":"0x000945|civil war lines expansion.esp","type":"INFO NAM1","string":"一体全体どうすればこいつを殺せるんだ？","index":1},{"form_id":"0x000946|civil war lines expansion.esp","type":"INFO NAM1","string":"この化け物はどうすれば死ぬんだ!?","index":1},{"form_id":"0x00094E|civil war lines expansion.esp","type":"INFO NAM1","string":"奴をやれ！","index":1},{"form_id":"0x00094F|civil war lines expansion.esp","type":"INFO NAM1","string":"あの女をやれ！","index":1},{"form_id":"0x000989|civil war lines expansion.esp","type":"INFO NAM1","string":"死を望むなら…くれてやる！","index":1},{"form_id":"0x00098A|civil war lines expansion.esp","type":"INFO NAM1","string":"手早く済ませてやる。来い！","index":1},{"form_id":"0x00098C|civil war lines expansion.esp","type":"INFO NAM1","string":"この薄汚いコソ泥トカゲめ！","index":1},{"form_id":"0x0009A3|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、化け物！","index":1},{"form_id":"0x00098B|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国軍がお前の血を流させてやる！","index":1},{"form_id":"0x000995|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークは血には血で報いる！","index":1},{"form_id":"0x000837|civil war lines expansion.esp","type":"INFO NAM1","string":"それがウルフリックの精鋭か!?","index":1},{"form_id":"0x000836|civil war lines expansion.esp","type":"INFO NAM1","string":"はっ。また乳飲み子か。","index":1},{"form_id":"0x000838|civil war lines expansion.esp","type":"INFO NAM1","string":"これが軍団の戦い方だ。","index":1},{"form_id":"0x00083A|civil war lines expansion.esp","type":"INFO NAM1","string":"おや、もう自信満々じゃないようだな。","index":1},{"form_id":"0x00083B|civil war lines expansion.esp","type":"INFO NAM1","string":"さて、これで片付いた。","index":1},{"form_id":"0x000839|civil war lines expansion.esp","type":"INFO NAM1","string":"勝利だ……今のところはな。","index":1},{"form_id":"0x00083C|civil war lines expansion.esp","type":"INFO NAM1","string":"それが軍団の精鋭か!?","index":1},{"form_id":"0x00085E|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国のクズどもを殺すのは何度やっても飽きないな。","index":1},{"form_id":"0x00085F|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の犬どもめ。奴らにできない卑劣な真似などない。","index":1},{"form_id":"0x000998|civil war lines expansion.esp","type":"INFO NAM1","string":"今日もまた勝利だ。","index":1},{"form_id":"0x00085D|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの裏切り者どもを叩き潰してやった。","index":1},{"form_id":"0x000895|civil war lines expansion.esp","type":"INFO NAM1","string":"情けない話だ。","index":1},{"form_id":"0x000897|civil war lines expansion.esp","type":"INFO NAM1","string":"それがウルフリックの精鋭だと!?","index":1},{"form_id":"0x000896|civil war lines expansion.esp","type":"INFO NAM1","string":"もっとうまくやれたはずだがな。","index":1},{"form_id":"0x000898|civil war lines expansion.esp","type":"INFO NAM1","string":"やれやれ……嫌な仕事だった。","index":1},{"form_id":"0x00089F|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの裏切り者どもを叩き潰してやった。","index":1},{"form_id":"0x0008A0|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中に、真のノルドの力を見せつけてやった。","index":1},{"form_id":"0x0008A1|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国のクズどもを殺すのは何度やっても飽きないな。","index":1},{"form_id":"0x0008E9|civil war lines expansion.esp","type":"INFO NAM1","string":"くそっ。また死体の片付けか。","index":1},{"form_id":"0x000900|civil war lines expansion.esp","type":"INFO NAM1","string":"我々じゃなくてよかった。","index":1},{"form_id":"0x000901|civil war lines expansion.esp","type":"INFO NAM1","string":"孫に話す土産話ができたな？","index":1},{"form_id":"0x000902|civil war lines expansion.esp","type":"INFO NAM1","string":"まだ生きているなんて信じられない。","index":1},{"form_id":"0x000947|civil war lines expansion.esp","type":"INFO NAM1","string":"これで終わりだ。","index":1},{"form_id":"0x00094D|civil war lines expansion.esp","type":"INFO NAM1","string":"さて、これで全部終わりだ。","index":1},{"form_id":"0x00094B|civil war lines expansion.esp","type":"INFO NAM1","string":"もう強がれないようだな。","index":1},{"form_id":"0x000948|civil war lines expansion.esp","type":"INFO NAM1","string":"思い知らせてやったな。","index":1},{"form_id":"0x00094A|civil war lines expansion.esp","type":"INFO NAM1","string":"ストームクロークの裏切り者どもを叩き潰してやった。","index":1},{"form_id":"0x00094C|civil war lines expansion.esp","type":"INFO NAM1","string":"それがウルフリックの精鋭だと!?","index":1},{"form_id":"0x00098E|civil war lines expansion.esp","type":"INFO NAM1","string":"バカ犬め。","index":1},{"form_id":"0x00098F|civil war lines expansion.esp","type":"INFO NAM1","string":"ふう。危なかった。","index":1},{"form_id":"0x0009A4|civil war lines expansion.esp","type":"INFO NAM1","string":"くそ…(荒い息)","index":1},{"form_id":"0x000990|civil war lines expansion.esp","type":"INFO NAM1","string":"これで片付いたな。","index":1},{"form_id":"0x000991|civil war lines expansion.esp","type":"INFO NAM1","string":"思い知らせてやったな？","index":1},{"form_id":"0x000853|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国の連中に違いない……見つけ出せ！","index":1},{"form_id":"0x0008A3|civil war lines expansion.esp","type":"INFO NAM1","string":"ぐああああっ……","index":1},{"form_id":"0x00090E|civil war lines expansion.esp","type":"INFO NAM1","string":"我慢にも限度があるぞ、市民。下がれ。今すぐだ！","index":1},{"form_id":"0x00090F|civil war lines expansion.esp","type":"INFO NAM1","string":"下がっていろ、市民。重要な用務があるんだ。","index":1},{"form_id":"0x000910|civil war lines expansion.esp","type":"INFO NAM1","string":"すまないが、本当にそんな暇はないんだ。行ってくれ。","index":1},{"form_id":"0x000911|civil war lines expansion.esp","type":"INFO NAM1","string":"立ち去れ、市民。","index":1},{"form_id":"0x000954|civil war lines expansion.esp","type":"INFO NAM1","string":"立ち話をしている暇はない、市民。","index":1},{"form_id":"0x00091B|civil war lines expansion.esp","type":"INFO NAM1","string":"頼む……お慈悲を！","index":1},{"form_id":"0x00091C|civil war lines expansion.esp","type":"INFO NAM1","string":"分かった……とどめを刺せ！","index":1},{"form_id":"0x00091D|civil war lines expansion.esp","type":"INFO NAM1","string":"うぐ……ならさっさと済ませろ。","index":1},{"form_id":"0x00097D|civil war lines expansion.esp","type":"INFO NAM1","string":"出てきて裁きを受けろ、臆病者！","index":1},{"form_id":"0x000D64|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、反乱者！","index":1},{"form_id":"0x000D66|civil war lines expansion.esp","type":"INFO NAM1","string":"頼むから死んでくれ。死ね！","index":1},{"form_id":"0x000829|civil war lines expansion.esp","type":"INFO NAM1","string":"イスミールにかけて、何をしても死なないぞ！","index":1},{"form_id":"0x00082A|civil war lines expansion.esp","type":"INFO NAM1","string":"倒れろ。くそっ、倒れろ！","index":1},{"form_id":"0x00082B|civil war lines expansion.esp","type":"INFO NAM1","string":"この化け物はどうすれば死ぬんだ!?","index":1},{"form_id":"0x00082C|civil war lines expansion.esp","type":"INFO NAM1","string":"死なない。どんどん向かってくる！","index":1},{"form_id":"0x00082E|civil war lines expansion.esp","type":"INFO NAM1","string":"一体全体どうすればこいつを殺せるんだ!?","index":1},{"form_id":"0x00082D|civil war lines expansion.esp","type":"INFO NAM1","string":"なんであんなに速く動けるんだ!?","index":1},{"form_id":"0x000869|civil war lines expansion.esp","type":"INFO NAM1","string":"忌々しいドラゴンめ！","index":1},{"form_id":"0x000860|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、獣め！","index":1},{"form_id":"0x000862|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、汚らわしい獣め！","index":1},{"form_id":"0x000861|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、吸血鬼め！","index":1},{"form_id":"0x0008AB|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、汚らわしい獣め！","index":1},{"form_id":"0x000903|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、獣め！","index":1},{"form_id":"0x000904|civil war lines expansion.esp","type":"INFO NAM1","string":"死ね、汚らわしい獣め！","index":1},{"form_id":"0x000996|civil war lines expansion.esp","type":"INFO NAM1","string":"ソブンガルデで会おう！","index":1},{"form_id":"0x000D68|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの魔術師を始末しろ！","index":1},{"form_id":"0x000800|civil war lines expansion.esp","type":"INFO NAM1","string":"まずい、気をつけろ！","index":1},{"form_id":"0x000845|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国のクズどもめ！","index":1},{"form_id":"0x00088E|civil war lines expansion.esp","type":"INFO NAM1","string":"一体何が……？","index":1},{"form_id":"0x00088F|civil war lines expansion.esp","type":"INFO NAM1","string":"何だ……？","index":1},{"form_id":"0x000890|civil war lines expansion.esp","type":"INFO NAM1","string":"この薄汚いコソ泥トカゲめ！","index":1},{"form_id":"0x0008AC|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの魔術師を始末しろ！","index":1},{"form_id":"0x0008AD|civil war lines expansion.esp","type":"INFO NAM1","string":"馬鹿な犬め！　思い知らせてやる！","index":1},{"form_id":"0x0008E2|civil war lines expansion.esp","type":"INFO NAM1","string":"シャウトだ！　山にいるグレイビアードのような！","index":1},{"form_id":"0x0008E3|civil war lines expansion.esp","type":"INFO NAM1","string":"ショールの骨にかけて！","index":1},{"form_id":"0x0008E4|civil war lines expansion.esp","type":"INFO NAM1","string":"スゥームだ！　あの女、スゥームを操るぞ！","index":1},{"form_id":"0x0008E5|civil war lines expansion.esp","type":"INFO NAM1","string":"スゥームだ！　あの男、スゥームを操るぞ！","index":1},{"form_id":"0x0008E6|civil war lines expansion.esp","type":"INFO NAM1","string":"神々よ！　何という力だ!?","index":1},{"form_id":"0x0008E7|civil war lines expansion.esp","type":"INFO NAM1","string":"今のは何だ!?","index":1},{"form_id":"0x000915|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの忌々しい魔法使いに矢をぶち込め！","index":1},{"form_id":"0x000917|civil war lines expansion.esp","type":"INFO NAM1","string":"このネズミめ！　まともに戦え！","index":1},{"form_id":"0x000916|civil war lines expansion.esp","type":"INFO NAM1","string":"うっ……それだけか？　それが精一杯か!?","index":1},{"form_id":"0x000918|civil war lines expansion.esp","type":"INFO NAM1","string":"それが最後の過ちだ！","index":1},{"form_id":"0x000919|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの魔術師を始末しろ！","index":1},{"form_id":"0x00091E|civil war lines expansion.esp","type":"INFO NAM1","string":"声の力だと!?　これは何の魔法だ？","index":1},{"form_id":"0x00091F|civil war lines expansion.esp","type":"INFO NAM1","string":"まさか……","index":1},{"form_id":"0x000951|civil war lines expansion.esp","type":"INFO NAM1","string":"帝国軍がお前の血を流させてやる！","index":1},{"form_id":"0x00095C|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの忌々しい魔法使いに矢をぶち込め！","index":1},{"form_id":"0x00095D|civil war lines expansion.esp","type":"INFO NAM1","string":"誰かあの魔術師を始末しろ！","index":1},{"form_id":"0x0009A5|civil war lines expansion.esp","type":"INFO NAM1","string":"くたばれ！","index":1},{"form_id":"0x00098D|civil war lines expansion.esp","type":"INFO NAM1","string":"あれが声の主か！ 殺して…やる！","index":1},{"form_id":"0x000D62|civil war lines expansion.esp","type":"QUST FULL","string":"内戦セリフ拡張"}]
[{"form_id":"0x000D63|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"タロスよ、あなたの下僕の騒音越しに私の声が届くなら、どうか今すぐこの苦しみを終わらせてくれ。","index":1},{"form_id":"0x000D64|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"まったく。君はサディストだな。","index":1},{"form_id":"0x000D65|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"痛っ！ やめてくれ！","index":1},{"form_id":"0x000D66|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"こんなことあるべきじゃない！","index":1},{"form_id":"0x000D67|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"うぐっ！ やめろ。","index":1},{"form_id":"0x000D6A|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"まただ！","index":1},{"form_id":"0x000D6B|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"多分それを置いたほうがいい。","index":1},{"form_id":"0x000D68|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"また彼がいくぞ","index":1},{"form_id":"0x000D69|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"また彼女がいくぞ","index":1},{"form_id":"0x000D6E|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"ああー。これはいいね。","index":1},{"form_id":"0x000D6F|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"ストレス発散になるな。","index":1},{"form_id":"0x000D70|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"お前の指は才能がある。","index":1},{"form_id":"0x000D71|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"なんて卓越してるんだ","index":1},{"form_id":"0x000D73|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"お見事","index":1},{"form_id":"0x000D74|skyrimsgottalent-bards_inigo.esp","type":"INFO NAM1","string":"ナイス。","index":1}]
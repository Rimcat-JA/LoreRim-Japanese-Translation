[{"form_id":"0x50FFA6|the great city of winterhold v4.esp","type":"ACTI FULL","string":"献身の歌"},{"form_id":"0x0019AA|the great city of winterhold v4.esp","type":"BOOK FULL","string":"学生の日記"},{"form_id":"0x0019AA|the great city of winterhold v4.esp","type":"BOOK DESC","string":"<font face='$HandwrittenFont'>新しい家に引っ越した、最高だ！学院で勉強するなんて信じられない。僕は世界中で最高の魔術師になるんだ。母さんと父さんも誇りに思ってくれるはず。二人は大金をくれた。何年も離れることになる、こんなに遠くへ。故郷の温もりから遠く離れたここにいるのは、ちょっと怖い。\r\n\r\n今日、最初の授業があった。膨大な宿題が出たけど、僕には難しすぎることはなかった。これまでのところウィンターホールドは素晴らしい、この壮大な建物群から目が離せない、どれもとても古い。\r\n\r\n今、ウィンターホールドでは大嵐が起きていて、全員が屋内に留まるよう言われている。ウィンターホールドがこんなに寒い場所だとは知らなかった、スカイリムにしてはなおさらだ。\r\n\r\n信じられない！本当に信じられない！街が落ちた！そのまま波の中へ沈んだんだ。僕は運がいい、家は崖に引っかかった。嵐がこんなことを引き起こすなんて思わなかった。早く助けが来るといいけど、嵐が止むまでここには来られないだろう。食料はたくさんあるから大丈夫、心配しないで母さん、父さん！\r\n\r\n助けはついに来なかったし、これからも来ないだろう。両親はどう思っているだろう？きっと僕は死んだと思っているに違いない。\r\n</font>"},{"form_id":"0x50AE70|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"フロデ・スノーオウル"},{"form_id":"0x40851D|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"エウテュミア"},{"form_id":"0x00F5A3|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"マグナー・フロストヴェイン"},{"form_id":"0x3FE24D|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"チャイム"},{"form_id":"0x31F6B6|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"マグナ・フロストヴェイン"},{"form_id":"0x3A8057|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"ルーニ"},{"form_id":"0x4D31F1|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"ニャル・フロストヴェイン"},{"form_id":"0x4E767A|the great city of winterhold v4.esp","type":"NPC_ FULL","string":"霜脈のスカディ"},{"form_id":"0x3103AA|the great city of winterhold v4.esp","type":"KEYM FULL","string":"マグナの家の鍵"},{"form_id":"0x408491|the great city of winterhold v4.esp","type":"KEYM FULL","string":"チャイムとユーシミアの家の鍵"},{"form_id":"0x408490|the great city of winterhold v4.esp","type":"KEYM FULL","string":"ルニの家の鍵"},{"form_id":"0x00FB8C|the great city of winterhold v4.esp","type":"KEYM FULL","string":"フロストヴェイン家の鍵"},{"form_id":"0x4544CE|the great city of winterhold v4.esp","type":"KEYM FULL","string":"フロストビュー邸の鍵"},{"form_id":"0x3103A9|the great city of winterhold v4.esp","type":"KEYM FULL","string":"フリーダの家の鍵"},{"form_id":"0x43AF6C|the great city of winterhold v4.esp","type":"CELL FULL","string":"ルニの家"},{"form_id":"0x2C4200|the great city of winterhold v4.esp","type":"CELL FULL","string":"ウィンターホールド倉庫"},{"form_id":"0x324847|the great city of winterhold v4.esp","type":"CELL FULL","string":"マグナの家"},{"form_id":"0x4084C6|the great city of winterhold v4.esp","type":"CELL FULL","string":"チャイムとユーシミアの家"},{"form_id":"0x4595D9|the great city of winterhold v4.esp","type":"CELL FULL","string":"フロストビュー・ホール"},{"form_id":"0x142EBD|the great city of winterhold v4.esp","type":"CELL FULL","string":"ウィンターホールド図書館"},{"form_id":"0x3247C9|the great city of winterhold v4.esp","type":"CELL FULL","string":"フリーダの家"},{"form_id":"0x002575|the great city of winterhold v4.esp","type":"CELL FULL","string":"ウィンターホールド衛兵詰所"},{"form_id":"0x4CDEE7|the great city of winterhold v4.esp","type":"CELL FULL","string":"フロストヴェイン氏族の家"},{"form_id":"0x338CC4|the great city of winterhold v4.esp","type":"INFO NAM1","string":"見ない顔だな。はっきり言っておく。この図書館に害が及ばないようにするのが俺の役目だ。","index":1},{"form_id":"0x338CC4|the great city of winterhold v4.esp","type":"INFO NAM1","string":"悪意を持って指一本でも動かしてみろ。お前の腐った死体にとっちゃオブリビオンがエセリウスに思えるような目に遭わせてやる。","index":2},{"form_id":"0x338CC4|the great city of winterhold v4.esp","type":"INFO RNAM","string":"何をじろじろ見てる？"},{"form_id":"0x338CC5|the great city of winterhold v4.esp","type":"DIAL FULL","string":"あまり温かい歓迎じゃないな。"},{"form_id":"0x338CC6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"温かい歓迎を期待してるなら、来る地方を間違えたな。悪く思うなよ、セラ。","index":1},{"form_id":"0x338CC6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"一日おきに、どこかの頑固なノルドがやって来ては、ここの本は悪魔の秘密が書かれているから燃やすべきだとわめくんだ。","index":2},{"form_id":"0x338CC6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"まあ……あながち間違いとも言えないがな。だからといって燃やしていい理由にはならない。","index":3},{"form_id":"0x338CC9|the great city of winterhold v4.esp","type":"DIAL FULL","string":"じゃあ、衛兵なのか？"},{"form_id":"0x338CCA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺は教団の手伝いで図書館の警備をしてる。町のほかの雑用もな。","index":1},{"form_id":"0x338CCA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"フロデは俺にいつも公平ってわけじゃないが、払いはいい。","index":2},{"form_id":"0x338CCA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"比較的には。","index":3},{"form_id":"0x338CCC|the great city of winterhold v4.esp","type":"DIAL FULL","string":"図書館があるって?"},{"form_id":"0x338CCD|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここはジュナル教団が運営してる。変わった集団だよ、ノルドにしてはな。侮辱のつもりはないぞ。","index":1},{"form_id":"0x338CCD|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ただ、本だの何だのに興味を持つってのは……あの連中にしちゃ珍しいってことさ。","index":2},{"form_id":"0x338CCD|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺には親切だし、払いもいい。だから文句はない。","index":3},{"form_id":"0x338CCD|the great city of winterhold v4.esp","type":"INFO NAM1","string":"さて、何か買いたいならスカディと話すといい。","index":4},{"form_id":"0x338CD0|the great city of winterhold v4.esp","type":"INFO NAM1","string":"大崩壊以来、すっかりゴミ溜めさ。いや、考えてみりゃ昔からかなりのゴミ溜めだったな。もう少し……原形を留めてはいたが。","index":1},{"form_id":"0x338CD0|the great city of winterhold v4.esp","type":"INFO NAM1","string":"この町じゃダンマーとノルドの間に因縁が山ほどある。俺の同族のほとんどはずっと昔にウィンターホールドから追い出された。","index":2},{"form_id":"0x338CD0|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺は残ったわずかな一人だ。まあ、近頃じゃノルドだって大して残っちゃいないがな。 ","index":3},{"form_id":"0x338CD0|the great city of winterhold v4.esp","type":"INFO NAM1","string":"この町でまだ価値があるものといえば、大学くらいだ。確かに立派に見える。足を踏み入れたことはないが、ずっと行ってみたいとは思ってた。","index":4},{"form_id":"0x338CD1|the great city of winterhold v4.esp","type":"DIAL FULL","string":"なぜ残ることにしたんだ？"},{"form_id":"0x338CD2|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ウィンターホールドに残ってるのは、出ていくには頑固すぎる連中だけだ。","index":1},{"form_id":"0x338CD2|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺はこの町で生まれ育った。誰に脅されようと屈するつもりはない。","index":2},{"form_id":"0x338CD5|the great city of winterhold v4.esp","type":"DIAL FULL","string":"ジュナールとは誰だ？"},{"form_id":"0x338CD6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ジュナルは知識と知恵を司るノルドの神。フクロウの姿で表され、帝国人にはジュリアノスとして知られている。","index":1},{"form_id":"0x338CD6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ジュナルに身を捧げた我々は、知識の探求こそが創造を尊ぶ最も純粋な道だと信じているのだ。","index":2},{"form_id":"0x338CD6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"今の世ではフクロウは大衆から疎まれているが、それでもスカイリム中の多くの秘儀結社や賢者たちにとって守護神であり続けている。","index":3},{"form_id":"0x338CD6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ジュナールへの崇敬が衰えるにつれ、ウィンターホールドもまた衰えていった。詩的な偶然というものだろうか。","index":4},{"form_id":"0x338CD9|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここは図書館だ。残念ながら、この蔵書はかつての影にすぎない。多くが大崩壊の際に失われてしまったのでね。","index":1},{"form_id":"0x338CD9|the great city of winterhold v4.esp","type":"INFO NAM1","string":"我々は残されたものすべてを守ろうとしている。そのためなら、私は喜んでこの命を捧げよう。","index":2},{"form_id":"0x338CDB|the great city of winterhold v4.esp","type":"DIAL FULL","string":"ウィンターホールドについてもっと知りたい。"},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"残念ながら、ウィンターホールドの歴史はいささか悲劇的な道をたどってしまった。","index":1},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"いいかね、君が今立っているのは、古の偉大な者たちが遺した名残の只中なのだ。この町はスカイリムの古き権力の座の一つだった。","index":2},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"信じがたいかもしれないが、我々の祖先は、今の多くの者のように魔法を忌み嫌ってはいなかった。","index":3},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"そう、この町は賢者たちの術を誇りとしていたのだ。","index":4},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"しかし、ウィンターホールド大学が今なおスカイリムで最も重要な魔法の学び舎であるにもかかわらず、町の人々は……","index":5},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"幾多の悲劇のせいで、魔法の使い手を警戒するようになってしまった。","index":6},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"オブリビオンの動乱の後、多くの者が迷信深くなり、大勢のダークエルフがこの町から追放された。","index":7},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"だが、それらの悲劇の中でも最悪だったのは、おそらく……","index":8},{"form_id":"0x338CDC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ほんの80年ほど前の崩壊だろう。我らが古き都の大半が、終わることのない嵐に呑み込まれたのだ。","index":9},{"form_id":"0x338CDE|the great city of winterhold v4.esp","type":"DIAL FULL","string":"この街の建築はずいぶん古そうだ。"},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"その通り。君は目が利くな。","index":1},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"愛すべきこの町の多くは失われたかもしれないが、君を取り囲むこれら数多の建造物は、今もまったく異なる時代の物語を語っている。","index":2},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"古い伝説によれば、この町は古のアークメイジ、シャリドールのささやくような一つの呪文によって築かれたという。","index":3},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"当時のものはあまり残っていないが、それでもこれらの遺跡は、まさに同じ技法で造られているのだ。","index":4},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"いにしえの賢者たちがスカイリム各地の壮大な神殿を築くのに用いた技法でね。","index":5},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"この町は、古く強力なルーンを染み込ませて建てられたのだ。","index":6},{"form_id":"0x338CDF|the great city of winterhold v4.esp","type":"INFO NAM1","string":"町の者たちはそれを心に留めておくべきだろう。","index":7},{"form_id":"0x338CE2|the great city of winterhold v4.esp","type":"DIAL FULL","string":"この辺りで何をしているんだ？"},{"form_id":"0x338CE3|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ああ、私と仲間たちは船乗りだ。狩りや漁をしている。主にホーカーだな。それと、その……","index":1},{"form_id":"0x338CE3|the great city of winterhold v4.esp","type":"INFO NAM1","string":"時々は交易もな。氷が許す時は、町のために物資を集められるなら何でもやるさ。","index":2},{"form_id":"0x338CE3|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここでの暮らしは厳しいが、精一杯やってるよ。","index":3},{"form_id":"0x338CE6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"話すほどのことはないよ。ウィンターホールドはかつて偉大な町だったと言われてる。子供の頃は古い遺跡の中でよく遊んだもんだ。","index":1},{"form_id":"0x338CE6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"とにかく、そういうことは私には分からない。その手の話ならフロデに聞くといい。","index":2},{"form_id":"0x338CE6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"私に分かるのは、ほとんどの連中は荷物をまとめて出ていきたがってるってことだけさ。","index":3},{"form_id":"0x338CE6|the great city of winterhold v4.esp","type":"INFO NAM1","string":"私もかつてはそうだった。できるだけ遠くへ行きたくて、実際にそうした。旅をして、ストームクロークに入り、いくつもの戦いを経て戻ってきたんだ。","index":4},{"form_id":"0x338CE7|the great city of winterhold v4.esp","type":"DIAL FULL","string":"商人だと言ったな。取引しないか?"},{"form_id":"0x338CE8|the great city of winterhold v4.esp","type":"INFO NAM1","string":"私は、その、そういう類の商人じゃないんだ。","index":1},{"form_id":"0x338CE8|the great city of winterhold v4.esp","type":"INFO NAM1","string":"たいていは奪うだけで、与えはしない。","index":2},{"form_id":"0x338CE8|the great city of winterhold v4.esp","type":"INFO NAM1","string":"いや、何か言う前に聞いてくれ。生き延びるためなんだ。全部、町のための物資なんだよ。","index":3},{"form_id":"0x338CE8|the great city of winterhold v4.esp","type":"INFO NAM1","string":"本当に取引がしたいならビルナと話すといい。大した品揃えじゃないが、私よりはましだ。","index":4},{"form_id":"0x338CE9|the great city of winterhold v4.esp","type":"DIAL FULL","string":"この凍てつく海を航海するのは危険だろうね。"},{"form_id":"0x338CEA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ハッ。楽じゃないのは確かだ。ここの海は一年の大半が氷に閉ざされてるが、街道を行くのも同じくらい危ない。","index":1},{"form_id":"0x338CEA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"帝国軍に言わせれば、ドーンスターからウィンドヘルムまでの沿岸はどこも航行不能だそうだ。ここを巡回する度胸なんてないのさ。","index":2},{"form_id":"0x338CEA|the great city of winterhold v4.esp","type":"INFO NAM1","string":"だが私たちノルドは、何とかやっていく。そうするしかないんだ。","index":3},{"form_id":"0x338CEB|the great city of winterhold v4.esp","type":"DIAL FULL","string":"それで、なぜウィンターホールドに戻ってきたんだ？"},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"手短に話すよ。私は戦場にいた。どこだったかは正確には覚えていない。","index":1},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"覚えているのは、男の胸を刃で貫いたことだ。引き寄せた時、そいつの目が見えた。氷のような灰色だった。","index":2},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"故郷を思い出したよ。夏の雪と、永遠に凍てついた荒野を。","index":3},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"その男が私の武器に抗うのをやめ、その目が冷たくなっていくにつれ、なおさらにな。","index":4},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"その時、私は心の中で思った。「この男にも故郷があったんだ」と。","index":5},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"その時悟ったんだ。故郷を離れた私は愚かだったと。ストームクロークよりも私を必要としている人たちがいるんだと。","index":6},{"form_id":"0x338CEC|the great city of winterhold v4.esp","type":"INFO NAM1","string":"家族や仲間たちさ。今の私は、ウィンターホールドのために戦っている。","index":7},{"form_id":"0x366642|the great city of winterhold v4.esp","type":"INFO NAM1","string":"神々を軽んじるつもりはないが、図書館にあるあの本のいくつかは……魔法に悪魔だぞ、フロデ！あんなのは間違ってる！","index":1},{"form_id":"0x366644|the great city of winterhold v4.esp","type":"INFO NAM1","string":"軽んじるつもりはないと言いながら、今まさにここで軽んじているではないか。私がジュナルの導きのもとで幾冬を過ごしてきたと思っている！","index":1},{"form_id":"0x366644|the great city of winterhold v4.esp","type":"INFO NAM1","string":"それでも自分の方がよく分かっていると思うのか？","index":2},{"form_id":"0x366646|the great city of winterhold v4.esp","type":"INFO NAM1","string":"だがあんたは、あのエルフの一人を……","index":1},{"form_id":"0x366648|the great city of winterhold v4.esp","type":"INFO NAM1","string":"黙れ！これ以上の無礼は聞く耳を持たん。","index":1},{"form_id":"0x36664C|the great city of winterhold v4.esp","type":"INFO NAM1","string":"エルフが図書館にいるべきじゃない。","index":1},{"form_id":"0x36664E|the great city of winterhold v4.esp","type":"INFO NAM1","string":"へえ、そうかい？なぜだ？","index":1},{"form_id":"0x366650|the great city of winterhold v4.esp","type":"INFO NAM1","string":"教団は古いノルドの結社だ。ノルドのな。お前はノルドじゃないだろう？","index":1},{"form_id":"0x366652|the great city of winterhold v4.esp","type":"INFO NAM1","string":"それについては神々に感謝してるよ。","index":1},{"form_id":"0x366656|the great city of winterhold v4.esp","type":"INFO NAM1","string":"お前は信用できない。図書館で本当は何が欲しいんだ？","index":1},{"form_id":"0x366658|the great city of winterhold v4.esp","type":"INFO NAM1","string":"そりゃもちろん、邪悪な魔物を召喚して、俺の悪巧みを推し進めるための知識と力さ。","index":1},{"form_id":"0x36665A|the great city of winterhold v4.esp","type":"INFO NAM1","string":"お前を受け入れるなんて、フロデはどうかしてたんだ。","index":1},{"form_id":"0x36665E|the great city of winterhold v4.esp","type":"INFO NAM1","string":"近頃エウテュミアはどうしてる？","index":1},{"form_id":"0x366660|the great city of winterhold v4.esp","type":"INFO NAM1","string":"今は首長の使用人として働いてる。いい仕事じゃないが、何とかやってるよ。","index":1},{"form_id":"0x366664|the great city of winterhold v4.esp","type":"INFO NAM1","string":"スカディが言うには、廃墟の中で本がぎっしり詰まった古い地下室を見つけたそうだ。建物は魔術師か学者のものだったんだろう。","index":1},{"form_id":"0x366666|the great city of winterhold v4.esp","type":"INFO NAM1","string":"本当かね？どこでだ？もしかすると持ち主を知っているかもしれん。","index":1},{"form_id":"0x366668|the great city of winterhold v4.esp","type":"INFO NAM1","string":"何とも言えないな。本を集めるのに、あんたの手を借りることになりそうだ。","index":1},{"form_id":"0x36666E|the great city of winterhold v4.esp","type":"INFO NAM1","string":"スカディ、マグナーとはどうなっているのかね？君が図書館や神殿で過ごすのを、彼はまだよく思っていないのか？","index":1},{"form_id":"0x366670|the great city of winterhold v4.esp","type":"INFO NAM1","string":"え？ああ、それが……私たちの溝は広がるばかりみたい。あの人ったら、本当に自分のことしか考えてないの。","index":1},{"form_id":"0x366672|the great city of winterhold v4.esp","type":"INFO NAM1","string":"そうか。きっと彼も分かってくれるさ。","index":1},{"form_id":"0x366676|the great city of winterhold v4.esp","type":"INFO NAM1","string":"興味深い。で、君はこの件をどう思うかね？","index":1},{"form_id":"0x366678|the great city of winterhold v4.esp","type":"INFO NAM1","string":"噂を聞いたことがあるだけ。どれが本当なのかは分からないわ。","index":1},{"form_id":"0x36667A|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ふむ。いくらかの真実はあるに違いない。","index":1},{"form_id":"0x3E4D2B|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺たちに必要なのは強さだ、力だ。魔法じゃない。","index":1},{"form_id":"0x3E9E2D|the great city of winterhold v4.esp","type":"INFO NAM1","string":"魔法使いになんぞ興味はない。あんな連中、何の役にも立たん。","index":1},{"form_id":"0x3FE24F|the great city of winterhold v4.esp","type":"INFO NAM1","string":"認めざるを得ないな。古代ノルドは独創的な建築家だった。","index":1},{"form_id":"0x3FE251|the great city of winterhold v4.esp","type":"INFO NAM1","string":"図書館のノルドたちは、他の連中と違って立派な人たちだ。","index":1},{"form_id":"0x3FE252|the great city of winterhold v4.esp","type":"INFO NAM1","string":"俺の支えになってるのは、エウテュミアと過ごす夜の時間だな。","index":1},{"form_id":"0x3FE250|the great city of winterhold v4.esp","type":"INFO NAM1","string":"たいていのノルドは俺に何もさせちゃくれないが、図書館の仕事は……悪くない。","index":1},{"form_id":"0x4E7678|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ぼく、戦士になりたいんだ！史上最強の戦士に！","index":1},{"form_id":"0x4E767D|the great city of winterhold v4.esp","type":"INFO NAM1","string":"近頃は、どこもかしこも不安に満ちているみたい。","index":1},{"form_id":"0x34D104|the great city of winterhold v4.esp","type":"INFO NAM1","string":"あんたが魔法使いの類じゃなければいいんだが。","index":1},{"form_id":"0x34D105|the great city of winterhold v4.esp","type":"INFO NAM1","string":"また海に出たくてたまらないが、この寒さじゃそうもいかない。","index":1},{"form_id":"0x34D106|the great city of winterhold v4.esp","type":"INFO NAM1","string":"冬が年々長くなっていく気がするよ。","index":1},{"form_id":"0x34D107|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ちっ。こんな天気じゃ狩りにならない。","index":1},{"form_id":"0x34D108|the great city of winterhold v4.esp","type":"INFO NAM1","string":"目を離さないからな、耳長。","index":1},{"form_id":"0x34D109|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ジュナルに仕える者に助言を求めるだけの賢さが、君にはあるかね？","index":1},{"form_id":"0x34D10A|the great city of winterhold v4.esp","type":"INFO NAM1","string":"近頃はここを訪れる者も少ない。何か用かね？","index":1},{"form_id":"0x34D10B|the great city of winterhold v4.esp","type":"INFO NAM1","string":"斧は鋭く研いでおけ。知恵はさらに鋭くとな。","index":1},{"form_id":"0x34D10C|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここでどれほどの秘密が失われ、二度と明かされぬままになったのだろうか。","index":1},{"form_id":"0x34D103|the great city of winterhold v4.esp","type":"INFO NAM1","string":"君の持つ知識は、くれぐれも慎重に扱いたまえ。それは創造する力も、破壊する力も秘めているのだから。","index":1},{"form_id":"0x4544D0|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここに落ち着くつもりか？売りに出てる家がある。興味があるなら、宮殿の執政と話すといい。","index":1},{"form_id":"0x2C9448|the great city of winterhold v4.esp","type":"INFO NAM1","string":"こんな地獄のような場所に住みたいのか？売りに出ている家がある。フロストビュー・ホールだ。砦にいるあのネズミ、マルーア・セロスと話せ。","index":1},{"form_id":"0x347FF4|the great city of winterhold v4.esp","type":"INFO NAM1","string":"私と仲間たちで、古い廃墟の一つ、フロストビュー・ホールを建て直したんだ。興味があるか？宮殿にいる執政のエルフと話すといい。","index":1},{"form_id":"0x477D0E|the great city of winterhold v4.esp","type":"INFO NAM1","string":"ここに落ち着くつもりか？売りに出てる家がある。興味があるなら、宮殿の執政と話すといい。","index":1},{"form_id":"0x4595D3|the great city of winterhold v4.esp","type":"DIAL FULL","string":"従士になったので、街に家を買いたい"},{"form_id":"0x4595D6|the great city of winterhold v4.esp","type":"DIAL FULL","string":"フロストビュー・ホールを買いたい。(4000)"},{"form_id":"0x4595D7|the great city of winterhold v4.esp","type":"INFO NAM1","string":"いい家だ。良い選択をしたな。これが新しい住まいの鍵だ。","index":1},{"form_id":"0x529665|the great city of winterhold v4.esp","type":"INFO NAM1","string":"エルフが図書館にいるべきじゃない。","index":1},{"form_id":"0x529666|the great city of winterhold v4.esp","type":"INFO NAM1","string":"あんたは信用できない。","index":1},{"form_id":"0x529667|the great city of winterhold v4.esp","type":"INFO NAM1","string":"お前を受け入れるなんて、フロデはどうかしてたんだ。","index":1},{"form_id":"0x4544CD|the great city of winterhold v4.esp","type":"QUST CNAM","string":"マルーア・セロスと話してウィンターホールドの家を購入する","index":10},{"form_id":"0x4544CD|the great city of winterhold v4.esp","type":"QUST CNAM","string":"ウィンターホールドの新しい家を訪れる","index":30},{"form_id":"0x4544CD|the great city of winterhold v4.esp","type":"QUST NNAM","string":"マルーア・セロスと話してウィンターホールドの家を購入する","index":10},{"form_id":"0x4544CD|the great city of winterhold v4.esp","type":"QUST NNAM","string":"ウィンターホールドの新しい家を訪れる","index":30},{"form_id":"0x00F5A2|the great city of winterhold v4.esp","type":"LCTN FULL","string":"マグナーの家"},{"form_id":"0x143085|the great city of winterhold v4.esp","type":"LCTN FULL","string":"ルーンの間"},{"form_id":"0x3248A0|the great city of winterhold v4.esp","type":"LCTN FULL","string":"フリーダの家"},{"form_id":"0x4403EC|the great city of winterhold v4.esp","type":"LCTN FULL","string":"ウィンターホールド衛兵詰所"},{"form_id":"0x4403ED|the great city of winterhold v4.esp","type":"LCTN FULL","string":"ウィンターホールドの波止場"},{"form_id":"0x4403EE|the great city of winterhold v4.esp","type":"LCTN FULL","string":"ウィンターホールド倉庫"},{"form_id":"0x4596FF|the great city of winterhold v4.esp","type":"LCTN FULL","string":"フロストビュー・ホール"},{"form_id":"0x459700|the great city of winterhold v4.esp","type":"LCTN FULL","string":"ルニの家"},{"form_id":"0x3248A1|the great city of winterhold v4.esp","type":"LCTN FULL","string":"マグナの家"},{"form_id":"0x40851B|the great city of winterhold v4.esp","type":"LCTN FULL","string":"チャイムの家"},{"form_id":"0x50FFA8|the great city of winterhold v4.esp","type":"MESG DESC","string":"聞きたまえ、ジュナル、ルーンの賢神よ!\r\n\r\nこの神殿を御身の姿として受け入れたまえ\r\n\r\n荒涼たる氷の砂丘のただ中に。\r\n\r\n我らが老いし賢き者たちは、巧みにして聡く、\r\n\r\n月の下を飛ぶ梟のごとく、\r\n\r\n御身の見守る眼に示さんと、\r\n\r\n御身の恵みのため再び労した。\r\n\r\n六ダースの魂が死に、空しく果てた。\r\n\r\n彼らは幾多の午後を捧げた\r\n\r\nかくも厳しく急ぎ働いたゆえに。\r\n\r\n最後の重き石が据えられる前に\r\n\r\n払われたるは、おおいなる代償なり。\r\n\r\n"}]
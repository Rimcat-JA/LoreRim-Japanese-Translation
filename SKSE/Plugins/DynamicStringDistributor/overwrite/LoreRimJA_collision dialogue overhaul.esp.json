[{"form_id":"0x00080B|collision dialogue overhaul.esp","type":"INFO NAM1","string":"おい！ 尻尾に気をつけろ！","index":1},{"form_id":"0x00081A|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと、お尻から手を離して！","index":1},{"form_id":"0x00081E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わたしのお尻を触ろうとしないで！","index":1},{"form_id":"0x000823|collision dialogue overhaul.esp","type":"INFO NAM1","string":"おい！ お尻？ ダメ！","index":1},{"form_id":"0x000827|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと、このお尻はあなたのおもちゃじゃないのよ。","index":1},{"form_id":"0x00082D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、本当にわたしのお尻を触った？","index":1},{"form_id":"0x00082E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、わたしのケツを触ったでしょ！？","index":1},{"form_id":"0x000835|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わたしのお尻から手をどけて。今すぐ！","index":1},{"form_id":"0x000836|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わたしの…ケツから…その…手を…どけなさいって言ってるの！","index":1},{"form_id":"0x000840|collision dialogue overhaul.esp","type":"INFO NAM1","string":"それ、わたしのお尻だってわかってる？","index":1},{"form_id":"0x00096F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"夫のナゼームを探してるの？ それならお尻違いよ！ 首長のところを当たってみて。","index":1},{"form_id":"0x000844|collision dialogue overhaul.esp","type":"INFO NAM1","string":"この者の尻尾を挟もうとしているのか？","index":1},{"form_id":"0x000852|collision dialogue overhaul.esp","type":"INFO NAM1","string":"お尻から離れなさいよ、この変態！","index":1},{"form_id":"0x000853|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっとちょっと！ お尻に気をつけて！","index":1},{"form_id":"0x000854|collision dialogue overhaul.esp","type":"INFO NAM1","string":"もう一度わたしのケツを触ってみなさいよ、やれるもんならね！","index":1},{"form_id":"0x000855|collision dialogue overhaul.esp","type":"INFO NAM1","string":"後ろからするのがお好みってわけ？","index":1},{"form_id":"0x00085C|collision dialogue overhaul.esp","type":"INFO NAM1","string":"もうその辺はあんまり肉がついてないのよ。","index":1},{"form_id":"0x00085D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"そこはわたしのケツよ！","index":1},{"form_id":"0x000862|collision dialogue overhaul.esp","type":"INFO NAM1","string":"そこはわたしのケツだってわかってるのかい、坊や？","index":1},{"form_id":"0x000863|collision dialogue overhaul.esp","type":"INFO NAM1","string":"お願い、お尻は触らないで。","index":1},{"form_id":"0x00086C|collision dialogue overhaul.esp","type":"INFO NAM1","string":"背中から離れて！","index":1},{"form_id":"0x00086D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツから離れなさいよ、この変態！","index":1},{"form_id":"0x00086E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"お尻に触らないで！","index":1},{"form_id":"0x00087A|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、わたしのお尻を撫でた！？","index":1},{"form_id":"0x00087B|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと！ わたしのケツを触ろうとしないで！","index":1},{"form_id":"0x000883|collision dialogue overhaul.esp","type":"INFO NAM1","string":"後ろからいただこうってわけ？","index":1},{"form_id":"0x000884|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わたしのお尻を掴むの？ 本気？","index":1},{"form_id":"0x000885|collision dialogue overhaul.esp","type":"INFO NAM1","string":"レディのお尻を触るものじゃないわよ、わかってる？","index":1},{"form_id":"0x000997|collision dialogue overhaul.esp","type":"INFO NAM1","string":"あら！ いつでもお尻を叩いていいのよ、坊や。","index":1},{"form_id":"0x00088D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと！ わたしのお尻はあなたのおもちゃじゃないの！","index":1},{"form_id":"0x00088E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"そんな風にわたしのお尻を触らないで！","index":1},{"form_id":"0x00088F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、わたしのケツを叩いた！？","index":1},{"form_id":"0x000894|collision dialogue overhaul.esp","type":"INFO NAM1","string":"おい！ 尻尾はやめろ！","index":1},{"form_id":"0x000897|collision dialogue overhaul.esp","type":"INFO NAM1","string":"後ろから襲えると思ってるのか？","index":1},{"form_id":"0x00089F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、本当に尻を触ったのか？","index":1},{"form_id":"0x0008A0|collision dialogue overhaul.esp","type":"INFO NAM1","string":"もう一度そんな風にケツを触ったら、ぶっ殺すぞ。","index":1},{"form_id":"0x0008A5|collision dialogue overhaul.esp","type":"INFO NAM1","string":"手を離せ！","index":1},{"form_id":"0x0008AA|collision dialogue overhaul.esp","type":"INFO NAM1","string":"尻から離れろ！","index":1},{"form_id":"0x0008B0|collision dialogue overhaul.esp","type":"INFO NAM1","string":"男の尻をそんな風に触るな！","index":1},{"form_id":"0x0008B6|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今のは事故だったと思いたいが？","index":1},{"form_id":"0x0008B7|collision dialogue overhaul.esp","type":"INFO NAM1","string":"一度しか言わない。だが頼む、尻から手をどけてくれ。","index":1},{"form_id":"0x0008BD|collision dialogue overhaul.esp","type":"INFO NAM1","string":"おい！ もともと腰が悪いんだぞ！","index":1},{"form_id":"0x0008BE|collision dialogue overhaul.esp","type":"INFO NAM1","string":"そこは尻だ、このドジなウスノロ！","index":1},{"form_id":"0x0008C7|collision dialogue overhaul.esp","type":"INFO NAM1","string":"尻はやめろ！ 尻はやめろって！！","index":1},{"form_id":"0x0008C8|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツを触るのはやめろ、ンワー！","index":1},{"form_id":"0x0008D5|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと！ お尻を触るのはやめて！","index":1},{"form_id":"0x0008DE|collision dialogue overhaul.esp","type":"INFO NAM1","string":"後ろで何をしている！？","index":1},{"form_id":"0x0008DF|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、この高貴なる尻に触れたか！？","index":1},{"form_id":"0x0008E8|collision dialogue overhaul.esp","type":"INFO NAM1","string":"尻をいじくってるのか？","index":1},{"form_id":"0x0008E9|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツから手を離せ！","index":1},{"form_id":"0x0008F1|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツから離れろ！","index":1},{"form_id":"0x0008F2|collision dialogue overhaul.esp","type":"INFO NAM1","string":"なんで尻を触ってるんだ？","index":1},{"form_id":"0x0008F6|collision dialogue overhaul.esp","type":"INFO NAM1","string":"リーチの民のケツに触れる奴は許さん！","index":1},{"form_id":"0x000900|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ははっ！ 今のでちょっとウンチが出ちゃったんじゃないか！","index":1},{"form_id":"0x000901|collision dialogue overhaul.esp","type":"INFO NAM1","string":"うわっ！ 今のでクソ漏らしたかも！","index":1},{"form_id":"0x000908|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、私の尻に何をした？","index":1},{"form_id":"0x00090D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"このカジートの尻尾に気をつけろ！","index":1},{"form_id":"0x00091A|collision dialogue overhaul.esp","type":"INFO NAM1","string":"尻から離れろ！","index":1},{"form_id":"0x00091B|collision dialogue overhaul.esp","type":"INFO NAM1","string":"俺のケツから離れろ！ さもないとお前のケツに剣をぶち込むぞ！","index":1},{"form_id":"0x000925|collision dialogue overhaul.esp","type":"INFO NAM1","string":"手に気をつけろ！ 尻を触ったな！","index":1},{"form_id":"0x000926|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと！ わたしのケツを触ろうとしないで！","index":1},{"form_id":"0x00092E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"年寄りの尻を掴むとはな？","index":1},{"form_id":"0x00092F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わしの尻をお探しかね？ ああ、近頃はたいして残っちゃおらんよ。","index":1},{"form_id":"0x000937|collision dialogue overhaul.esp","type":"INFO NAM1","string":"あら。私のお尻に興味があるの？","index":1},{"form_id":"0x000938|collision dialogue overhaul.esp","type":"INFO NAM1","string":"痛っ。ただでさえ腰が悪いんだ。やめてくれ。","index":1},{"form_id":"0x000942|collision dialogue overhaul.esp","type":"INFO NAM1","string":"オークのそんな所に触るとは、いい度胸だな？！","index":1},{"form_id":"0x00094A|collision dialogue overhaul.esp","type":"INFO NAM1","string":"何なんだ一体？ 今何をしたか分かってるぞ！","index":1},{"form_id":"0x00094B|collision dialogue overhaul.esp","type":"INFO NAM1","string":"俺のケツだと？ 本気か？","index":1},{"form_id":"0x000952|collision dialogue overhaul.esp","type":"INFO NAM1","string":"俺のケツから離れろ、この野郎！","index":1},{"form_id":"0x000956|collision dialogue overhaul.esp","type":"INFO NAM1","string":"何しろ、大勢のご婦人方に美しいと言われてきたからね。","index":1},{"form_id":"0x000957|collision dialogue overhaul.esp","type":"INFO NAM1","string":"えっ？ 今のは尻だって分かってる？","index":1},{"form_id":"0x000979|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと手癖が悪いんじゃないかい？！","index":1},{"form_id":"0x00097A|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツを触ろうとしたのかい？","index":1},{"form_id":"0x00097D|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと図々しいんじゃない？","index":1},{"form_id":"0x00097E|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、お尻を叩いた？","index":1},{"form_id":"0x000980|collision dialogue overhaul.esp","type":"INFO NAM1","string":"私のお尻を触ってるの？","index":1},{"form_id":"0x000984|collision dialogue overhaul.esp","type":"INFO NAM1","string":"お尻を掴もうとした？","index":1},{"form_id":"0x000985|collision dialogue overhaul.esp","type":"INFO NAM1","string":"汚い手で俺のケツに触るな！","index":1},{"form_id":"0x000988|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ケツから手を離せ！","index":1},{"form_id":"0x000989|collision dialogue overhaul.esp","type":"INFO NAM1","string":"話すなら顔を見て話せ、尻じゃなくてな！","index":1},{"form_id":"0x0009EB|collision dialogue overhaul.esp","type":"INFO NAM1","string":"気をつけろ！ そこは俺のケツだ！","index":1},{"form_id":"0x00080C|collision dialogue overhaul.esp","type":"INFO NAM1","string":"気をつけてよ！ 触っていいものじゃないんだから！","index":1},{"form_id":"0x00080F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと、手をどこに置いてるの！","index":1},{"form_id":"0x00081B|collision dialogue overhaul.esp","type":"INFO NAM1","string":"ちょっと、目線はこっちよ、旦那！","index":1},{"form_id":"0x00081C|collision dialogue overhaul.esp","type":"INFO NAM1","string":"何を掴もうとしてるのか知らないけど、やめなさい！","index":1},{"form_id":"0x00081F|collision dialogue overhaul.esp","type":"INFO NAM1","string":"顔の前から失せろ！！","index":1},{"form_id":"0x000820|collision dialogue overhaul.esp","type":"INFO NAM1","string":"顔を近づけるな！！","index":1},{"form_id":"0x000821|collision dialogue overhaul.esp","type":"INFO NAM1","string":"今、わたしの胸を触った？","index":1},{"form_id":"0x000824|collision dialogue overhaul.esp","type":"INFO NAM1","string":"わたしの胸に興味
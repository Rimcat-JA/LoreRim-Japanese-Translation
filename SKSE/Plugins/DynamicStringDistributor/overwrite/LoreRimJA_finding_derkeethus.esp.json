[{"form_id":"0x000810|finding_derkeethus.esp","type":"INFO NAM1","string":"道中気をつけて、陸を歩く者よ","index":1},{"form_id":"0x00082C|finding_derkeethus.esp","type":"DIAL FULL","string":"見つけられるか探してみるよ。"},{"form_id":"0x00082E|finding_derkeethus.esp","type":"DIAL FULL","string":"彼はもう死んでいるだろうね"},{"form_id":"0x000830|finding_derkeethus.esp","type":"DIAL FULL","string":"無事に脱出できてよかった。"},{"form_id":"0x000832|finding_derkeethus.esp","type":"DIAL FULL","string":"あの洞窟で何か価値のある物を見つけたはずだろう"},{"form_id":"0x000834|finding_derkeethus.esp","type":"DIAL FULL","string":"今後はファルマーだらけの洞窟は避けるようにな。"},{"form_id":"0x000836|finding_derkeethus.esp","type":"DIAL FULL","string":"ソンダス・ドレニムが言っていた行方不明の漁師だね。"},{"form_id":"0x000843|finding_derkeethus.esp","type":"DIAL FULL","string":"さよなら、デルキーサス"}]
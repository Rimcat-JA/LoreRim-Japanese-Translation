[{"form_id":"0x000801|moretosaykarthwasten.esp","type":"DIAL FULL","string":"カースワステンについて教えてくれ"},{"form_id":"0x000802|moretosaykarthwasten.esp","type":"INFO NAM1","string":"カースワステンを仕切ってるのはアイネサックよ。あっちに聞いて。","index":1},{"form_id":"0x000802|moretosaykarthwasten.esp","type":"INFO RNAM","string":"カース・ワステンについて教えてくれ。"},{"form_id":"0x0008EF|moretosaykarthwasten.esp","type":"INFO NAM1","string":"カースワステンを仕切ってるのはアイネサックだよ。彼と話すといい。","index":1},{"form_id":"0x000804|moretosaykarthwasten.esp","type":"INFO NAM1","string":"鉱山で働いてる。狩りもする。それ以外は俺の勝手だ。","index":1},{"form_id":"0x000804|moretosaykarthwasten.esp","type":"INFO RNAM","string":"ここで何をしてるの？"},{"form_id":"0x000805|moretosaykarthwasten.esp","type":"DIAL FULL","string":"カースワステンを率いるのは大変だろうね。"},{"form_id":"0x000806|moretosaykarthwasten.esp","type":"INFO NAM1","string":"私は土地を持つ数少ないリーチ生まれの者の一人だ。おかげで、あまり好かれてはいない。","index":1},{"form_id":"0x000806|moretosaykarthwasten.esp","type":"INFO NAM1","string":"フォースウォーンが町を襲っていない時は、ノルドが私を追い出そうとしてくる。","index":2},{"form_id":"0x000806|moretosaykarthwasten.esp","type":"INFO RNAM","string":"カース砦を率いるのは大変だろうね。"},{"form_id":"0x000807|moretosaykarthwasten.esp","type":"DIAL FULL","string":"この辺りで何をしているんだ？"},{"form_id":"0x000808|moretosaykarthwasten.esp","type":"INFO NAM1","string":"俺はアイネサックの右腕だ。鉱山の監督を手伝ってる。","index":1},{"form_id":"0x000808|moretosaykarthwasten.esp","type":"INFO RNAM","string":"この辺りで何をしてるの？"},{"form_id":"0x000809|moretosaykarthwasten.esp","type":"DIAL FULL","string":"鉱山の様子はどう?"},{"form_id":"0x00080A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックが死んだ。これからカースワステンはどうなるんだ？","index":1},{"form_id":"0x00080A|moretosaykarthwasten.esp","type":"INFO RNAM","string":"鉱山の調子はどう？"},{"form_id":"0x00080B|moretosaykarthwasten.esp","type":"DIAL FULL","string":"アイネサックの下で働くのはどうだ？"},{"form_id":"0x00080C|moretosaykarthwasten.esp","type":"INFO NAM1","string":"リーチの民の下で働くノルドなんてそういないが、アイネサックはいい人だ。","index":1},{"form_id":"0x00080C|moretosaykarthwasten.esp","type":"INFO RNAM","string":"アイネタッハの下で働くのはどう？"},{"form_id":"0x00080D|moretosaykarthwasten.esp","type":"DIAL FULL","string":"フォースウォーンをどう思う？"},{"form_id":"0x00080E|moretosaykarthwasten.esp","type":"INFO NAM1","string":"警告しておく。あの連中は人殺しだ。一日だって持たないぞ。","index":1},{"form_id":"0x00080E|moretosaykarthwasten.esp","type":"INFO RNAM","string":"フォースウォーンをどう思う？"},{"form_id":"0x00080F|moretosaykarthwasten.esp","type":"DIAL FULL","string":"サヌアラク鉱山はいつ再開するんだ？"},{"form_id":"0x000810|moretosaykarthwasten.esp","type":"INFO NAM1","string":"さあな。シルバーブラッドの連中が出ていく気になるまでだろう。","index":1},{"form_id":"0x000810|moretosaykarthwasten.esp","type":"INFO RNAM","string":"サヌアラック鉱山はいつ再開するんだ？"},{"form_id":"0x000811|moretosaykarthwasten.esp","type":"DIAL FULL","string":"鉱山で働いているの？"},{"form_id":"0x000812|moretosaykarthwasten.esp","type":"INFO NAM1","string":"まあ、ああ。たぶんな。","index":1},{"form_id":"0x000812|moretosaykarthwasten.esp","type":"INFO NAM1","string":"いい方の鉱山は閉鎖され、もう一方には鉱石がない。神々に呪われたもんだ。","index":2},{"form_id":"0x00081C|moretosaykarthwasten.esp","type":"DIAL FULL","string":"本物の冒険はどうだ？"},{"form_id":"0x00081D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"サヌアラック鉱山がまた開いた。この仕事全部、どうやってさばけってんだ？","index":1},{"form_id":"0x00081D|moretosaykarthwasten.esp","type":"INFO RNAM","string":"調子はどう？"},{"form_id":"0x00081F|moretosaykarthwasten.esp","type":"DIAL FULL","string":"フォースウォーンをどう思う？"},{"form_id":"0x000820|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ドラゴンがうろついて戦争まで起きてるってのに、あんなことをするとは大した度胸だ。","index":1},{"form_id":"0x000820|moretosaykarthwasten.esp","type":"INFO RNAM","string":"フォースウォーンをどう思う？"},{"form_id":"0x000821|moretosaykarthwasten.esp","type":"DIAL FULL","string":"彼らに加わることはある?"},{"form_id":"0x000822|moretosaykarthwasten.esp","type":"INFO NAM1","string":"そうするかもな。どう思う？","index":1},{"form_id":"0x000822|moretosaykarthwasten.esp","type":"INFO RNAM","string":"彼らに加わることはある？"},{"form_id":"0x000823|moretosaykarthwasten.esp","type":"DIAL FULL","string":"フォースウォーンは故郷のために戦っているだけだ。"},{"form_id":"0x000824|moretosaykarthwasten.esp","type":"INFO NAM1","string":"確かだ。確かだとも。","index":1},{"form_id":"0x000824|moretosaykarthwasten.esp","type":"INFO NAM1","string":"いつも話せて楽しいよ…友よ。","index":2},{"form_id":"0x000824|moretosaykarthwasten.esp","type":"INFO RNAM","string":"フォースウォーンは故郷のために戦っているだけだ。"},{"form_id":"0x000825|moretosaykarthwasten.esp","type":"DIAL FULL","string":"フォースウォーンはただの野蛮人だ。"},{"form_id":"0x000826|moretosaykarthwasten.esp","type":"INFO NAM1","string":"忌々しいノルドめ。いつも俺たち正直者の邪魔ばかりしやがる。","index":1},{"form_id":"0x000826|moretosaykarthwasten.esp","type":"INFO RNAM","string":"フォースウォーンはただの野蛮人だ。"},{"form_id":"0x000827|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ああ、どうでもいい。","index":1},{"form_id":"0x000828|moretosaykarthwasten.esp","type":"DIAL FULL","string":"カースワステンについて教えてもらえる？"},{"form_id":"0x000829|moretosaykarthwasten.esp","type":"INFO NAM1","string":"お前と話すことなんて何もないね、よそ者。","index":1},{"form_id":"0x000829|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックと話せ。あの人が責任者だ。","index":2},{"form_id":"0x000829|moretosaykarthwasten.esp","type":"INFO RNAM","string":"カースワステンについて教えてくれる？"},{"form_id":"0x00082A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックと話せ。あの人が責任者だ。","index":1},{"form_id":"0x00082A|moretosaykarthwasten.esp","type":"INFO RNAM","string":"カースワステンについて教えてくれる？"},{"form_id":"0x00082C|moretosaykarthwasten.esp","type":"INFO NAM1","string":"カースワステンに、よそ者が首を突っ込む必要はない。","index":1},{"form_id":"0x00082C|moretosaykarthwasten.esp","type":"INFO RNAM","string":"落ち着いて。なぜそんなに敵意を?"},{"form_id":"0x000837|moretosaykarthwasten.esp","type":"DIAL FULL","string":"フォースウォーンに何かされた?"},{"form_id":"0x00083A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"その話はしたくないの。ごめんなさい。","index":1},{"form_id":"0x00083A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"お願い、フォースウォーンにまた見つかる前に神殿へ急ぎましょう。","index":2},{"form_id":"0x00083E|moretosaykarthwasten.esp","type":"DIAL FULL","string":"マルカルスへ向かう前に、カースワステンに戻りたい？"},{"form_id":"0x00083F|moretosaykarthwasten.esp","type":"INFO NAM1","string":"そうしたい…本当にそうしたいわ。荷物をまとめて、みんなにお別れを言わなきゃ。","index":1},{"form_id":"0x00083F|moretosaykarthwasten.esp","type":"INFO NAM1","string":"みんながいないと、もう前と同じじゃなくなるわね。","index":2},{"form_id":"0x000843|moretosaykarthwasten.esp","type":"DIAL FULL","string":"鉱山について何か知ってる？"},{"form_id":"0x000844|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックと話せ。鉱山を仕切ってる。いや、仕切ってた、か。","index":1},{"form_id":"0x000844|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックがシルバーブラッドの連中を追い払ってくれりゃ、また仕事に戻れるんだがな。","index":2},{"form_id":"0x000845|moretosaykarthwasten.esp","type":"INFO NAM1","string":"アイネサックは死んだ。だからって仕事をやめるわけにはいかん。","index":1},{"form_id":"0x000845|moretosaykarthwasten.esp","type":"INFO RNAM","string":"今も鉱山で働いてるの?"},{"form_id":"0x000847|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ラグナーをどう思う？"},{"form_id":"0x000848|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ラグナルは腕っぷしが強い。オークじゃないのが惜しいな。","index":1},{"form_id":"0x00084B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"何の用？放っておいてくれないの？","index":1},{"form_id":"0x00084C|moretosaykarthwasten.esp","type":"DIAL FULL","string":"話がしたいだけだ。"},{"form_id":"0x00084D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"よそ者なんて厄介事しか持ち込まないわ。","index":1},{"form_id":"0x00084D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"カースワステンは問題で手一杯なの。放っておいて。","index":2},{"form_id":"0x000850|moretosaykarthwasten.esp","type":"INFO NAM1","string":"鉱山に用があるならアイネサックと話してくれ。もっとも、最近は大した用もないがな。","index":1},{"form_id":"0x000851|moretosaykarthwasten.esp","type":"DIAL FULL","string":"鉱山の状況はどうだ？"},{"form_id":"0x000852|moretosaykarthwasten.esp","type":"INFO NAM1","string":"フォースウォーンの襲撃もひどいが、あの傭兵どもはもっとたちが悪い。","index":1},{"form_id":"0x000854|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ノルドとの揉め事はまだある？"},{"form_id":"0x000855|moretosaykarthwasten.esp","type":"INFO NAM1","string":"シルバーブラッドがこれで手を引くとは思えんが、少なくとも鉱山は両方とも再開した。","index":1},{"form_id":"0x000855|moretosaykarthwasten.esp","type":"INFO NAM1","string":"みんな仕事に戻る時だ。ようやくな。","index":2},{"form_id":"0x000868|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ふん。いや、友よ、そうではない。","index":1},{"form_id":"0x000868|moretosaykarthwasten.esp","type":"INFO NAM1","string":"悪い結果に終わるとわかっていればな。奴らはいつも欲しいものを手に入れる。どうにかしてな。","index":2},{"form_id":"0x000868|moretosaykarthwasten.esp","type":"INFO NAM1","string":"まあ、いい教訓になったとでも言っておこう。","index":3},{"form_id":"0x000868|moretosaykarthwasten.esp","type":"INFO RNAM","string":"まだシルバーブラッド家に迷惑をかけてる？"},{"form_id":"0x000857|moretosaykarthwasten.esp","type":"DIAL FULL","string":"シルバーブラッド家について何か知ってる？"},{"form_id":"0x000858|moretosaykarthwasten.esp","type":"INFO NAM1","string":"盗人の一族だ。マルカルスから腐った帝国を牛耳っている。","index":1},{"form_id":"0x000858|moretosaykarthwasten.esp","type":"INFO NAM1","string":"シルバーブラッド家はリーチの半分を所有している。全てを手に入れるまで止まらんだろう。","index":2},{"form_id":"0x00085A|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ラッシュをどう思う？"},{"form_id":"0x00085B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"オークと寝床を共にするのは好かん。どうも…不潔でな。","index":1},{"form_id":"0x00085D|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ラグナーをどう思う？"},{"form_id":"0x00085E|moretosaykarthwasten.esp","type":"INFO NAM1","string":"忌々しいノルドめ。いつも俺たち正直者の邪魔ばかりしやがる。","index":1},{"form_id":"0x000860|moretosaykarthwasten.esp","type":"DIAL FULL","string":"いくつか質問してもいいか?"},{"form_id":"0x000861|moretosaykarthwasten.esp","type":"INFO NAM1","string":"鉱山は閉鎖中だ。失せろ。","index":1},{"form_id":"0x000862|moretosaykarthwasten.esp","type":"DIAL FULL","string":"誰の権限で?"},{"form_id":"0x000863|moretosaykarthwasten.esp","type":"INFO NAM1","string":"シルバーブラッドに、この鉱山を「守る」よう言われて来たんだ。","index":1},{"form_id":"0x000865|moretosaykarthwasten.esp","type":"DIAL FULL","string":"いくつか質問してもいいか?"},{"form_id":"0x000867|moretosaykarthwasten.esp","type":"INFO NAM1","string":"また会えたな、友よ。君がしてくれたことは決して忘れない。","index":1},{"form_id":"0x00086B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"この辺りじゃ旅人はあまり見かけないわね。","index":1},{"form_id":"0x00086B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"あなた、ずいぶん冒険をしてきたみたいね。","index":2},{"form_id":"0x00086D|moretosaykarthwasten.esp","type":"DIAL FULL","string":"この辺りの宿を教えてもらえる？"},{"form_id":"0x00086E|moretosaykarthwasten.esp","type":"INFO NAM1","string":"部屋を探してるなら、フォー・シールドへ行くといいわ。","index":1},{"form_id":"0x000870|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ここの農作業の具合はどう？"},{"form_id":"0x000871|moretosaykarthwasten.esp","type":"INFO NAM1","string":"スカイリムの荒野で暮らしを立てるのは楽じゃないわ。","index":1},{"form_id":"0x000871|moretosaykarthwasten.esp","type":"INFO NAM1","string":"この土地は厳しくて容赦ないけど、美しくもあるのよ。","index":2},{"form_id":"0x000873|moretosaykarthwasten.esp","type":"DIAL FULL","string":"最近何か知らせや噂は?"},{"form_id":"0x000874|moretosaykarthwasten.esp","type":"INFO NAM1","string":"戦争の話、聞いた？ここまで来なければいいんだけど。","index":1},{"form_id":"0x000874|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ストームクロークが余計な騒ぎを起こさなくても、世の中には十分厄介事があるのに。","index":2},{"form_id":"0x000877|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ようこそ、旅の人。この町では行儀よくしてくれよ。","index":1},{"form_id":"0x000877|moretosaykarthwasten.esp","type":"INFO NAM1","string":"最近、たちの悪い連中が通りかかってな。マルカルスを出た時に、ああいう輩とは縁が切れたと思ってたんだが。","index":2},{"form_id":"0x000879|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴン・ブリッジについて何か知ってる？"},{"form_id":"0x00087A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ソリチュードやマルカルスみたいな大都市じゃないが、俺たちはこれが気に入ってるんだ。","index":1},{"form_id":"0x00087A|moretosaykarthwasten.esp","type":"INFO NAM1","string":"もちろん、あんたはいつでも歓迎だ。だが、面倒を起こすつもりはないと信じてるぞ。","index":2},{"form_id":"0x00087C|moretosaykarthwasten.esp","type":"DIAL FULL","string":"家族について教えてくれ"},{"form_id":"0x00087D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"愛する妻に元気な息子、それに自分の土地もある。男としてこれ以上何を望む？","index":1},{"form_id":"0x00087D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"九大神のご加護か？そうかもな…誰にもわからんさ。","index":2},{"form_id":"0x00087D|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ただ一つ言えるのは、ミシェルがいなけりゃ、今頃マルカルスのどぶで死んでただろうってことだ。","index":3},{"form_id":"0x00087F|moretosaykarthwasten.esp","type":"DIAL FULL","string":"仕事について教えてくれ。"},{"form_id":"0x000880|moretosaykarthwasten.esp","type":"INFO NAM1","string":"いつか自分の宿屋を開きたいの。","index":1},{"form_id":"0x000880|moretosaykarthwasten.esp","type":"INFO NAM1","string":"そんな目で見るのはやめて。","index":2},{"form_id":"0x000881|moretosaykarthwasten.esp","type":"DIAL FULL","string":"野心的だね。"},{"form_id":"0x000882|moretosaykarthwasten.esp","type":"INFO NAM1","string":"まだ勉強を始めたばかりだけど、ファイダが宿屋の仕事を教えてくれてるの。","index":1},{"form_id":"0x000882|moretosaykarthwasten.esp","type":"INFO NAM1","string":"彼女はフォー・シールドを経営してるの。いつか宿屋を開くなら、もっと経験を積まなきゃいけないのはわかってる。","index":2},{"form_id":"0x000884|moretosaykarthwasten.esp","type":"DIAL FULL","string":"最近何か知らせや噂は?"},{"form_id":"0x000885|moretosaykarthwasten.esp","type":"INFO NAM1","string":"最初は戦争、今度はドラゴンの話。次は何？","index":1},{"form_id":"0x000885|moretosaykarthwasten.esp","type":"INFO NAM1","string":"吸血鬼とか？","index":2},{"form_id":"0x000888|moretosaykarthwasten.esp","type":"INFO NAM1","string":"なんだか怖そうな人だね。面倒を起こすつもりじゃないといいけど。","index":1},{"form_id":"0x00088A|moretosaykarthwasten.esp","type":"DIAL FULL","string":"家族の農場を手伝っている？"},{"form_id":"0x00088B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"うん、でも農夫にはなりたくないんだ。いつか兵士になるんだよ。","index":1},{"form_id":"0x00088B|moretosaykarthwasten.esp","type":"INFO NAM1","string":"兵士なの？","index":2},{"form_id":"0x00088C|moretosaykarthwasten.esp","type":"DIAL FULL","string":"軍団の者だ。"},{"form_id":"0x000891|moretosaykarthwasten.esp","type":"INFO NAM1","string":"すごい！僕も兵士だったらなあ。僕が戦えるようになるまで、この戦争が続くといいな。","index":1},{"form_id":"0x000891|moretosaykarthwasten.esp","type":"INFO NAM1","string":"僕は誰も怖くないよ。剣さえ持たせてくれれば、いざとなったらこの場所を守れるんだ！","index":2},{"form_id":"0x00088D|moretosaykarthwasten.esp","type":"DIAL FULL","string":"なぜそんなに兵士になりたいんだ？"},{"form_id":"0x000890|moretosaykarthwasten.esp","type":"INFO NAM1","string":"兵士は旅ができるし、夜更かしもできるし、楽しいんだ！僕は戦士になりたい。史上最強の戦士に！","index":1},{"form_id":"0x00088E|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ストームクロークの者だ。"},{"form_id":"0x00088F|moretosaykarthwasten.esp","type":"INFO NAM1","string":"面倒を起こしに来たんじゃないよね。いざとなったら僕が相手になるぞ。","index":1},{"form_id":"0x000893|moretosaykarthwasten.esp","type":"DIAL FULL","string":"何をしている？"},{"form_id":"0x000894|moretosaykarthwasten.esp","type":"INFO NAM1","string":"父ちゃんは戦争に行くにはまだ小さすぎるって言うけど、町の見回りなら手伝えるんだ。","index":1},{"form_id":"0x000894|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ラッキーに会った？僕のペットのヤギで、見回りを手伝ってくれるんだ。","index":2},{"form_id":"0x000894|moretosaykarthwasten.esp","type":"INFO NAM1","string":"僕の一番の親友なんだ。","index":3},{"form_id":"0x000896|moretosaykarthwasten.esp","type":"DIAL FULL","string":"失礼…"},{"form_id":"0x000897|moretosaykarthwasten.esp","type":"INFO NAM1","string":"うちのろくでなし亭主に頼まれて来たのかい？あの怠け者はどこにいるんだい？","index":1},{"form_id":"0x000898|moretosaykarthwasten.esp","type":"DIAL FULL","string":"話がしたかっただけだよ。"},{"form_id":"0x000899|moretosaykarthwasten.esp","type":"INFO NAM1","string":"あたしに何か売りつけようってのかい？お断りだよ。","index":1},{"form_id":"0x000899|moretosaykarthwasten.esp","type":"INFO NAM1","string":"見知らぬ連中に話すことなんかないね。","index":2},{"form_id":"0x00089B|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴン・ブリッジについて教えてもらえる？"},{"form_id":"0x00089C|moretosaykarthwasten.esp","type":"INFO NAM1","string":"部屋が必要なら、フォー・シールドへ行くといい。","index":1},{"form_id":"0x00089C|moretosaykarthwasten.esp","type":"INFO NAM1","string":"物資を探してるなら、ソリチュードへ向かうことをすすめる。","index":2},{"form_id":"0x00089C|moretosaykarthwasten.esp","type":"INFO NAM1","string":"施しを求めてるなら、よそを当たってくれ。","index":3},{"form_id":"0x00089D|moretosaykarthwasten.esp","type":"DIAL FULL","string":"冷たい態度だね"},{"form_id":"0x00089E|moretosaykarthwasten.esp","type":"INFO NAM1","string":"旅人にも難民にも、ここで分けてやれるものは何もない。","index":1},{"form_id":"0x00089E|moretosaykarthwasten.esp","type":"INFO NAM1","string":"この世で何か欲しけりゃ、奪い取るしかない。ただし、俺からはやめてくれ。","index":2},{"form_id":"0x0008A0|moretosaykarthwasten.esp","type":"DIAL FULL","string":"仕事について教えてくれ。"},{"form_id":"0x0008A1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"製材所が焼けてから金に困っててな。女房はそのことを一生忘れさせてくれない。","index":1},{"form_id":"0x0008A1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"また動かすのにとんでもない手間がかかった。今はその甲斐があったと思えるといいんだが。","index":2},{"form_id":"0x0008A1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"懸命に働けば、浴びるように飲む理由もできるってもんだ！まあ、それと、うちみたいな女房に耐えることもな。","index":3},{"form_id":"0x0008A3|moretosaykarthwasten.esp","type":"DIAL FULL","string":"他に気に入っている酒場はある？"},{"form_id":"0x0008A4|moretosaykarthwasten.esp","type":"INFO NAM1","string":"あんた、旅慣れてるな。見ただけでわかるよ。","index":1},{"form_id":"0x0008A4|moretosaykarthwasten.esp","type":"INFO NAM1","string":"マルカルスには行ったことあるか？シルバーブラッド・インって酒場があってな。スカイリムで一番のエールが飲めるぞ。","index":2},{"form_id":"0x0008A5|moretosaykarthwasten.esp","type":"DIAL FULL","string":"この辺で飲める所はどこだろう？"},{"form_id":"0x0008A6|moretosaykarthwasten.esp","type":"INFO NAM1","string":"大したところじゃないが、フォー・シールドって酒場がある。","index":1},{"form_id":"0x0008A7|moretosaykarthwasten.esp","type":"DIAL FULL","string":"酒の良さが分かるんだな？"},{"form_id":"0x0008A8|moretosaykarthwasten.esp","type":"INFO NAM1","string":"強い酒、鋭い斧、いい女。ノルドが幸せになるにはそれだけあればいいって言うだろ。三つのうち二つなら悪くないさ。","index":1},{"form_id":"0x0008AB|moretosaykarthwasten.esp","type":"INFO NAM1","string":"あんた、何か普通と違うね。わかるよ。面倒を起こしに来たんじゃなきゃいいけど。","index":1},{"form_id":"0x0008AB|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ファイダだよ。この宿をやってる。","index":2},{"form_id":"0x0008AB|moretosaykarthwasten.esp","type":"INFO NAM1","string":"何か欲しかったら言っておくれ。首長の宴とはいかないけど、腹は満たせるよ。","index":3},{"form_id":"0x0008AD|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴン・ブリッジには訪問者が多い？"},{"form_id":"0x0008AF|moretosaykarthwasten.esp","type":"INFO NAM1","string":"最近は旅人もよく見かけるね。今じゃ大半は兵士さ。","index":1},{"form_id":"0x0008AF|moretosaykarthwasten.esp","type":"INFO NAM1","string":"実のところ、戦争が始まってからこんなに忙しいのは初めてだよ。","index":2},{"form_id":"0x0008AE|moretosaykarthwasten.esp","type":"INFO NAM1","string":"客はほとんど地元の人間だけど、最近は旅人もよく見かけるね。今じゃ大半は兵士さ。","index":1},{"form_id":"0x0008B1|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ホルゲイルとオルダをどう思う？"},{"form_id":"0x0008B2|moretosaykarthwasten.esp","type":"INFO NAM1","string":"かわいそうなホルジェール。奥さんの浮気は町中が知ってるのに、本人だけ知らないんだ。知らないほうが幸せかもしれないけどね。","index":1},{"form_id":"0x0008B4|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴン・ブリッジについて何か知ってる？"},{"form_id":"0x0008B5|moretosaykarthwasten.esp","type":"INFO NAM1","string":"よくよく考えてみれば、ここはなかなかいい町だよ。","index":1},{"form_id":"0x0008B5|moretosaykarthwasten.esp","type":"INFO NAM1","string":"リルヴィエーブ家には会ったかい？物静かな一家だけど、ドラゴンブリッジの要なんだよ。","index":2},{"form_id":"0x0008B5|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ジュリエンヌはいつか立派な宿の主人になるよ。","index":3},{"form_id":"0x0008B7|moretosaykarthwasten.esp","type":"DIAL FULL","string":"どうしてここで宿屋をやることになったんだ?"},{"form_id":"0x0008B8|moretosaykarthwasten.esp","type":"INFO NAM1","string":"旦那に出会ったときは、ウインキング・スキーヴァーで給仕をしてたんだ。安らかに眠っておくれ。あの人がいなかったら、今もあそこで働いてたよ！","index":1},{"form_id":"0x0008BA|moretosaykarthwasten.esp","type":"DIAL FULL","string":"オルダをどう思う？"},{"form_id":"0x0008BB|moretosaykarthwasten.esp","type":"INFO NAM1","string":"オルダはなんでみんなに意地悪なの？ロドヴァーと一緒のときしか機嫌よくないし、結婚してるわけでもないのに！","index":1},{"form_id":"0x0008BD|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴンのことが心配か?"},{"form_id":"0x0008BE|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ドラゴンはあたしたちを試しに来たんだと思うよ。まだ真のノルドかどうか確かめるためにね。","index":1},{"form_id":"0x0008C0|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ウルフスカル洞窟について何か知ってる？"},{"form_id":"0x0008C1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"あの洞窟から妙な魔力が出ている。奇妙な音や光もな。","index":1},{"form_id":"0x0008C1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"少なくとも俺は役目を果たした。ドラゴンブリッジには衛兵が増える。ファルク・ファイアビアードが洞窟を何とかする方法を見つけてくれるだろう。","index":2},{"form_id":"0x0008C3|moretosaykarthwasten.esp","type":"DIAL FULL","string":"ドラゴン・ブリッジについて教えてくれ"},{"form_id":"0x0008C4|moretosaykarthwasten.esp","type":"INFO NAM1","string":"法を守っていれば、ドラゴンブリッジで面倒なことにはならない。","index":1},{"form_id":"0x0008C7|moretosaykarthwasten.esp","type":"INFO NAM1","string":"ああ、それとタシウスには逆らうなよ。ここの責任者だからな。","index":1},{"form_id":"0x0008C8|moretosaykarthwasten.esp","type":"DIAL FULL","string":"揉め事を起こしに来たんじゃない。"},{"form_id":"0x0008C9|moretosaykarthwasten.esp","type":"INFO NAM1","string":"問題さえ起こさなければ、うまくやっていけると思うぞ。","index":1},{"form_id":"0x0008CA|moretosaykarthwasten.esp","type":"DIAL FULL","string":"好きにやらせてもらう。"},{"form_id":"0x0008CB|moretosaykarthwasten.esp","type":"INFO NAM1","string":"せめて、揉め事を起こすなら他所でやってくれ。いいな？頼むよ。","index":1},{"form_id":"0x0008CE|moretosaykarthwasten.esp","type":"INFO NAM1","string":"私の任務はテュリウス将軍にお仕えすることだ。追って通達があるまで、ここは私が指揮を執る。","index":1},{"form_id":"0x0008CE|moretosaykarthwasten.esp","type":"INFO NAM1","string":"テュリウス将軍は私に大きな期待を寄せておられる。帝国はこの橋を守り抜かねばならん。","index":2},{"form_id":"0x0008D0|moretosaykarthwasten.esp","type":"DIAL FULL","string":"帝国軍にはどうすれば入隊できる？"},{"form_id":"0x0008D1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"根性があると思っているのか、ん？","index":1},{"form_id":"0x0008D1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"正直なところ、帝国軍は使える人間なら誰でも欲しい。手一杯なのだ。王は死に、反乱が起き、今度はドラゴンだと？スカイリムはめちゃくちゃだ。","index":2},{"form_id":"0x0008D1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"本気ならソリチュードへ行け。我々の本部はドール城だ。そこでテュリウス将軍がスカイリムの軍を指揮しておられる。","index":3},{"form_id":"0x0008D1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"だが、リッケ特使と話すといい。彼女が現地の募兵を担当している。","index":4},{"form_id":"0x0008D5|moretosaykarthwasten.esp","type":"INFO NAM1","string":"失礼、あなたに話すことは何もありません。","index":1},{"form_id":"0x0008D8|moretosaykarthwasten.esp","type":"INFO NAM1","string":"とっとと行け、よそ者。","index":1},{"form_id":"0x0008D9|moretosaykarthwasten.esp","type":"INFO NAM1","string":"飲み物が欲しかったら言ってね。","index":1},{"form_id":"0x0008E0|moretosaykarthwasten.esp","type":"INFO NAM1","string":"市民よ。","index":1},{"form_id":"0x0008E1|moretosaykarthwasten.esp","type":"INFO NAM1","string":"市民よ。","index":1},{"form_id":"0x000840|moretosaykarthwasten.esp","type":"QUST FULL","string":"More to Say ドラゴン・ブリッジ"},{"form_id":"0x000841|moretosaykarthwasten.esp","type":"QUST FULL","string":"More to Say オールド・フロルダン"},{"form_id":"0x000800|moretosaykarthwasten.esp","type":"QUST FULL","string":"More to Say カースワステン"}]
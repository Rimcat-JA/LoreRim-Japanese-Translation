[{"form_id":"0x000887|infiltration - quest expansion.esp","type":"BOOK FULL","string":"妻へ"},{"form_id":"0x000887|infiltration - quest expansion.esp","type":"BOOK DESC","string":"<font face=\"$HandwrittenFont\">\r\n\r\n親愛なるウラへ、\r\n\r\n君からの最後の手紙から何週間も経ち、僕の心は不安で重い。\r\n\r\nブルリッドについて君が聞いた話は本当だ。彼は刑務所から逃げ出した。僕は彼が君やエリクを襲って復讐しようとするのではないかと恐れている。あの男は病んだろくでなしだ。君の兄が砦に滞在しているのは知っているが、彼は戦士ではないし、君が無事かどうか分からないままではいられない。僕は家に帰る。\r\n\r\nスタレオ"},{"form_id":"0x000D62|infiltration - quest expansion.esp","type":"NPC_ FULL","string":"ブリュリド"},{"form_id":"0x000869|infiltration - quest expansion.esp","type":"KEYM FULL","string":"トレヴァ監視所の門の鍵"},{"form_id":"0x000835|infiltration - quest expansion.esp","type":"INFO NAM1","string":"本当に大きな恩ができた。このことは決して忘れない。","index":1},{"form_id":"0x000835|infiltration - quest expansion.esp","type":"INFO NAM1","string":"私の家族は……私は……亡くなった者たちを弔い、自分の人生を見つめ直す時間が必要だ。","index":2},{"form_id":"0x000877|infiltration - quest expansion.esp","type":"INFO NAM1","string":"待つのはもううんざりだ。いつになったら一暴れできるんだ？","index":1},{"form_id":"0x000878|infiltration - quest expansion.esp","type":"INFO NAM1","string":"さっさと行け。見世物じゃないぞ。","index":1},{"form_id":"0x000843|infiltration - quest expansion.esp","type":"INFO NAM1","string":"油断するな。","index":1},{"form_id":"0x000851|infiltration - quest expansion.esp","type":"INFO NAM1","string":"このろくでなしどもに思い知らせてやろう。","index":1},{"form_id":"0x000844|infiltration - quest expansion.esp","type":"INFO NAM1","string":"案内してくれ。","index":1},{"form_id":"0x00086F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"話している暇はない。先へ進むぞ！","index":1},{"form_id":"0x000853|infiltration - quest expansion.esp","type":"INFO NAM1","string":"やったぞ!","index":1},{"form_id":"0x000852|infiltration - quest expansion.esp","type":"INFO NAM1","string":"よし、行くぞ!","index":1},{"form_id":"0x00084C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"待ち伏せに気をつけろ。こういう砦には死角が多すぎる。","index":1},{"form_id":"0x00084D|infiltration - quest expansion.esp","type":"INFO NAM1","string":"背中は任せろ、心配するな。","index":1},{"form_id":"0x000845|infiltration - quest expansion.esp","type":"INFO NAM1","string":"蜂蜜酒を持ってくるなら大歓迎だ! 持ってこなくても、もちろん歓迎だぞ!","index":1},{"form_id":"0x00084F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"思い知らせてやったな? 色々と手を貸してくれて感謝するよ。","index":1},{"form_id":"0x000850|infiltration - quest expansion.esp","type":"INFO NAM1","string":"今回のことでは力を貸してくれて感謝する。","index":1},{"form_id":"0x000846|infiltration - quest expansion.esp","type":"INFO NAM1","string":"英雄のお帰りか。好きなだけここにいてくれて構わんよ。それが筋というものだ。","index":1},{"form_id":"0x000864|infiltration - quest expansion.esp","type":"INFO NAM1","string":"よい知らせを持ってきたのだろうな。そうでないなら、どうか口を慎んでくれ。","index":1},{"form_id":"0x000876|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ようやく運が向いてきたと思わないか？","index":1},{"form_id":"0x000848|infiltration - quest expansion.esp","type":"INFO NAM1","string":"何の用だ?","index":1},{"form_id":"0x000847|infiltration - quest expansion.esp","type":"INFO NAM1","string":"他にやるべきことがあるのではないかね?","index":1},{"form_id":"0x000801|infiltration - quest expansion.esp","type":"DIAL FULL","string":"この砦から出て行け、さもないと殺す。勝ち目はないぞ。(威圧)"},{"form_id":"0x000802|infiltration - quest expansion.esp","type":"INFO NAM1","string":"どうやらストーリオに言いくるめられて、手先にされたようだな……この計画はもう成り立たん。","index":1},{"form_id":"0x000802|infiltration - quest expansion.esp","type":"INFO NAM1","string":"主人のもとへ走って帰り、砦はまたお前のものだと伝えるがいい。ああ、それと地下室には近づかないほうがいいとも伝えておけ。","index":2},{"form_id":"0x000803|infiltration - quest expansion.esp","type":"INFO NAM1","string":"その説を証明してみせろ!","index":1},{"form_id":"0x000805|infiltration - quest expansion.esp","type":"DIAL FULL","string":"スタレオはもう問題にならない。"},{"form_id":"0x000806|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ようやくか。この世から裏切り者が一人減った。有能な者の仕事ぶりを見るのは実に愉快だ。","index":1},{"form_id":"0x000806|infiltration - quest expansion.esp","type":"INFO NAM1","string":"その行いにふさわしい報酬だ。さあ、私を一人にしてくれ。","index":2},{"form_id":"0x000808|infiltration - quest expansion.esp","type":"INFO NAM1","string":"正しい判断をしたな。ストーリオもついに報いを受けたというわけだ。","index":1},{"form_id":"0x000808|infiltration - quest expansion.esp","type":"INFO NAM1","string":"これが報酬だ。さあ、砦は私に任せて去るがいい。","index":2},{"form_id":"0x00080A|infiltration - quest expansion.esp","type":"DIAL FULL","string":"ブルリッドには勝ち目はない。ここから逃げるべきだ。(説得)"},{"form_id":"0x00080B|infiltration - quest expansion.esp","type":"INFO NAM1","string":"わかった、そうだな、言いたいことはわかる……だが私の家族が……襲撃の前に無事逃げ延びていてくれればいいが。","index":1},{"form_id":"0x00080C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"断る。答えはノーだと言っているだろう。わかったか?!","index":1},{"form_id":"0x00080E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"薄汚い山賊め……","index":1},{"form_id":"0x000E03|infiltration - quest expansion.esp","type":"INFO NAM1","string":"先へ進まないと！","index":1},{"form_id":"0x000834|infiltration - quest expansion.esp","type":"INFO NAM1","string":"死ね、この犬め!","index":1},{"form_id":"0x000810|infiltration - quest expansion.esp","type":"DIAL FULL","string":"砦はブルリッドのものだ。出ていけ、さもないとその場で殺す。(威圧)"},{"form_id":"0x000811|infiltration - quest expansion.esp","type":"INFO NAM1","string":"わかったよ。私の家族の血は、ブリュリドだけでなくお前の手にもついていると思え。","index":1},{"form_id":"0x000812|infiltration - quest expansion.esp","type":"INFO NAM1","string":"何だと?! 家族は私のすべてなんだ……殺してやる!","index":1},{"form_id":"0x000813|infiltration - quest expansion.esp","type":"DIAL FULL","string":"実は、あなたを殺しに来た。"},{"form_id":"0x000814|infiltration - quest expansion.esp","type":"INFO NAM1","string":"何だと?! いいだろう、好きにしろ。戦いだ!","index":1},{"form_id":"0x000816|infiltration - quest expansion.esp","type":"DIAL FULL","string":"一緒に行った方が楽だ。(説得)"},{"form_id":"0x000817|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そうか……わかった、確かにそうだな。行こう。","index":1},{"form_id":"0x000817|infiltration - quest expansion.esp","type":"INFO NAM1","string":"案内してくれ。","index":2},{"form_id":"0x000818|infiltration - quest expansion.esp","type":"INFO NAM1","string":"それをしながら、同時にここを見張るのは無理だ。","index":1},{"form_id":"0x000818|infiltration - quest expansion.esp","type":"INFO NAM1","string":"先に行ってくれ。私は見張りをしておく。","index":2},{"form_id":"0x00081A|infiltration - quest expansion.esp","type":"DIAL FULL","string":"知る必要はない"},{"form_id":"0x000D77|infiltration - quest expansion.esp","type":"INFO NAM1","string":"英雄気取りの類か？ いいか、私はそこらの腑抜けた略奪者とは違う。私を殺したところで何の得にもならんぞ。","index":1},{"form_id":"0x000D77|infiltration - quest expansion.esp","type":"INFO NAM1","string":"高潔な行いがしたいのか？ ならば正しい方向を示してやろう……ストーリオだ。","index":2},{"form_id":"0x000D77|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴は腰抜けの裏切り者だ。昔は良き友人だったが、奴は私に背を向け、牢獄に放り込んだのだ。","index":3},{"form_id":"0x000D77|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴には裏切りの報いを受けさせねばならん。これをやってくれれば、たっぷりと報いよう。","index":4},{"form_id":"0x00081F|infiltration - quest expansion.esp","type":"DIAL FULL","string":"まだだ。"},{"form_id":"0x000820|infiltration - quest expansion.esp","type":"INFO NAM1","string":"では、さっそく取りかかってくれ。","index":1},{"form_id":"0x000823|infiltration - quest expansion.esp","type":"INFO NAM1","string":"お前のせいでこうなったんだ! お前のせいで!","index":1},{"form_id":"0x000825|infiltration - quest expansion.esp","type":"INFO NAM1","string":"これで裏切られる気持ちがわかっただろう! 当然の報いだ!","index":1},{"form_id":"0x000828|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そんな、嘘だ! 妻が……死んでいる!","index":1},{"form_id":"0x000828|infiltration - quest expansion.esp","type":"INFO NAM1","string":"息子が死んだ。あいつら全員オブリビオンに落ちてしまえ!","index":2},{"form_id":"0x000828|infiltration - quest expansion.esp","type":"INFO NAM1","string":"復讐してやる!","index":3},{"form_id":"0x000828|infiltration - quest expansion.esp","type":"INFO NAM1","string":"あの化け物を追い詰めて……殺してやる!","index":4},{"form_id":"0x00082A|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そこのお前! この男は忠誠を尽くすに値しない。私にしたのと同じように、お前の背中も刺すだろう。","index":1},{"form_id":"0x00082A|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そいつを殺せ。そうすればたっぷり報酬をやろう!","index":2},{"form_id":"0x00082C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"殺してやる!","index":1},{"form_id":"0x00082F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"よし……","index":1},{"form_id":"0x00082F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"さて……先に進んで、道が安全か確かめよう。","index":2},{"form_id":"0x000832|infiltration - quest expansion.esp","type":"DIAL FULL","string":"残念だが、彼らは死んだ"},{"form_id":"0x000833|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ああ、神々よ……私の家族が……私は……","index":1},{"form_id":"0x000833|infiltration - quest expansion.esp","type":"INFO NAM1","string":"亡くなった者たちを弔い……自分の人生を見つめ直す時間が必要だ。","index":2},{"form_id":"0x000839|infiltration - quest expansion.esp","type":"INFO NAM1","string":"今はもう、立て直すしかない。","index":1},{"form_id":"0x000839|infiltration - quest expansion.esp","type":"INFO NAM1","string":"何だこの臭いは? 木が腐ってるのか? まずいな。","index":2},{"form_id":"0x000839|infiltration - quest expansion.esp","type":"INFO NAM1","string":"立て直すには時間がかかるだろうが、ノルドは苦労には慣れている。","index":3},{"form_id":"0x00083B|infiltration - quest expansion.esp","type":"DIAL FULL","string":"家族のことは気の毒だった"},{"form_id":"0x00083C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ありがとう。イスミールの祝福を。","index":1},{"form_id":"0x00083E|infiltration - quest expansion.esp","type":"DIAL FULL","string":"下の階の家族を殺したのはお前か？"},{"form_id":"0x00083F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ふむ、あれは不運な出来事だった。残念ながら、山賊どもが彼らを限界まで追い詰めたのだろう。","index":1},{"form_id":"0x00083F|infiltration - quest expansion.esp","type":"INFO NAM1","string":"少々手荒に扱いすぎた、と言えばわかるかね。死なせるつもりはなかったのだ。","index":2},{"form_id":"0x000842|infiltration - quest expansion.esp","type":"INFO NAM1","string":"この無駄に大きな城で快適に暮らすとしよう。実験やら何やらをする場所はいくらでもある。","index":1},{"form_id":"0x00084A|infiltration - quest expansion.esp","type":"DIAL FULL","string":"なぜ投獄されたんだ？"},{"form_id":"0x00084B|infiltration - quest expansion.esp","type":"INFO NAM1","string":"おいおい……なんと無礼な質問だ。そんなことを聞くべきでないことくらい、わかっているだろう?","index":1},{"form_id":"0x00084B|infiltration - quest expansion.esp","type":"INFO NAM1","string":"私は魔術師だ。連中は何かと理由をつけて我々を閉じ込めようとする。嫉妬だよ。間違いない。","index":2},{"form_id":"0x000857|infiltration - quest expansion.esp","type":"INFO NAM1","string":"さて、どうする? 共にこの裏切り者に思い知らせてやろうではないか!","index":1},{"form_id":"0x000858|infiltration - quest expansion.esp","type":"DIAL FULL","string":"私はスタレオの味方だ。死ぬ覚悟をしろ。"},{"form_id":"0x000859|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ならばそうしよう。","index":1},{"form_id":"0x00085A|infiltration - quest expansion.esp","type":"DIAL FULL","string":"報酬だって? いいだろう。協力するよ、ブルリッド"},{"form_id":"0x00085B|infiltration - quest expansion.esp","type":"INFO NAM1","string":"実に賢明な選択だ。","index":1},{"form_id":"0x00085E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"今度はお前が自分の汚い薬の味を知る番だ、ストーリオ!","index":1},{"form_id":"0x000860|infiltration - quest expansion.esp","type":"INFO NAM1","string":"お前を見損なったよ。好きにしろ。戦いだ!","index":1},{"form_id":"0x000862|infiltration - quest expansion.esp","type":"DIAL FULL","string":"スタレオはもう死んでいる。"},{"form_id":"0x000863|infiltration - quest expansion.esp","type":"INFO NAM1","string":"本当か?……それは興味深い。","index":1},{"form_id":"0x000863|infiltration - quest expansion.esp","type":"INFO NAM1","string":"まあ、お前が関わっていたと考えるしかなかろう。あいつはお前にも何か悪事を働いたのだろうな。","index":2},{"form_id":"0x000863|infiltration - quest expansion.esp","type":"INFO NAM1","string":"善行にふさわしい報酬として、これを受け取るがいい。","index":3},{"form_id":"0x000865|infiltration - quest expansion.esp","type":"DIAL FULL","string":"なぜスタレオが裏切り者なんだ？"},{"form_id":"0x000866|infiltration - quest expansion.esp","type":"INFO NAM1","string":"戦争の前は良き友人同士だった。だが戦いが始まってからは、どうにも意見が合わなくなってな。","index":1},{"form_id":"0x000866|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴は私を牢獄に放り込んだのだ！ 今や奴には裏切り者にふさわしい最期こそがお似合いだ。手を貸してくれるか？","index":2},{"form_id":"0x000872|infiltration - quest expansion.esp","type":"INFO NAM1","string":"何をやってるんだ？！ ほら、ぐずぐずしてる時間はないぞ！","index":1},{"form_id":"0x000875|infiltration - quest expansion.esp","type":"INFO NAM1","string":"あそこは貯蔵庫だ。取れる物は何でも取っていけ。だが足は止めるなよ。","index":1},{"form_id":"0x000884|infiltration - quest expansion.esp","type":"INFO NAM1","string":"その首、もらってやる！","index":1},{"form_id":"0x000D7C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"片付いたか？","index":1},{"form_id":"0x000D6A|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ストーリオ……この卑劣漢めが。","index":2},{"form_id":"0x000D6B|infiltration - quest expansion.esp","type":"DIAL FULL","string":"ちょっと見て回っていただけだ"},{"form_id":"0x000D6C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そうかね？ ただ「見て回っている」だけの者にしては、ずいぶん奥まで来たものだ。君にはどこか……粘り強さを感じる。","index":1},{"form_id":"0x000D6C|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ひょっとすると、君なら私のちょっとした……厄介事を片付けてくれるかもしれん。","index":2},{"form_id":"0x000D6D|infiltration - quest expansion.esp","type":"DIAL FULL","string":"厄介事？"},{"form_id":"0x000D6E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"そうだ。実はな、この砦はもともとストーリオという男のものだった。邪悪で卑劣な男だ。だが、昔からあれほど惨めな奴だったわけではない。","index":1},{"form_id":"0x000D6E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"実のところ、我々は良き友人だったのだ。奴が私を裏切り、長い投獄刑に処されるよう仕向けるまではな。","index":2},{"form_id":"0x000D6E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"話がそれたな。ストーリオが戻ってきた。奴は砦を取り戻したがっている。私は奴の死を望んでいる。","index":3},{"form_id":"0x000D6E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"この務めを果たしてくれれば、褒美をやろう。","index":4},{"form_id":"0x000D6F|infiltration - quest expansion.esp","type":"DIAL FULL","string":"お前の手助けに興味はないな"},{"form_id":"0x000D70|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ならば、君に用はない。","index":1},{"form_id":"0x000D71|infiltration - quest expansion.esp","type":"DIAL FULL","string":"お前を始末しに来た"},{"form_id":"0x000D72|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ほう、そうかね？ 誰の命令か、聞いてもいいかな？","index":1},{"form_id":"0x000D73|infiltration - quest expansion.esp","type":"DIAL FULL","string":"スタレオ。"},{"form_id":"0x000D74|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ああ、あの卑劣漢ストーリオめ、ついに私の背中にとどめの短剣を突き立てられるだけの腕利きを見つけたというわけか。","index":1},{"form_id":"0x000D74|infiltration - quest expansion.esp","type":"INFO NAM1","string":"私に言わせれば、あの男は裏切り者だ。友人を長い投獄刑に追いやるなど、いったいどういう人間だ？","index":2},{"form_id":"0x000D74|infiltration - quest expansion.esp","type":"INFO NAM1","string":"ひとつ頼みを聞いてもらえないか……君は十分に高潔な人物と見える。ストーリオは二枚舌の下衆野郎だ。奴には最大の代償を払わせねばならん。","index":3},{"form_id":"0x000D74|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴を殺してくれ。必ずや、たっぷりと報いよう。","index":4},{"form_id":"0x000D75|infiltration - quest expansion.esp","type":"DIAL FULL","string":"自分のものだ"},{"form_id":"0x000D76|infiltration - quest expansion.esp","type":"INFO NAM1","string":"英雄気取りの類か？ いいか、私はそこらの腑抜けた略奪者とは違う。私を殺したところで何の得にもならんぞ。","index":1},{"form_id":"0x000D76|infiltration - quest expansion.esp","type":"INFO NAM1","string":"高潔な行いがしたいのか？ ならば正しい方向を示してやろう……ストーリオだ。","index":2},{"form_id":"0x000D76|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴は腰抜けの裏切り者だ。昔は良き友人だったが、奴は私に背を向け、牢獄に放り込んだのだ。","index":3},{"form_id":"0x000D76|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴には裏切りの報いを受けさせねばならん。これをやってくれれば、たっぷりと報いよう。","index":4},{"form_id":"0x000D78|infiltration - quest expansion.esp","type":"DIAL FULL","string":"そいつを片付けてやる。"},{"form_id":"0x000D79|infiltration - quest expansion.esp","type":"INFO NAM1","string":"素晴らしい。片付いたら戻ってこい。褒美をやろう。","index":1},{"form_id":"0x000D79|infiltration - quest expansion.esp","type":"INFO NAM1","string":"正門のすぐ外にいるはずだ。部下に見張らせている。奴はまだこの砦に何かしらの権利があると思っているのだ……愚か者め。","index":2},{"form_id":"0x000D7A|infiltration - quest expansion.esp","type":"INFO NAM1","string":"正しい道を選んでくれて嬉しいよ。仕事が済んだら戻ってきてくれ。","index":1},{"form_id":"0x000D7D|infiltration - quest expansion.esp","type":"DIAL FULL","string":"今はスタレオのために働いている。"},{"form_id":"0x000D7E|infiltration - quest expansion.esp","type":"INFO NAM1","string":"近頃は使える手下が見つからん。世の中は裏切りだらけだ。","index":1},{"form_id":"0x000D7F|infiltration - quest expansion.esp","type":"DIAL FULL","string":"スタレオがお前の血を狙っている。ここから逃げるんだ。(説得)"},{"form_id":"0x000D80|infiltration - quest expansion.esp","type":"INFO NAM1","string":"奴のしつこさだけは認めてやろう。だがこの砦は……あれほどの計画が水の泡だ。","index":1},{"form_id":"0x000D80|infiltration - quest expansion.esp","type":"INFO NAM1","string":"いいだろう、割に合わない面倒事なのかもしれん。だが、いつか必ずストーリオに仕返ししてやる。奴にそう伝えておけ！","index":2},{"form_id":"0x000800|infiltration - quest expansion.esp","type":"INFO NAM1","string":"私はストーリオなど恐れん! お前もだ! この状況は明らかに私の介入を要する。ストーリオは私自らが始末してやる。","index":1},{"form_id":"0x000800|infiltration - quest expansion.esp","type":"INFO NAM1","string":"だがその前に、まずはお前を裏返しにする練習でもしておこうか!","index":2},{"form_id":"0x000DF0|infiltration - quest expansion.esp","type":"INFO NAM1","string":"罠に気をつけろ！","index":1},{"form_id":"0x000DF3|infiltration - quest expansion.esp","type":"INFO NAM1","string":"おい、それは俺のだ！ うーん……まあいい。何でも好きに持っていけ……ブリュリドを始末するのに手を貸してくれるならな。","index":1},{"form_id":"0x000DF6|infiltration - quest expansion.esp","type":"INFO NAM1","string":"気をつけろ、この辺りに感圧板があるぞ。","index":1},{"form_id":"0x000D69|infiltration - quest expansion.esp","type":"QUST CNAM","string":"追従","index":10}]
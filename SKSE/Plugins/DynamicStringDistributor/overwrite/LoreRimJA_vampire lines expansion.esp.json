[{"form_id":"0x000802|vampire lines expansion.esp","type":"INFO NAM1","string":"くたばれ、虫けらが！","index":1},{"form_id":"0x00080C|vampire lines expansion.esp","type":"INFO NAM1","string":"我が力を見よ、定命の者よ！","index":1},{"form_id":"0x00080D|vampire lines expansion.esp","type":"INFO NAM1","string":"鷹のごとく襲いかかってやる！","index":1},{"form_id":"0x00080E|vampire lines expansion.esp","type":"INFO NAM1","string":"蘇れ、この虫けらを倒すのだ！","index":1},{"form_id":"0x00080F|vampire lines expansion.esp","type":"INFO NAM1","string":"蘇れ！","index":1},{"form_id":"0x00084E|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ……血だ！","index":1},{"form_id":"0x00084F|vampire lines expansion.esp","type":"INFO NAM1","string":"そうだ……抵抗が崩れていくのがわかる。終わらせたいのだろう。身を委ねたいのだろう。","index":1},{"form_id":"0x000860|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッ！のろまで間抜けめ！","index":1},{"form_id":"0x000861|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッハッハッハ！","index":1},{"form_id":"0x000804|vampire lines expansion.esp","type":"INFO NAM1","string":"見つけ出してやる……そうしたら、殺してくれと懇願させてやる！","index":1},{"form_id":"0x000838|vampire lines expansion.esp","type":"INFO NAM1","string":"隠れてないで出てこい、臆病者。すぐに済ませてやる、約束しよう。","index":1},{"form_id":"0x000826|vampire lines expansion.esp","type":"INFO NAM1","string":"この渇きを満たしてやる。","index":1},{"form_id":"0x000825|vampire lines expansion.esp","type":"INFO NAM1","string":"ドーンガードにまた一つ勝利を！","index":1},{"form_id":"0x00084B|vampire lines expansion.esp","type":"INFO NAM1","string":"時間を無駄にしてくれてありがとうよ。","index":1},{"form_id":"0x00085E|vampire lines expansion.esp","type":"INFO NAM1","string":"遅かれ早かれ、皆報いを受ける。","index":1},{"form_id":"0x00085F|vampire lines expansion.esp","type":"INFO NAM1","string":"ほらな？大したことなかっただろう。","index":1},{"form_id":"0x000880|vampire lines expansion.esp","type":"INFO NAM1","string":"よく戦ったな、剣を振り回すスキーヴァーの餌め。","index":1},{"form_id":"0x000884|vampire lines expansion.esp","type":"INFO NAM1","string":"ヘッ。あの女には荷が重すぎたようだな。","index":1},{"form_id":"0x00087E|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッハッハッハ！","index":1},{"form_id":"0x00087F|vampire lines expansion.esp","type":"INFO NAM1","string":"しっかりしろよ！ハッハッハ！","index":1},{"form_id":"0x000881|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッハッハッハ！取引できて光栄だ！","index":1},{"form_id":"0x000882|vampire lines expansion.esp","type":"INFO NAM1","string":"なんと悲しい……実に悲劇的だ。ハッハッハ！","index":1},{"form_id":"0x000887|vampire lines expansion.esp","type":"INFO NAM1","string":"弱かったから、死んだのだ。","index":1},{"form_id":"0x000883|vampire lines expansion.esp","type":"INFO NAM1","string":"大したことなかっただろう？！","index":1},{"form_id":"0x000885|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッ！とんだ臆病者だ、まともに戦いもしなかった。","index":1},{"form_id":"0x00087C|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ、これで終わりか。期待していたのは……何を期待していたのかもわからん。","index":1},{"form_id":"0x000886|vampire lines expansion.esp","type":"INFO NAM1","string":"もったいない！","index":1},{"form_id":"0x000807|vampire lines expansion.esp","type":"INFO NAM1","string":"誰かいる……探し出せ！","index":1},{"form_id":"0x000835|vampire lines expansion.esp","type":"INFO NAM1","string":"今のが聞こえたか？","index":1},{"form_id":"0x000836|vampire lines expansion.esp","type":"INFO NAM1","string":"フン。どうやら客が来たようだ。","index":1},{"form_id":"0x000837|vampire lines expansion.esp","type":"INFO NAM1","string":"血の匂いがする……","index":1},{"form_id":"0x00084C|vampire lines expansion.esp","type":"INFO NAM1","string":"匂うか？血だ……","index":1},{"form_id":"0x00084D|vampire lines expansion.esp","type":"INFO NAM1","string":"シーッ……誰かいる。","index":1},{"form_id":"0x00080A|vampire lines expansion.esp","type":"INFO NAM1","string":"ステンダールの番人どもは諦めるということを知らん。","index":1},{"form_id":"0x00081A|vampire lines expansion.esp","type":"INFO NAM1","string":"ドーンガードに死を！","index":1},{"form_id":"0x00081B|vampire lines expansion.esp","type":"INFO NAM1","string":"血だ！","index":1},{"form_id":"0x00081C|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ、お前の血の匂いがする……すぐに終わらせてやろう！","index":1},{"form_id":"0x00081D|vampire lines expansion.esp","type":"INFO NAM1","string":"いいだろう。","index":1},{"form_id":"0x00081E|vampire lines expansion.esp","type":"INFO NAM1","string":"勝ち目があるとでも思っているのか！？ いいだろう！","index":1},{"form_id":"0x000839|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ、いいぞ。夕食だ。待ちかねていた。","index":1},{"form_id":"0x00083F|vampire lines expansion.esp","type":"INFO NAM1","string":"おや、いいな。客人だ。","index":1},{"form_id":"0x000840|vampire lines expansion.esp","type":"INFO NAM1","string":"死にたいらしいな。いいだろう。","index":1},{"form_id":"0x00083A|vampire lines expansion.esp","type":"INFO NAM1","string":"血だ。最初の一口が待ちきれない。さあ、さっさと片付けよう。","index":1},{"form_id":"0x00083E|vampire lines expansion.esp","type":"INFO NAM1","string":"これで貴様を殺さねばならなくなった。","index":1},{"form_id":"0x00083B|vampire lines expansion.esp","type":"INFO NAM1","string":"ダークエルフの血か……まずい味だ。さあ、さっさと片付けよう。","index":1},{"form_id":"0x00083C|vampire lines expansion.esp","type":"INFO NAM1","string":"ドーンガードに死を！","index":1},{"form_id":"0x00083D|vampire lines expansion.esp","type":"INFO NAM1","string":"あのダークエルフの売女を見ろ。喉から股まで切り裂いてやる！","index":1},{"form_id":"0x000846|vampire lines expansion.esp","type":"INFO NAM1","string":"この魅力に抗える者はそういない。一口くらい、いいだろう？","index":1},{"form_id":"0x000856|vampire lines expansion.esp","type":"INFO NAM1","string":"リーチのオークに喧嘩を売る気か？かかってこい。","index":1},{"form_id":"0x000857|vampire lines expansion.esp","type":"INFO NAM1","string":"殺せ、皆殺しにしろ！","index":1},{"form_id":"0x000858|vampire lines expansion.esp","type":"INFO NAM1","string":"ふうむ。柔らかい……実に柔らかい。楽しくなりそうだ。","index":1},{"form_id":"0x00086C|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ……この一杯はおごりだ。","index":1},{"form_id":"0x00086F|vampire lines expansion.esp","type":"INFO NAM1","string":"今日はついてるぞ！","index":1},{"form_id":"0x00086E|vampire lines expansion.esp","type":"INFO NAM1","string":"おやおや、これは目の保養だな。","index":1},{"form_id":"0x000870|vampire lines expansion.esp","type":"INFO NAM1","string":"力比べがしたいのか？フン、いいだろう。後悔するぞ。","index":1},{"form_id":"0x000871|vampire lines expansion.esp","type":"INFO NAM1","string":"本気の戦いがしたいのか？ハッ！ならさっさと終わらせよう。","index":1},{"form_id":"0x00086D|vampire lines expansion.esp","type":"INFO NAM1","string":"どうやってここまで来たかは知らんが、ここから先へは行かせん。","index":1},{"form_id":"0x000811|vampire lines expansion.esp","type":"INFO NAM1","string":"影に呑まれろ！","index":1},{"form_id":"0x000812|vampire lines expansion.esp","type":"INFO NAM1","string":"それが精一杯か！？ 情けない奴め！","index":1},{"form_id":"0x000827|vampire lines expansion.esp","type":"INFO NAM1","string":"馬鹿な犬め！","index":1},{"form_id":"0x000828|vampire lines expansion.esp","type":"INFO NAM1","string":"貴様……その場で殺してやる！","index":1},{"form_id":"0x00082E|vampire lines expansion.esp","type":"INFO NAM1","string":"ぐあっ！よくも！","index":1},{"form_id":"0x000862|vampire lines expansion.esp","type":"INFO NAM1","string":"ついに、手応えのある相手だ！","index":1},{"form_id":"0x000863|vampire lines expansion.esp","type":"INFO NAM1","string":"楯突いたことを後悔させてやる、このアバズレが！","index":1},{"form_id":"0x00086B|vampire lines expansion.esp","type":"INFO NAM1","string":"今のは何だ？！","index":1},{"form_id":"0x000814|vampire lines expansion.esp","type":"INFO NAM1","string":"やめろぉぉぉ！","index":1},{"form_id":"0x000815|vampire lines expansion.esp","type":"INFO NAM1","string":"なぜだ？ なぜだ！？","index":1},{"form_id":"0x000867|vampire lines expansion.esp","type":"INFO NAM1","string":"何？！そんな！","index":1},{"form_id":"0x000868|vampire lines expansion.esp","type":"INFO NAM1","string":"何だ、これは？！","index":1},{"form_id":"0x000817|vampire lines expansion.esp","type":"INFO NAM1","string":"ふうむ……この血……肉の匂い……ああ……","index":1},{"form_id":"0x000818|vampire lines expansion.esp","type":"INFO NAM1","string":"あの呪文は危険そうだ。ふむ……よし。スカイリムの者どもは皆、道を空ける準備をしておくがいい。","index":1},{"form_id":"0x000819|vampire lines expansion.esp","type":"INFO NAM1","string":"ウィンターホールド大学の魔術師どもは愚か者ばかりだ。戻る気などさらさらない。","index":1},{"form_id":"0x00082F|vampire lines expansion.esp","type":"INFO NAM1","string":"確かに、過去には後ろ暗いこともあったかもしれない。だが、そんなのは大昔の話だ……わかるだろう？ハッハッハ。","index":1},{"form_id":"0x000830|vampire lines expansion.esp","type":"INFO NAM1","string":"気分は最高だ……毎晩そうであるようにな。","index":1},{"form_id":"0x000831|vampire lines expansion.esp","type":"INFO NAM1","string":"人間など家畜同然だ。働いて、寝て、食うだけだ。","index":1},{"form_id":"0x000832|vampire lines expansion.esp","type":"INFO NAM1","string":"人間は愚かだが、必要な存在だ。生者は我々の糧となるためにいるのだからな。","index":1},{"form_id":"0x000833|vampire lines expansion.esp","type":"INFO NAM1","string":"スカイリムには飽き飽きだ。このみじめな土地にあとどれだけ留まらねばならんのだ？","index":1},{"form_id":"0x000834|vampire lines expansion.esp","type":"INFO NAM1","string":"何千年も経ったが、我ながらうまく年を重ねたと思っている。","index":1},{"form_id":"0x000850|vampire lines expansion.esp","type":"INFO NAM1","string":"もう長いこと眠っていない……永遠の時が過ぎたようだ。","index":1},{"form_id":"0x000851|vampire lines expansion.esp","type":"INFO NAM1","string":"呪われている？違う。呪われてなどいない。本物の力を手にしたのだ！奴らにはわかるまい……","index":1},{"form_id":"0x000852|vampire lines expansion.esp","type":"INFO NAM1","string":"風に血の匂いが混じっている。良い日になりそうだ。","index":1},{"form_id":"0x000853|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ……今日は空気がいい。これから仕留める獲物どもの血の匂いが待ち遠しい。","index":1},{"form_id":"0x000854|vampire lines expansion.esp","type":"INFO NAM1","string":"遅かれ早かれ、皆報いを受ける……","index":1},{"form_id":"0x000855|vampire lines expansion.esp","type":"INFO NAM1","string":"闇がこれほど色彩に満ちていたとは……","index":1},{"form_id":"0x000869|vampire lines expansion.esp","type":"INFO NAM1","string":"ただの夢だ、それだけだ……","index":1},{"form_id":"0x00086A|vampire lines expansion.esp","type":"INFO NAM1","string":"我が民の祖先の地、故郷に帰ることを思わぬ日はない。ああ……静かに。もう考えるな。","index":1},{"form_id":"0x000820|vampire lines expansion.esp","type":"INFO NAM1","string":"その様を見ろ……ハッ！ 勝ち目があるとでも思っているのか！？","index":1},{"form_id":"0x000821|vampire lines expansion.esp","type":"INFO NAM1","string":"誰にも私は倒せん！","index":1},{"form_id":"0x000824|vampire lines expansion.esp","type":"INFO NAM1","string":"邪魔はさせない！","index":1},{"form_id":"0x000822|vampire lines expansion.esp","type":"INFO NAM1","string":"やるじゃないか、兄弟。だが、ここで死んでもらう！","index":1},{"form_id":"0x000823|vampire lines expansion.esp","type":"INFO NAM1","string":"やるじゃないか、姉妹。だが、ここで死んでもらう！","index":1},{"form_id":"0x000841|vampire lines expansion.esp","type":"INFO NAM1","string":"来い。貴様の血を飲み干し、肉を喰らってやる。","index":1},{"form_id":"0x000847|vampire lines expansion.esp","type":"INFO NAM1","string":"その様を見ろ……取るに足らん！","index":1},{"form_id":"0x000842|vampire lines expansion.esp","type":"INFO NAM1","string":"来い。貴様の灰はこの手で撒いてやる！","index":1},{"form_id":"0x000843|vampire lines expansion.esp","type":"INFO NAM1","string":"来い！喰らってやる！","index":1},{"form_id":"0x000844|vampire lines expansion.esp","type":"INFO NAM1","string":"来い！真っ二つにしてやる！","index":1},{"form_id":"0x000845|vampire lines expansion.esp","type":"INFO NAM1","string":"この魅力に抗える者はそういない。一口くらい、いいだろう？","index":1},{"form_id":"0x000848|vampire lines expansion.esp","type":"INFO NAM1","string":"スカイリムは我らのものだ……","index":1},{"form_id":"0x000849|vampire lines expansion.esp","type":"INFO NAM1","string":"わかっているだろうが、結末は一つしかない。貴様を殺す。無残にな。それで終わりだ。","index":1},{"form_id":"0x00084A|vampire lines expansion.esp","type":"INFO NAM1","string":"怖くなどない……","index":1},{"form_id":"0x000859|vampire lines expansion.esp","type":"INFO NAM1","string":"ガアッ！","index":1},{"form_id":"0x00085D|vampire lines expansion.esp","type":"INFO NAM1","string":"貴様の血など気にもならん！","index":1},{"form_id":"0x00085A|vampire lines expansion.esp","type":"INFO NAM1","string":"いつまで持ちこたえられるかな、定命の者よ？","index":1},{"form_id":"0x00085C|vampire lines expansion.esp","type":"INFO NAM1","string":"抗えば抗うほど苦しむことになるぞ、定命の者よ。","index":1},{"form_id":"0x00085B|vampire lines expansion.esp","type":"INFO NAM1","string":"こっちへおいで……噛みつきはしないさ。ヘッヘッヘ。","index":1},{"form_id":"0x000872|vampire lines expansion.esp","type":"INFO NAM1","string":"来い、決着をつけるぞ！","index":1},{"form_id":"0x000878|vampire lines expansion.esp","type":"INFO NAM1","string":"なんとしつこい。実に魅力的だ。","index":1},{"form_id":"0x00087A|vampire lines expansion.esp","type":"INFO NAM1","string":"じわじわと苦しみながら死ぬがいい！","index":1},{"form_id":"0x00087B|vampire lines expansion.esp","type":"INFO NAM1","string":"終わる前に、殺してくれと懇願させてやる！","index":1},{"form_id":"0x000877|vampire lines expansion.esp","type":"INFO NAM1","string":"さあ来い、実力を見せてみろ！","index":1},{"form_id":"0x000876|vampire lines expansion.esp","type":"INFO NAM1","string":"さっさと片付けるぞ！","index":1},{"form_id":"0x000879|vampire lines expansion.esp","type":"INFO NAM1","string":"本気の戦いがしたいのか？来い、後悔させてやる！","index":1},{"form_id":"0x000873|vampire lines expansion.esp","type":"INFO NAM1","string":"あの女を捕まえろ！","index":1},{"form_id":"0x000874|vampire lines expansion.esp","type":"INFO NAM1","string":"あの女を捕まえろ！","index":1},{"form_id":"0x000875|vampire lines expansion.esp","type":"INFO NAM1","string":"あの男を捕まえろ！","index":1},{"form_id":"0x00082A|vampire lines expansion.esp","type":"INFO NAM1","string":"気のせいか……","index":1},{"form_id":"0x00082B|vampire lines expansion.esp","type":"INFO NAM1","string":"今、何か見えたような……いや、まさかな。","index":1},{"form_id":"0x00082D|vampire lines expansion.esp","type":"INFO NAM1","string":"ハッハッハ。冗談だろう？","index":1},{"form_id":"0x000864|vampire lines expansion.esp","type":"INFO NAM1","string":"ああ、その意気だ。","index":1},{"form_id":"0x000866|vampire lines expansion.esp","type":"INFO NAM1","string":"あまり得意じゃないようだな。","index":1},{"form_id":"0x000865|vampire lines expansion.esp","type":"INFO NAM1","string":"惜しかったな！","index":1},{"form_id":"0x000800|vampire lines expansion.esp","type":"QUST FULL","string":"吸血鬼台詞拡張"}]
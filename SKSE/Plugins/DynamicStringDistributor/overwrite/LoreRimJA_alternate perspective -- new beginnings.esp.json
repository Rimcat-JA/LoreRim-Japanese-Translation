[{"form_id":"0x00085D|alternate perspective -- new beginnings.esp","type":"NPC_ FULL","string":"ミトラ"},{"form_id":"0x000850|alternate perspective -- new beginnings.esp","type":"REFR FULL","string":"破壊された小屋"},{"form_id":"0x000800|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"深淵より"},{"form_id":"0x000800|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ついに巣窟を見つけたなんて信じられない! 家を出てから震えはひどくなる一方だったが、これで苦しみも終わる。でも、この巣窟には妙な予感がする…","index":10},{"form_id":"0x000800|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"巣窟に入るか、立ち去る。","index":10},{"form_id":"0x000802|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"深淵より"},{"form_id":"0x000802|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"この神に見捨てられた下水道で、どれだけ暮らしてきたのかも覚えていない。そろそろここを出て、冒険者になるか、盗賊ギルドに加わるか、何かそういうことをする時だ。このゴミ溜めで朽ち果て続けるよりは、何だってましだろう。","index":10},{"form_id":"0x000802|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"この神に見捨てられたゴミ捨て場で、どれだけ暮らしてきたのかも覚えていない。そろそろここを出て、冒険者になるか、フォースウォーンに加わるか、何かそういうことをする時だ。このゴミ溜めで朽ち果て続けるよりは、何だってましだろう。","index":11},{"form_id":"0x000802|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"物乞い通りを出る","index":10},{"form_id":"0x000802|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"ウォーレンズを出る","index":11},{"form_id":"0x000804|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"安らがぬ死"},{"form_id":"0x000804|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"数日前、私は激しい熱に倒れた。幸い、愚かな家族は誰もその症状の正体に気づかなかったようで、私が死んだ後ここに埋葬した。これでようやく彼らを捨てて新しい人生を始められる。","index":10},{"form_id":"0x000804|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"死者の間を立ち去る","index":10},{"form_id":"0x000804|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"墓地を出る","index":15},{"form_id":"0x00080A|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"錬金術師になるために家を出てからしばらく経つが、花摘みよりも刺激的なことがしたいと思わずにはいられない。そろそろこの森を後にする時かもしれない…","index":10},{"form_id":"0x00080A|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"木立を出る","index":10},{"form_id":"0x000816|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ついに神殿に到着した。九大神の祝福を受けたので、町で仕事を探し始めるべきだ。結局、家にはもう帰れないのだから…","index":10},{"form_id":"0x000816|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"聖堂を出る","index":10},{"form_id":"0x00081C|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"深淵からの叫び"},{"form_id":"0x00081C|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"あのオーブに触れるべきではないと分かっていたのに、好奇心に負けてしまった。ここから抜け出す方法があることを神々に祈るばかりだ…","index":10},{"form_id":"0x00081C|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"脱出する方法を見つける","index":10},{"form_id":"0x00081F|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"ウルフベーンが咲く時"},{"form_id":"0x00081F|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"マジニの群れと過ごしてかなり経つが、他の者たちはまだ私をよそ者扱いしている。スカイリムへの渡航費を払えるだけのゴールドは貯まったし、ここを去ってまた旅を始めるべきかもしれない…","index":10},{"form_id":"0x00081F|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"岩山を出る","index":10},{"form_id":"0x000820|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"イモリの目とカエルの指"},{"form_id":"0x000820|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"この集会に迎え入れられてからどれくらい経っただろう? 数か月? 数年? その間、私は何をしていた? この洞窟を出た回数は片手で数えられるほどだ。そろそろここを出て、外の世界を探検する時だ。","index":10},{"form_id":"0x000820|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"洞窟を出る","index":10},{"form_id":"0x000828|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"投獄"},{"form_id":"0x000828|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"さて、ここにいるわけだ…あの間抜けな衛兵どもに捕まるなんて信じられない。ここで刑期を務めたくないなら、脱出方法を探し始めたほうがいい。","index":10},{"form_id":"0x000828|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"刑期を務めるか、脱獄する","index":10},{"form_id":"0x000829|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"まさかのサルモール異端審問"},{"form_id":"0x000829|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"あの忌々しいサルモールに本当に投獄されてしまった!タロスへの信仰を捨てるまで拷問されたくなければ、今こそ脱出する時だ。看守たちはあまり注意深くはなさそうだ…","index":10},{"form_id":"0x000829|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"脱出する。","index":10},{"form_id":"0x00082B|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"その翼に人の骸を"},{"form_id":"0x00082B|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"なんてことだ!もっと早く衛兵を呼ぶべきだったんだ。ドラゴンが来たとき、私はすぐに中へ逃げ込んだが、他の皆は助からなかったようだ。これからどうすればいいのかわからないが、ここはすべて破壊されてしまったから、去ってやり直すしかない…","index":10},{"form_id":"0x00082B|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"新たな人生を始める","index":10},{"form_id":"0x000835|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"常に警戒を"},{"form_id":"0x000835|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ステンダールの灯への巡礼を終えた。だが長居はすべきではない。結局のところ、私は冒険者になるために故郷を出たのであって、祠の前で祈って過ごすためではないのだ。","index":10},{"form_id":"0x000835|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"番人の間への巡礼を終えた。だが長居はすべきではない。結局のところ、私は冒険者になるために故郷を出たのであって、祠の前で祈って過ごすためではないのだ。","index":11},{"form_id":"0x000835|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"灯台を出る","index":10},{"form_id":"0x000835|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"ホールを出る","index":11},{"form_id":"0x000838|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ついにエルダーグリーム聖域に到着した。想像していたよりもずっと美しい!ここへ来たのは正しい選択だった。旅を続ける前に、しばらくここに滞在しよう…","index":10},{"form_id":"0x000838|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"聖域を出る","index":10},{"form_id":"0x00083A|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ボエシアの神殿に到着したが、放棄されているようだ。冒険は他の場所で探すしかなさそうだ。","index":10},{"form_id":"0x00083A|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"祠を出る","index":10},{"form_id":"0x00083C|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"暁と黄昏"},{"form_id":"0x00083C|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"アズラの祠への巡礼を終えた。巫女と話して、アズラの祝福を受けるべきだ。","index":10},{"form_id":"0x00083C|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"アズラの巫女と話す","index":10},{"form_id":"0x00083E|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"監督者"},{"form_id":"0x00083E|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"ハンセン病の難民が話していたペライトの祭壇を見つけた。詳しく知るために、そこの司祭と話そう。","index":10},{"form_id":"0x00083E|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"ペライトの司祭と話す","index":10},{"form_id":"0x000840|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"無限なるエネルギーの女王"},{"form_id":"0x000840|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"メリディアの祠への巡礼を終え、女神の祝福を受けた。そろそろ旅を続けるべきだ。","index":10},{"form_id":"0x000840|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"旅を続ける","index":10},{"form_id":"0x000842|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"新たな夜明け"},{"form_id":"0x000842|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"メエルーンズ・デイゴンの祠に到着したが、放棄されているようだ。冒険は他の場所で探すしかなさそうだ。","index":10},{"form_id":"0x000842|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"旅を続ける","index":10},{"form_id":"0x000847|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"風の中の利益"},{"form_id":"0x000847|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"シロディールの古いことわざに「危険な道ほど儲けは大きい」というものがある。スカイリムの内戦は商売にとって好都合なはずだ。この機会を逃すのは愚か者だけだろう。何しろ、故郷にいた頃より稼ぎが減ることなどまずないのだから…","index":20},{"form_id":"0x000847|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"国境を越えてスカイリムに入る","index":20},{"form_id":"0x000858|alternate perspective -- new beginnings.esp","type":"QUST FULL","string":"射撃練習"},{"form_id":"0x000858|alternate perspective -- new beginnings.esp","type":"QUST CNAM","string":"アンギという名の弓の名手の野営地に行き当たった。彼女に訓練を頼んでみるのもいいかもしれない。","index":10},{"form_id":"0x000858|alternate perspective -- new beginnings.esp","type":"QUST NNAM","string":"アンジーと話す","index":10}]
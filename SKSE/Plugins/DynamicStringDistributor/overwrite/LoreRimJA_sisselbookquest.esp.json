[{"form_id":"0x00088C|sisselbookquest.esp","type":"INFO NAM1","string":"伝説について学ぶのが好きなんだ。ジョアンは僕が覚えるのが得意だって言うけど、本が見つからないんだ。もしかしたら手伝ってくれる？","index":1},{"form_id":"0x00088E|sisselbookquest.esp","type":"DIAL FULL","string":"君の本だ。"},{"form_id":"0x000893|sisselbookquest.esp","type":"DIAL FULL","string":"君の本を探すのを手伝える。"},{"form_id":"0x000894|sisselbookquest.esp","type":"INFO NAM1","string":"ありがとう。ドラゴンについてだ。","index":1},{"form_id":"0x000895|sisselbookquest.esp","type":"DIAL FULL","string":"悪いが、力になれない。"},{"form_id":"0x000899|sisselbookquest.esp","type":"DIAL FULL","string":"何か言いたいことがあるのか？"},{"form_id":"0x00089A|sisselbookquest.esp","type":"INFO NAM1","string":"ドラゴンのこと聞いたよ。ほら、ヘルゲン。お前、そこに行ったんだろ？","index":1},{"form_id":"0x00089C|sisselbookquest.esp","type":"INFO NAM1","string":"それについて夢を見たの。彼は怖かった。煙が冷たく暗くなって。それで私は怖かった。","index":1},{"form_id":"0x00089C|sisselbookquest.esp","type":"INFO NAM1","string":"だが、そう遠くないうちに怖がるのはやめるさ。本当にドラゴンを見たのか？","index":2},{"form_id":"0x0008F2|sisselbookquest.esp","type":"DIAL FULL","string":"ああ。まるで古の伝説のようだった。"},{"form_id":"0x0008F4|sisselbookquest.esp","type":"INFO NAM1","string":"本当に？やっぱり実在したんだ！","index":1},{"form_id":"0x0008F3|sisselbookquest.esp","type":"DIAL FULL","string":"ドラゴンはいなかった。"},{"form_id":"0x000889|sisselbookquest.esp","type":"QUST FULL","string":"シセルの本"},{"form_id":"0x000889|sisselbookquest.esp","type":"QUST NNAM","string":"<Alias=SisselBookAlias>を1冊見つける。","index":10},{"form_id":"0x000889|sisselbookquest.esp","type":"QUST NNAM","string":"<Alias=SisselBookAlias>を1冊<Alias.ShortName=SisselAlias>に届ける","index":100}]